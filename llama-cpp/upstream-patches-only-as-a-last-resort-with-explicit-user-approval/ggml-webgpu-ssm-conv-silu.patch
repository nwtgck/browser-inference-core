+    // and aligned-binding overlap, including between its two input bindings.
+    // The unused conv allocation may equal the final SiLU allocation.
+    for (int a = 0; a < 3; ++a) {
+        for (int b = a + 1; b < 3; ++b) {
+            if (bindings[a].buffer.Get() == bindings[b].buffer.Get() &&
+                (!ssm_conv_silu_disjoint(bindings[a].tensor_offset, bindings[a].tensor_size,
+                                         bindings[b].tensor_offset, bindings[b].tensor_size) ||
+                 !ssm_conv_silu_disjoint(bindings[a].offset, bindings[a].size,
+                                         bindings[b].offset, bindings[b].size))) { return std::nullopt; }
+        }
+    }
+    auto encoded = ggml_webgpu_ssm_conv(ctx, plan.history, plan.weights, plan.output, true);
     num_encoded_ops = 2;
     return encoded;
 }
