 fn load_u32_at_src0(byte_offset: u32) -> u32 {
     let word_idx = byte_offset / 4u;
     let shift = (byte_offset & 0x3u) * 8u;
+#ifdef BICORE_INDEXED_SPLIT_WEIGHTS
+    let lo = indexed_src0_word(word_idx);
+    let hi = indexed_src0_word(word_idx + select(0u, 1u, shift != 0u));
+#else
     let lo = SRC0[word_idx];
     let hi = SRC0[word_idx + select(0u, 1u, shift != 0u)];
+#endif
     return (lo >> shift) | (hi << ((32u - shift) & 31u));
 }
 
