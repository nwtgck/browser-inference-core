+        const auto * tail = static_cast<const int32_t *>(tail_idxs->data);
+        // The input tables encode visible pools as half zero and all other
+        // pools as negative infinity. The sentinel is outside the KV range.
+        for (int64_t p = 0; p < pool_idxs->ne[1]; ++p) {
+            if (visibility[p] == 0) {
+                for (uint32_t i = 0; i < kpool; ++i) {
+                    keep(pool[p*kpool + i]);
+                }
+            }
+        }
+        for (uint32_t i = 0; i + 1 < kpool; ++i) {
+            keep(tail[i]);
+        }
+    }
