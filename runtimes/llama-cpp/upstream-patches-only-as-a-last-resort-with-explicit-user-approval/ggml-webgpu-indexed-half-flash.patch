+static bool ggml_webgpu_flash_mask_binding_fits(const webgpu_global_context & global, const ggml_tensor * mask) {
+    const auto & limits = global->capabilities.limits;
+    const size_t alignment = limits.minStorageBufferOffsetAlignment;
+    if (mask->type != GGML_TYPE_F16 || alignment < sizeof(ggml_fp16_t) || !std::has_single_bit(alignment)) {
+        return false;
+    }
+    const uint64_t limit = std::min(limits.maxStorageBufferBindingSize, limits.maxBufferSize) &
+                           ~uint64_t(WEBGPU_STORAGE_BUF_BINDING_MULT - 1);
+    const uint64_t bytes = ggml_nbytes(mask);
+    const auto * root = mask->view_src ? mask->view_src : mask;
+    size_t offset = mask->view_offs;
+    if (root->buffer) {
+        const auto * buffer = root->buffer->iface.get_base == ggml_backend_webgpu_buffer_get_base
+            ? static_cast<const ggml_backend_webgpu_buffer_context *>(root->buffer->context) : nullptr;
+        if (!buffer || buffer->global_ctx != global) {
+            // The scheduler copies a tensor from an incompatible buffer into a new aligned tensor.
+            offset = 0;
+        } else if (root->data) {
+            offset = ggml_webgpu_tensor_offset(mask);
+        }
+    }
+    const auto prefix = offset % alignment;
+    return offset % sizeof(ggml_fp16_t) == 0 && bytes <= limit && prefix <= limit - bytes;
+}
