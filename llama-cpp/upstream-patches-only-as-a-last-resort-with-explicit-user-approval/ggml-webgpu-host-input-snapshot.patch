--- /dev/null
+++ b/ggml/src/ggml-backend-host-snapshot.h
@@ -0,0 +1,17 @@
+#pragma once
+#include "ggml-backend.h"
+
+// Optional registry extension; no backend interface or public structure changes.
+// true: the source producer has completed, host bytes have been consumed before
+// returning, and the copy is ordered after all prior destination compute readers
+// and before subsequent work on that backend. The caller may immediately reuse
+// the source bytes without waiting for destination completion.
+// false: unsupported, with no synchronization, enqueue, or tensor mutation.
+// Producer or upload failures retain their normal error behavior; they are not
+// an unsupported false result.
+// This is stronger than cpy_tensor_async. It does not report GPU completion and
+// does not replace explicit synchronization, readback, or error observation.
+#define GGML_BACKEND_HOST_INPUT_SNAPSHOT_V1 "ggml_backend_copy_host_input_snapshot_v1"
+typedef bool (*ggml_backend_copy_host_input_snapshot_v1_t)(
+    ggml_backend_t source_backend, ggml_backend_t destination_backend,
+    const struct ggml_tensor * source, struct ggml_tensor * destination);
