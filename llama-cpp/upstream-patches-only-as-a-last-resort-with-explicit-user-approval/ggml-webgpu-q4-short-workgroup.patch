+// Q4_K uses 16 lanes per 256 weights. With complete K <= 4096 blocks,
+// every useful lane visits exactly one block at either workgroup size.
+// Keep the upstream decoder, reduction, output tiling and dispatch grid.
+inline uint32_t ggml_webgpu_q4_short_workgroup(const ggml_webgpu_shader_lib_context & context,
+                                             bool indexed, bool use_mmvq, bool src_overlap) {
+    constexpr uint32_t fallback = WEBGPU_MUL_MAT_VEC_WG_SIZE;
+    const auto * a = context.src0;
+    const auto * x = context.src1;
+    const auto * dst = context.dst;
+    const uint32_t sg_min = context.min_subgroup_size;
+    const uint32_t sg_max = context.max_subgroup_size;
+    if (!a || !x || !dst || !context.supports_subgroups || use_mmvq || src_overlap ||
+        a->type != GGML_TYPE_Q4_K || x->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        a->ne[0] <= 0 || a->ne[0] > 4096 || a->ne[0] % 256 != 0 ||
+        a->ne[1] <= 0 || x->ne[0] != a->ne[0] || dst->ne[0] != a->ne[1] ||
+        sg_min < 4 || sg_max > 128 || sg_min > sg_max ||
+        (sg_min & (sg_min - 1)) != 0 || (sg_max & (sg_max - 1)) != 0) {
+        return fallback;
+    }
+    if (indexed) {
+        const auto * ids = context.src2;
+        if (!ids || ids->type != GGML_TYPE_I32 || a->ne[2] <= 0 || a->ne[2] > UINT32_MAX ||
+            dst->ne[1] <= 0 || dst->ne[1] > a->ne[2] || ids->ne[0] != dst->ne[1] ||
+            (x->ne[1] != 1 && x->ne[1] != dst->ne[1]) ||
+            x->ne[2] != 1 || dst->ne[2] != 1 || ids->ne[1] != 1 || ids->ne[2] != 1 ||
+            a->ne[3] != 1 || x->ne[3] != 1 || dst->ne[3] != 1 || ids->ne[3] != 1) {
+            return fallback;
+        }
+    } else {
+        if (x->ne[1] != 1 || dst->ne[1] != 1 ||
+            a->ne[2] <= 0 || a->ne[3] <= 0 || x->ne[2] <= 0 || x->ne[3] <= 0 ||
+            dst->ne[2] != x->ne[2] || dst->ne[3] != x->ne[3] ||
+            x->ne[2] % a->ne[2] != 0 || x->ne[3] % a->ne[3] != 0) {
+            return fallback;
+        }
+    }
+    // Cover whole subgroups for every size the adapter may choose.
+    uint32_t workgroup = std::max(32u, sg_max);
+    const uint32_t useful_lanes = static_cast<uint32_t>(a->ne[0] / 16);
+    while (workgroup < useful_lanes) {
+        workgroup *= 2;
+    }
+    return workgroup <= context.max_wg_size ? workgroup : fallback;
 }
 
