+#ifdef SUBGROUP_REDUCTION
+enable subgroups;
+#endif
+
+struct Params {
+    forget_weight: u32,
+    gain_weight: u32,
+    gate: u32,
+    cur: u32,
+    message: u32,
+    dst: u32,
+};
+
+@group(0) @binding(0) var<storage, read_write> forget_weight: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> gain_weight: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> gate: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read_write> cur: array<f32>;
+@group(0) @binding(4) var<storage, read_write> message: array<f32>;
+#ifdef INPLACE
+#define OUTPUT cur
+#define PARAM_BINDING 5
+#else
+@group(0) @binding(5) var<storage, read_write> dst: array<f32>;
+#define OUTPUT dst
+#define PARAM_BINDING 6
+#endif
+@group(0) @binding(PARAM_BINDING) var<uniform> params: Params;
+
+var<workgroup> forget_partial: array<f32, 4 * CONTROLLER_WG>;
+var<workgroup> gain_partial: array<f32, 4 * CONTROLLER_WG>;
+
+fn inner_dot(weight: vec4<f32>, input: vec4<f32>) -> f32 {
+    return f32(dot(vec4<f32>(weight), input));
+}
+
+fn partial_index(row: u32, thread: u32) -> u32 {
+    return row * CONTROLLER_WG + thread;
+}
+
+fn store_row(row: u32, forget_dot: f32, gain_dot: f32) {
+    let x = cur[params.cur + row];
+    let forget = tanh(clamp(forget_dot, -9.010913, 9.010913));
+    let gain = tanh(clamp(gain_dot, -9.010913, 9.010913));
+    let residual = x - forget * x;
+    let addition = gain * message[params.message + row];
+    OUTPUT[params.dst + row] = residual + addition;
+}
+
+@compute @workgroup_size(CONTROLLER_WG)
+fn main(@builtin(workgroup_id) wg_id: vec3<u32>,
+        @builtin(local_invocation_id) local_id: vec3<u32>
+#ifdef SUBGROUP_REDUCTION
+      , @builtin(subgroup_id) subgroup_id: u32,
+        @builtin(subgroup_invocation_id) lane: u32,
+        @builtin(num_subgroups) subgroup_count: u32,
+        @builtin(subgroup_size) subgroup_size: u32
+#endif
+) {
+    let row_base = wg_id.x * 4u;
+    var forget_acc: array<f32, 4>;
+    var gain_acc: array<f32, 4>;
+    for (var k = local_id.x; k < 16u; k += CONTROLLER_WG) {
+        let input = gate[params.gate + k];
+        for (var r = 0u; r < 4u; r++) {
+            let weight_row = (row_base + r) * 16u + k;
+            forget_acc[r] += inner_dot(forget_weight[params.forget_weight + weight_row], input);
+            gain_acc[r] += inner_dot(gain_weight[params.gain_weight + weight_row], input);
+        }
+    }
+#ifdef SUBGROUP_REDUCTION
+    for (var r = 0u; r < 4u; r++) {
+        let forget_group = subgroupAdd(forget_acc[r]);
+        let gain_group = subgroupAdd(gain_acc[r]);
+        if (lane == 0u) {
+            forget_partial[partial_index(r, subgroup_id)] = forget_group;
+            gain_partial[partial_index(r, subgroup_id)] = gain_group;
+        }
+    }
+    workgroupBarrier();
+    for (var r = subgroup_id; r < 4u; r += subgroup_count) {
+        var forget_sum = 0.0;
+        var gain_sum = 0.0;
+        for (var i = lane; i < subgroup_count; i += subgroup_size) {
+            forget_sum += forget_partial[partial_index(r, i)];
+            gain_sum += gain_partial[partial_index(r, i)];
+        }
+        let forget_dot = subgroupAdd(forget_sum);
+        let gain_dot = subgroupAdd(gain_sum);
+        if (lane == 0u) {
+            store_row(row_base + r, forget_dot, gain_dot);
+        }
+    }
+#else
+    let thread = local_id.x;
+    for (var r = 0u; r < 4u; r++) {
+        forget_partial[partial_index(r, thread)] = forget_acc[r];
+        gain_partial[partial_index(r, thread)] = gain_acc[r];
+    }
+    workgroupBarrier();
+    for (var stride = CONTROLLER_WG / 2u; stride > 0u; stride /= 2u) {
+        if (thread < stride) {
+            for (var r = 0u; r < 4u; r++) {
+                forget_partial[partial_index(r, thread)] += forget_partial[partial_index(r, thread + stride)];
+                gain_partial[partial_index(r, thread)] += gain_partial[partial_index(r, thread + stride)];
+            }
+        }
+        workgroupBarrier();
+    }
+    if (thread < 4u) {
+        store_row(row_base + thread, forget_partial[partial_index(thread, 0u)], gain_partial[partial_index(thread, 0u)]);
+    }
+#endif
+    workgroupBarrier();
+}
