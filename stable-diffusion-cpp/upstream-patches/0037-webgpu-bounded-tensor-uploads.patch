+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <stdexcept>
+
+// State belongs to the device queue, not a tensor/set call. CPU sources may be
+// reused after WriteBuffer returns; destinations must survive until completion.
+struct ggml_webgpu_upload_budget {
+    static constexpr size_t budget_bytes = 32 * 1024 * 1024;
+    static constexpr size_t chunk_bytes = 8 * 1024 * 1024;
+
+    template <typename Wait>
+    void reserve(size_t bytes, Wait wait) {
+        if (waiting_) throw std::logic_error("reentrant WebGPU upload during completion wait");
+        if (bytes > budget_bytes) throw std::invalid_argument("WebGPU upload exceeds queue window");
+        if (bytes > budget_bytes - pending_) wait();
+        if (bytes > budget_bytes - pending_) throw std::logic_error("WebGPU upload drain did not complete");
+        // Charge before the API call: a partly enqueued failed write still owns
+        // the queue until synchronize/free/owner cleanup retires its final batch.
+        pending_ += bytes;
+    }
+
+    void begin_wait() {
+        if (waiting_) throw std::logic_error("reentrant WebGPU completion wait");
+        waiting_ = true;
+    }
+    void completed() { pending_ = 0; waiting_ = false; }
+    void failed_wait() { waiting_ = false; }
+    size_t pending_bytes() const { return pending_; }
+
+private:
+    size_t pending_ = 0;
+    bool waiting_ = false;
+};
+
+inline uint64_t ggml_webgpu_upload_offset(uint64_t base, uint64_t offset) {
+    if (offset > UINT64_MAX - base) throw std::invalid_argument("WebGPU upload offset overflow");
+    return base + offset;
+}
+
+inline uint32_t ggml_webgpu_upload_word(uint64_t offset, const uint8_t* source, size_t bytes) {
+    if (bytes == 0 || bytes > 4 - offset % 4) throw std::invalid_argument("invalid partial upload word");
+    uint32_t word = 0;
+    for (size_t i = 0; i < bytes; ++i) word |= uint32_t(source[i]) << (((offset + i) % 4) * 8);
+    return word;
+}
+
+// Emit partial head/tail words separately. Their callback preserves neighboring
+// bytes; only aligned ranges reach WriteBuffer. Offsets never narrow to uint32.
+template <typename Aligned, typename Partial>
+void ggml_webgpu_upload_ranges(uint64_t offset, uint64_t bytes, Aligned aligned, Partial partial) {
+    if (bytes > UINT64_MAX - offset) throw std::invalid_argument("WebGPU upload range overflow");
+    uint64_t consumed = 0;
+    if (offset % 4 != 0 && bytes != 0) {
+        const size_t head = static_cast<size_t>(std::min<uint64_t>(4 - offset % 4, bytes));
+        partial(offset, consumed, head);
+        offset += head;
+        consumed += head;
+        bytes -= head;
+    }
+    while (bytes >= 4) {
+        const size_t chunk = static_cast<size_t>(std::min<uint64_t>(bytes / 4 * 4,
+                                                                  ggml_webgpu_upload_budget::chunk_bytes));
+        aligned(offset, consumed, chunk);
+        offset += chunk;
+        consumed += chunk;
+        bytes -= chunk;
+    }
+    if (bytes != 0) partial(offset, consumed, static_cast<size_t>(bytes));
+}
