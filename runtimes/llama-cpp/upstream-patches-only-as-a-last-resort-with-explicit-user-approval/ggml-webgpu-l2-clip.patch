+        return std::nullopt;
+    }
+    const uint32_t storage_bindings = inplace ? 1 : 2;
+    if (limits.maxStorageBuffersPerShaderStage < storage_bindings || limits.maxBindingsPerBindGroup < storage_bindings + 1) {
+        return std::nullopt;
+    }
+    auto pipeline = ctx->shader_lib->get_l2_clip_pipeline(inplace);
+    const std::vector<uint32_t> params = {
+        input.element_offset, output.element_offset, plan.width, ggml_webgpu_u32_from_f32(plan.threshold),
+    };
+    std::vector<wgpu::BindGroupEntry> entries = {
