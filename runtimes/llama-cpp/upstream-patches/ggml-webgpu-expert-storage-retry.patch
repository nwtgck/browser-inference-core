+static ggml_webgpu_expert_storage_v1::allocation ggml_webgpu_allocate_expert_storage(
+        ggml_backend_buffer_type_t buft, ggml_context * context) {
+    auto * ctx = static_cast<ggml_backend_webgpu_device_context *>(buft->device->context);
+    auto & global = *ctx->webgpu_global_ctx;
+    // Buffer creation is synchronous inside the issue interval. Resolve every
+    // scope before the loader can upload to a non-null Dawn error buffer.
+    struct ops {
+        using Pipeline = ggml_backend_buffer_ptr;
+        ggml_backend_buffer_type_t buft;
+        ggml_context * context;
+        wgpu::Device & device;
+        wgpu::Instance & instance;
+        std::exception_ptr allocation_exception{};
+
+        uint64_t now_ns() const noexcept {
+            return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count());
+        }
+        void push(wgpu::ErrorFilter filter) { device.PushErrorScope(filter); }
+        Pipeline create() {
+            // Close the scopes even if host allocation fails inside GGML.
+            try {
+                return Pipeline(ggml_backend_alloc_ctx_tensors_from_buft(context, buft));
+            } catch (...) {
+                allocation_exception = std::current_exception();
+                return {};
+            }
+        }
+        wgpu::Future pop(wgpu::CallbackMode mode,
+                        void (*callback)(wgpu::PopErrorScopeStatus, wgpu::ErrorType, wgpu::StringView,
+                                         ggml_webgpu_optional::Ticket *) noexcept,
+                        ggml_webgpu_optional::Ticket * ticket) {
+            return device.PopErrorScope(mode, callback, ticket);
+        }
+        wgpu::WaitStatus wait(wgpu::Future future, uint64_t timeout) { return instance.WaitAny(future, timeout); }
+        // A null GGML allocation can have an ordinary host-side cause. Pass it
+        // through the loader's normal failure path if the scopes are clean.
+        bool valid(const Pipeline &) { return true; }
+    } api{buft, context, global.device, global.instance};
+
+    using namespace ggml_webgpu_optional;
+    auto result = create_optional(api, global.optional_device->control, WEBGPU_RUNTIME_WAIT_TIMEOUT_NS,
+                                  false, WaitBudget::after_issue);
+    if (api.allocation_exception) {
+        std::rethrow_exception(api.allocation_exception);
+    }
+    if (result.outcome == Outcome::ready) {
+        return {result.pipeline.release(), false};
+    }
+    if (result.host_exception) {
+        std::rethrow_exception(result.host_exception);
+    }
+    if (result.outcome == Outcome::rejected) {
+        const auto & validation = result.scopes[0];
+        const auto & internal = result.scopes[1];
+        const auto & memory = result.scopes[2];
+        if (validation->error == wgpu::ErrorType::NoError && internal->error == wgpu::ErrorType::NoError &&
+            memory->error == wgpu::ErrorType::OutOfMemory) {
+            return {nullptr, true};
+        }
+        const auto & failure = validation->error != wgpu::ErrorType::NoError ? validation : internal;
+        GGML_LOG_ERROR("ggml_webgpu: model buffer creation rejected: %s\n", failure->message.data());
+    } else {
+        GGML_LOG_ERROR("ggml_webgpu: model buffer creation failed (reason %d)\n", int(result.fatal));
+    }
+    return {nullptr, false};
+}
