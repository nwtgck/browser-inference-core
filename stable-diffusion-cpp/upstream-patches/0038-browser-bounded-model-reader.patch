+enum class Mode { Unsupported, Raw, Bf16ToF32, Bf16ToF16 };
+
+inline Mode mode(ggml_type source, ggml_type destination, bool decoded_source) {
+    if (decoded_source) return Mode::Unsupported;
+    if (source == destination) return Mode::Raw;
+    if (source == GGML_TYPE_BF16 && destination == GGML_TYPE_F32) return Mode::Bf16ToF32;
+    if (source == GGML_TYPE_BF16 && destination == GGML_TYPE_F16) return Mode::Bf16ToF16;
+    return Mode::Unsupported;
+}
+
+inline void convert_bf16(Mode conversion, const void* source, void* destination, size_t elements) {
+    const auto* input = static_cast<const ggml_bf16_t*>(source);
+    if (conversion == Mode::Bf16ToF32) {
+        ggml_bf16_to_fp32_row(input, static_cast<float*>(destination), elements);
+    } else if (conversion == Mode::Bf16ToF16) {
+        auto* output = static_cast<ggml_fp16_t*>(destination);
+        // Same BF16->F32->F16 conversion as convert_tensor, without its full
+        // intermediate F32 tensor. Preserve GGML's rounding/NaN behavior.
+        for (size_t i = 0; i < elements; ++i) output[i] = ggml_fp32_to_fp16(ggml_bf16_to_fp32(input[i]));
+    } else {
+        throw std::invalid_argument("invalid bounded BF16 conversion");
+    }
+}
+
+// The file representation stays independent of the allocated tensor's dtype.
+// Raw quantized payloads use one complete type block as a source/destination
+// unit; BF16 conversion uses one element. No tensor-sized temporary is needed.
+class Reader {
+public:
+    static constexpr size_t source_chunk_bytes = 512 * 1024;
+    static constexpr size_t destination_chunk_bytes = 1024 * 1024;
+
+    template <typename Read, typename Convert, typename Write, typename Check>
+    bool read(uint64_t file_offset, uint64_t source_bytes, size_t source_unit,
+              size_t destination_unit, bool convert, Read read_source,
+              Convert convert_source, Write write_destination, Check check) {
+        if (source_unit == 0 || destination_unit == 0 ||
+            source_unit > source_chunk_bytes / 4 || source_bytes % source_unit != 0 ||
+            source_bytes > UINT64_MAX - file_offset ||
+            source_bytes / source_unit > UINT64_MAX / destination_unit ||
+            (!convert && source_unit != destination_unit)) {
+            throw std::invalid_argument("invalid bounded weight byte layout");
+        }
+        const size_t alignment = 4 * source_unit;
+        const size_t chunk_bytes = source_chunk_bytes / alignment * alignment;
+        const size_t units_per_chunk = chunk_bytes / source_unit;
+        if (units_per_chunk > destination_chunk_bytes / destination_unit) {
+            throw std::invalid_argument("bounded weight conversion exceeds scratch limit");
+        }
+        if (!check()) return false;
+        if (source_bytes == 0) return true;
+        // uint32_t/float storage also supplies alignment for the GGML converters.
+        if (!source_) source_.reset(new uint32_t[source_chunk_bytes / sizeof(uint32_t)]);
+        if (convert && !destination_) destination_.reset(new float[destination_chunk_bytes / sizeof(float)]);
+        uint64_t destination_offset = 0;
+        for (uint64_t consumed = 0; consumed < source_bytes;) {
+            const size_t count = static_cast<size_t>(std::min<uint64_t>(chunk_bytes, source_bytes - consumed));
+            const size_t units = count / source_unit;
+            const size_t output_bytes = units * destination_unit;
+            auto* source = reinterpret_cast<uint8_t*>(source_.get());
+            if (!check() || !read_source(file_offset + consumed, source, count) || !check()) return false;
+            const void* output = source;
+            if (convert) {
+                convert_source(source, destination_.get(), units);
+                output = destination_.get();
+            }
+            // Write consumes/copies the CPU slice before returning. GPU completion
+            // is owned by the destination backend, across successive reader calls.
+            if (!check() || !write_destination(output, destination_offset, output_bytes)) return false;
+            consumed += count;
+            destination_offset += output_bytes;
+            if (!check()) return false;
+        }
+        return true;
+    }
+
+    size_t scratch_bytes() const {
+        return (source_ ? source_chunk_bytes : 0) + (destination_ ? destination_chunk_bytes : 0);
+    }
+
+private:
+    std::unique_ptr<uint32_t[]> source_;
+    std::unique_ptr<float[]> destination_;
+};
+
+} // namespace browser_weights
