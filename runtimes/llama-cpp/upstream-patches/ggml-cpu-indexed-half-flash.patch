+#pragma once
+
+#include "ggml-impl.h"
+
+// Reproduce the F16 mask materialization after F32 mask+bias. Mode 1
+// continues to add the indexed bias without another F16 rounding step.
+static constexpr int32_t GGML_FLASH_ATTN_INDEXED_BIAS_F16_MASK = 2;
+
+static inline bool ggml_cpu_fattn_round_indexed_mask(const ggml_tensor * op) {
+    return ggml_get_op_params_i32(op, 5) == GGML_FLASH_ATTN_INDEXED_BIAS_F16_MASK;
+}
+
+static inline bool ggml_cpu_fattn_indexed_mask_supported(const ggml_tensor * op) {
+    const auto * q = op->src[0];
+    const auto * k = op->src[1];
+    const auto * v = op->src[2];
+    const auto * mask = op->src[3];
+    const auto * rows = op->src[5];
+    const auto * table = op->src[6];
+    const auto * indices = op->src[7];
+    if (!q || !k || !v || !mask || !table || !indices || q->type != GGML_TYPE_F32 ||
+        (k->type != GGML_TYPE_F16 && k->type != GGML_TYPE_F32) || k->type != v->type ||
+        q->ne[0] != k->ne[0] || q->ne[1] <= 0 || q->ne[2] <= 0 || q->ne[3] <= 0 ||
+        k->ne[1] <= 0 || v->ne[1] != k->ne[1] || k->ne[2] <= 0 || v->ne[2] <= 0 ||
+        q->ne[2] % k->ne[2] != 0 || q->ne[2] % v->ne[2] != 0 ||
+        q->ne[1] > INT64_MAX / q->ne[3]) {
+        return false;
+    }
+    if (rows) {
+        if (rows->type != GGML_TYPE_I32 || !ggml_is_contiguous(rows) || !ggml_is_matrix(rows) ||
+            rows->ne[0] <= 0 || rows->ne[1] != q->ne[3] || k->ne[3] != 1 || v->ne[3] != 1) {
+            return false;
+        }
+    } else if (k->ne[3] != q->ne[3] || v->ne[3] != q->ne[3]) {
+        return false;
+    }
+    const int64_t nc = rows ? rows->ne[0] : k->ne[1];
+    const int64_t nq = q->ne[1] * q->ne[3];
+    return mask->type == GGML_TYPE_F16 && ggml_is_contiguous(mask) &&
+           mask->ne[0] == nc && mask->ne[1] == q->ne[1] && mask->ne[2] == 1 && mask->ne[3] == q->ne[3] &&
+           table->type == GGML_TYPE_F32 && ggml_is_contiguous(table) && table->ne[0] > 0 &&
+           table->ne[1] == q->ne[2] && table->ne[2] == nq && table->ne[3] == 1 &&
+           indices->type == GGML_TYPE_I32 && ggml_is_contiguous(indices) && ggml_is_matrix(indices) &&
+           indices->ne[0] == nc && indices->ne[1] == nq;
+}
