+fn byte_of(v: u32, b: u32) -> u32 {
+    return (v >> (b * 8u)) & 0xFFu;
+}
+
+fn sbyte_of(v: u32, b: u32) -> i32 {
+    let raw = i32((v >> (b * 8u)) & 0xFFu);
+    return select(raw, raw - 256, raw >= 128);
+}
+
+
+
+fn inner_dot(src0_val: u32, src1_val: f32) -> f32 {
+    return f32(src0_val) * f32(src1_val);
+}
