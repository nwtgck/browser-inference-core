+++ b/ggml/src/ggml-webgpu/wgsl-shaders/scale_unary.wgsl
@@ -0,0 +1,45 @@
+@group(0) @binding(0)
+var<storage, read_write> src: array<f32>;
+#ifdef INPLACE
+#define PARAMS_BINDING 1
+#else
+@group(0) @binding(1)
+var<storage, read_write> dst: array<f32>;
+#define PARAMS_BINDING 2
+#endif
+
+struct Params {
+    ne: u32,
+    offset_src: u32,
+    offset_dst: u32,
+    padding: u32,
+    scale: f32,
+    bias: f32,
+    final_scale: f32,
+    final_bias: f32,
+};
+@group(0) @binding(PARAMS_BINDING)
+var<uniform> params: Params;
+
+@compute @workgroup_size(128)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let i = gid.x + num_wg.x * 128u * gid.y;
+    if (i >= params.ne) { return; }
+    let scaled = src[params.offset_src + i] * params.scale + params.bias;
+#ifdef SIGMOID
+    let activated = 1.0 / (1.0 + exp(-scaled));
+#else
+    let activated = scaled / (1.0 + exp(-scaled));
+#endif
+#ifdef FINAL_SCALE
+    let result = activated * params.final_scale + params.final_bias;
+#else
+    let result = activated;
+#endif
+#ifdef INPLACE
+    src[params.offset_src + i] = result;
+#else
+    dst[params.offset_dst + i] = result;
+#endif
+}
