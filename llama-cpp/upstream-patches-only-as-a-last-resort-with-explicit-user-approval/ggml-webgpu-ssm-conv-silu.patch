new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/ggml-webgpu-ssm-conv-silu.hpp
@@ -0,0 +1,59 @@
+#pragma once
+#include "ggml-impl.h"
+#include <cstdint>
+
+struct ssm_conv_silu_plan {
+    ggml_tensor * history = nullptr;
+    ggml_tensor * weights = nullptr;
+    ggml_tensor * conv = nullptr;
+    ggml_tensor * output = nullptr;
+    uint64_t history_bytes = 0, weights_bytes = 0, output_bytes = 0;
+};
+
+// Padded higher axes are supported; individual F32 rows remain contiguous.
+// Bound every intermediate before calling ggml_nbytes or narrowing to WGSL u32.
+inline bool ssm_conv_silu_layout(const ggml_tensor * tensor, bool dense, uint64_t & bytes) {
+    bytes = 0;
+    if (!tensor || tensor->type != GGML_TYPE_F32 || tensor->nb[0] != 4) { return false; }
+    constexpr uint64_t max_bytes = uint64_t(UINT32_MAX) * 4;
+    uint64_t count = 1, span = 4;
+    for (int axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+        if (tensor->ne[axis] <= 0 || uint64_t(tensor->ne[axis]) > UINT32_MAX - 31u ||
+            tensor->nb[axis] % 4 || tensor->nb[axis] < span || tensor->nb[axis] > max_bytes ||
+            (dense && tensor->nb[axis] != count * 4) ||
+            uint64_t(tensor->ne[axis]) > UINT32_MAX / count) { return false; }
+        const uint64_t extra = uint64_t(tensor->ne[axis]) - 1;
+        if (extra > (max_bytes - span) / tensor->nb[axis]) { return false; }
+        span += extra * tensor->nb[axis];
+        count *= uint64_t(tensor->ne[axis]);
+    }
+    bytes = span;
+    return true;
+}
+
+inline bool plan_ssm_conv_silu(const ggml_cgraph * graph, int index, ssm_conv_silu_plan & plan) {
+    plan = {};
+    if (!graph || index < 0 || index >= graph->n_nodes || graph->n_nodes - index < 2 ||
+        !ggml_can_fuse(graph, index, { GGML_OP_SSM_CONV, GGML_OP_UNARY })) { return false; }
+    auto * conv = graph->nodes[index];
+    auto * output = graph->nodes[index + 1];
+    auto * history = conv->src[0];
+    auto * weights = conv->src[1];
+    if (!history || !weights || conv->view_src || output->view_src || output->src[0] != conv ||
+        ggml_get_unary_op(output) != GGML_UNARY_OP_SILU || !ggml_are_same_shape(conv, output)) { return false; }
+    for (int s = 2; s < GGML_MAX_SRC; ++s) { if (conv->src[s]) { return false; } }
+    for (int s = 1; s < GGML_MAX_SRC; ++s) { if (output->src[s]) { return false; } }
+    uint64_t h, w, c, o;
+    if (!ssm_conv_silu_layout(history, false, h) || !ssm_conv_silu_layout(weights, false, w) ||
+        !ssm_conv_silu_layout(conv, true, c) || !ssm_conv_silu_layout(output, true, o) ||
+        history->ne[3] != 1 || weights->ne[2] != 1 || weights->ne[3] != 1 || output->ne[3] != 1 ||
+        history->ne[0] != weights->ne[0] - 1 + output->ne[1] ||
+        history->ne[1] != weights->ne[1] || output->ne[0] != history->ne[1] ||
+        output->ne[2] != history->ne[2]) { return false; }
+    plan = { history, weights, conv, output, h, w, o };
+    return true;
+}
+
+inline bool ssm_conv_silu_disjoint(uint64_t a, uint64_t an, uint64_t b, uint64_t bn) {
+    return an && bn && (a <= b ? an <= b - a : bn <= a - b);
+}
