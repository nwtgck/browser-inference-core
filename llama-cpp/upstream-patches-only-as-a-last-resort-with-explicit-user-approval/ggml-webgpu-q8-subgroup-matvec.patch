+++ b/ggml/src/ggml-webgpu/wgsl-shaders/q8_subgroup_matvec.wgsl
@@ -0,0 +1,92 @@
+enable subgroups;
+enable f16;
+
+// WG_SIZE is the checked fixed subgroup width for the unchanged accumulator.
+// The actual workgroup has Q8_SUBGROUP_WORKGROUP_SIZE invocations.
+#define DECLARE_BYTE_LOADERS_SRC0
+#include "common_decls.tmpl"
+#include "mul_mat_vec_acc.tmpl"
+
+struct MulMatParams {
+    offset_src0: u32,
+    offset_src1: u32,
+    offset_dst: u32,
+    m: u32,
+    n: u32,
+    k: u32,
+    stride_01: u32,
+    stride_11: u32,
+    stride_02: u32,
+    stride_12: u32,
+    stride_03: u32,
+    stride_13: u32,
+    bs02: u32,
+    bs03: u32,
+    broadcast2: u32,
+    broadcast3: u32
+};
+
+@group(0) @binding(0) var<storage, read_write> src0: array<SRC0_TYPE>;
+@group(0) @binding(1) var<storage, read_write> src1: array<SRC1_TYPE>;
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(3) var<uniform> params: MulMatParams;
+
+@compute @workgroup_size(Q8_SUBGROUP_WORKGROUP_SIZE)
+fn main(
+    @builtin(workgroup_id) wg_id: vec3<u32>,
+    @builtin(num_workgroups) num_wg: vec3<u32>,
+    @builtin(subgroup_id) subgroup_id: u32,
+    @builtin(subgroup_invocation_id) subgroup_invocation_id: u32,
+    @builtin(num_subgroups) num_subgroups: u32
+) {
+    let rows_per_wg: u32 = (Q8_SUBGROUP_WORKGROUP_SIZE / WG_SIZE) * OUTPUTS_PER_WG;
+    let output_groups = (params.m + rows_per_wg - 1u) / rows_per_wg;
+    let wg_linear = wg_id.y * num_wg.x + wg_id.x;
+    let batch_idx = wg_linear / output_groups;
+    let total_batches = params.bs02 * params.broadcast2 * params.bs03 * params.broadcast3;
+    if (batch_idx >= total_batches) {
+        return;
+    }
+    let row_base = (wg_linear % output_groups) * rows_per_wg + subgroup_id * OUTPUTS_PER_WG;
+
+    let dst2_stride = params.m * params.n;
+    let dst2_idx = batch_idx % (params.bs02 * params.broadcast2);
+    let dst3_stride = dst2_stride * params.bs02 * params.broadcast2;
+    let dst3_idx = batch_idx / (params.bs02 * params.broadcast2);
+    let src03_idx = dst3_idx / params.broadcast3;
+    let src02_idx = dst2_idx / params.broadcast2;
+    let src0_batch_offset = params.offset_src0 + src03_idx * params.stride_03 + src02_idx * params.stride_02;
+    let src1_idx_base = params.offset_src1 + dst3_idx * params.stride_13 + dst2_idx * params.stride_12;
+    let dst_idx_base = params.offset_dst + dst3_idx * dst3_stride + dst2_idx * dst2_stride + row_base;
+
+    let expected_subgroups: u32 = Q8_SUBGROUP_WORKGROUP_SIZE / WG_SIZE;
+    let owns_rows = subgroup_id < expected_subgroups;
+    var acc: array<array<f32, OUTPUTS_PER_WG>, NUM_COLS>;
+    if (num_subgroups == expected_subgroups) {
+        // All workgroup invocations fit exactly in full subgroups. Preserve
+        // the original accumulator call and floating-point operation order.
+        acc = accumulate_vec_dot(subgroup_invocation_id, row_base, src0_batch_offset, src1_idx_base);
+    } else {
+        // subgroup_size is a maximum: legal partial subgroups may have fewer
+        // active invocations. Compute-stage lane IDs are dense from zero.
+        let active_count = subgroupAdd(1u);
+        if (owns_rows) {
+            for (var virtual_tid = subgroup_invocation_id; virtual_tid < WG_SIZE; virtual_tid += active_count) {
+                let partial = accumulate_vec_dot(virtual_tid, row_base, src0_batch_offset, src1_idx_base);
+                for (var col = 0u; col < NUM_COLS; col++) {
+                    for (var row = 0u; row < OUTPUTS_PER_WG; row++) {
+                        acc[col][row] += partial[col][row];
+                    }
+                }
+            }
+        }
+    }
+    // Extra partial subgroups still reach every collective in uniform flow;
+    // only the expected subgroups access source rows or write output rows.
+    for (var row = 0u; row < OUTPUTS_PER_WG; row++) {
+        let total = subgroupAdd(acc[0][row]);
+        if (owns_rows && subgroup_invocation_id == 0u && row_base + row < params.m) {
+            dst[dst_idx_base + row] = total;
+        }
+    }
+}
