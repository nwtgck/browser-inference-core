+// Reuse the engine's existing ownership mutex; generation does no extra work.
+// A recursive callback may acquire the mutex, so also reject executing_.
+SD_API bool sd_ctx_get_runtime_info(sd_ctx_t* ctx, sd_runtime_info_t* out, size_t out_size) {
+    if (!ctx || !ctx->sd || !out || out_size < sizeof(*out)) return false;
+    auto& sd = *ctx->sd;
+    std::unique_lock<std::recursive_mutex> lock(sd.execution_mutex, std::try_to_lock);
+    if (!lock.owns_lock() || sd.executing_) return false;
+    sd_runtime_info_t info{};
+    info.struct_size = sizeof(info);
+    info.version = SD_RUNTIME_INFO_VERSION;
+    info.n_threads = sd.n_threads;
+    info.runners_ready = sd.runner_state_.ready;
+    info.eager_load = sd.eager_load;
+    info.enable_mmap = sd.enable_mmap;
+    info.disable_prefetch = sd.disable_prefetch;
+    info.disable_segmented_compute = sd.disable_segmented_compute;
+    info.auto_fit_enabled = sd.auto_fit_enabled;
+    *out = info;
+    return true;
+}
+
+SD_API bool sd_ctx_get_memory_info(sd_ctx_t* ctx, sd_memory_info_t* out, size_t out_size) {
+    if (!ctx || !ctx->sd || !out || out_size < sizeof(*out)) return false;
+    auto& sd = *ctx->sd;
+    std::unique_lock<std::recursive_mutex> lock(sd.execution_mutex, std::try_to_lock);
+    if (!lock.owns_lock() || sd.executing_ || !sd.model_manager) return false;
+    const auto memory = sd.model_manager->memory_info();
+    sd_memory_info_t info{};
+    info.struct_size = sizeof(info);
+    info.version = SD_MEMORY_INFO_VERSION;
+    info.registered_tensor_count = memory.registered_tensor_count;
+    info.registered_tensor_bytes = memory.registered_tensor_bytes;
+    info.manager_host_buffer_count = memory.manager_host_buffer_count;
+    info.manager_host_buffer_bytes = memory.manager_host_buffer_bytes;
+    info.manager_device_buffer_count = memory.manager_device_buffer_count;
+    info.manager_device_buffer_bytes = memory.manager_device_buffer_bytes;
+    info.tracked_runtime_cpu_bytes = memory.tracked_runtime_cpu_bytes;
+    info.tracked_runtime_non_cpu_bytes = memory.tracked_runtime_non_cpu_bytes;
+    info.tracked_runtime_unknown_bytes = memory.tracked_runtime_unknown_bytes;
+    info.saturated = memory.saturated;
+    *out = info;
+    return true;
+}
+
+SD_API bool sd_ctx_get_params(sd_ctx_t* ctx, sd_ctx_params_t* out, size_t out_size) {
+    if (!ctx || !ctx->sd || !out || out_size < sizeof(*out)) return false;
+    auto& sd = *ctx->sd;
+    std::unique_lock<std::recursive_mutex> lock(sd.execution_mutex, std::try_to_lock);
+    if (!lock.owns_lock() || sd.executing_ || !sd.config_) return false;
+    *out = sd.config_->params;
+    return true;
+}
