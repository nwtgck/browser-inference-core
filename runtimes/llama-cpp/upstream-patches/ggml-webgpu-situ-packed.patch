+static std::optional<webgpu_encoded_op> ggml_webgpu_situ(webgpu_context & ctx, ggml_cgraph * graph, int index,
+                                                       webgpu_fusion_view_sources & views, int & consumed) {
+    webgpu_situ::plan plan;
+    if (!webgpu_situ::match(graph, index, views, plan)) { return std::nullopt; }
+    constexpr uint32_t groups = webgpu_situ::elements / webgpu_situ::workgroup;
+    const auto & limits = ctx->global_ctx->capabilities.limits;
+    if (limits.maxComputeInvocationsPerWorkgroup < webgpu_situ::workgroup ||
+        limits.maxComputeWorkgroupSizeX < webgpu_situ::workgroup ||
+        limits.maxComputeWorkgroupsPerDimension < groups || limits.maxStorageBuffersPerShaderStage < 2 ||
+        limits.maxBindingsPerBindGroup < 3 || limits.maxUniformBuffersPerShaderStage < 1 ||
+        limits.maxUniformBufferBindingSize < WEBGPU_PARAMS_BUF_SIZE_BYTES) { return std::nullopt; }
+
+    webgpu_router_tail_binding packed, output;
+    if (!ggml_webgpu_router_tail_binding(ctx, plan.packed, webgpu_situ::input_bytes, packed) ||
+        !ggml_webgpu_router_tail_binding(ctx, plan.output, webgpu_situ::output_bytes, output) ||
+        (packed.buffer.Get() == output.buffer.Get() &&
+         !router_tail_disjoint(packed.offset, packed.size, output.offset, output.size))) { return std::nullopt; }
+
+    std::vector<uint32_t> params;
+    params.reserve(10);
+    params.push_back(packed.element_offset);
+    params.push_back(output.element_offset);
+    for (const auto * scale : plan.scales) {
+        params.push_back(ggml_webgpu_u32_from_f32(ggml_get_op_params_f32(scale, 0)));
+        params.push_back(ggml_webgpu_u32_from_f32(ggml_get_op_params_f32(scale, 1)));
+    }
+    const std::vector<wgpu::BindGroupEntry> entries = {
+        ggml_webgpu_make_bind_group_entry(0, packed.buffer, packed.offset, packed.size),
+        ggml_webgpu_make_bind_group_entry(1, output.buffer, output.offset, output.size),
+    };
+    auto pipeline = ctx->shader_lib->get_situ_pipeline();
+    auto encoded = ggml_backend_webgpu_build(ctx, pipeline, params, entries, groups, 1);
+    consumed = plan.nodes;
+    return encoded;
+}
