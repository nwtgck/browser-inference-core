+
+// One queue-wide upload window covers both set entry points and the generic
+// CPU->GPU tensor-copy path (which calls buffer_set_tensor). Keep the final
+// partial batch queued; synchronize and destination/context destruction drain
+// it before releasing GPU storage. Each WriteBuffer consumes its CPU slice
+// before returning, including across the existing JSPI completion waits.
+static void ggml_backend_webgpu_upload(webgpu_global_context & ctx, wgpu::Buffer & buffer,
+                                         uint64_t offset, const void * data, size_t size) {
+    std::lock_guard<std::recursive_mutex> lock(ctx->mutex);
+    GGML_ASSERT(offset <= buffer.GetSize() && size <= buffer.GetSize() - offset);
+    const auto * source = static_cast<const uint8_t *>(data);
+    auto reserve = [&](size_t bytes) {
+        ctx->uploads.reserve(bytes, [&]() { ggml_backend_webgpu_wait_queue(ctx); });
+    };
+    ggml_webgpu_upload_ranges(offset, size,
+        [&](uint64_t destination, uint64_t consumed, size_t bytes) {
+            reserve(bytes);
+            ctx->queue.WriteBuffer(buffer, destination, source + static_cast<size_t>(consumed), bytes);
+        },
+        [&](uint64_t destination, uint64_t consumed, size_t bytes) {
+            // The existing partial-word shader uses uint32 byte addresses. All
+            // currently supported bindings fit this range; reject rather than
+            // truncating if a future backend exposes a larger partial range.
+            GGML_ASSERT(destination <= UINT32_MAX && bytes <= UINT32_MAX - destination);
+            const uint32_t word = ggml_webgpu_upload_word(destination,
+                source + static_cast<size_t>(consumed), bytes);
+            reserve(3 * sizeof(uint32_t)); // partial-word uniform upload
+            ggml_backend_webgpu_buffer_memset(ctx, buffer, word, static_cast<size_t>(destination), bytes);
+        });
 }
 
