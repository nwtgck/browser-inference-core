+    if (lane < DEPTH_COUNT) {
+        let reciprocal = 1.0 / softmax_partial[0];
+        probabilities[query * DEPTH_COUNT + lane] = exponential * reciprocal;
+    }
+}
diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/depth_blend.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/depth_blend.wgsl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/depth_blend.wgsl
@@ -0,0 +1,110 @@
+#ifdef USE_SUBGROUP_REDUCTION
+enable subgroups;
+#endif
+
+struct Params {
+    output_offset: u32,
+};
+
+@group(0) @binding(0) var<storage, read> values: array<f32>;
+@group(0) @binding(1) var<storage, read> probabilities: array<f32>;
+@group(0) @binding(2) var<storage, read_write> output_values: array<f32>;
+@group(0) @binding(3) var<uniform> params: Params;
+
+const WIDTH = 2304u;
+const DEPTH_COUNT = u32(DEPTH);
+const WG_SIZE = u32(WORKGROUP);
+
+#ifdef PRESERVE_REDUCTION
+const OUTPUTS_PER_WG = 4u;
+var<workgroup> partials: array<f32, OUTPUTS_PER_WG * WG_SIZE>;
+#endif
+
+fn feature(depth: u32, column: u32) -> f32 {
+    return values[depth * WIDTH + column];
+}
+
+#if DEPTH == 4
+fn dot4(column: u32, p: u32) -> f32 {
+    let row = vec4(feature(0u, column), feature(1u, column), feature(2u, column), feature(3u, column));
+    let weights = vec4(probabilities[p], probabilities[p + 1u], probabilities[p + 2u], probabilities[p + 3u]);
+    return dot(row, weights);
+}
+#endif
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_id) local: vec3<u32>
+#ifdef USE_SUBGROUP_REDUCTION
+    , @builtin(subgroup_id) subgroup: u32, @builtin(subgroup_invocation_id) invocation: u32,
+      @builtin(num_subgroups) subgroups: u32, @builtin(subgroup_size) subgroup_size: u32
+#endif
+) {
+    let query = group.y;
+    let lane = local.x;
+    let p = query * DEPTH_COUNT;
+    let offset = params.output_offset + query * WIDTH;
+
+#ifdef PRESERVE_REDUCTION
+    // Keep the canonical matvec lane ownership and reduction while testing
+    // direct reads from depth-major storage. 2304 is divisible by four.
+    let first = group.x * OUTPUTS_PER_WG;
+    for (var r = 0u; r < OUTPUTS_PER_WG; r++) {
+        var term = 0.0;
+#if DEPTH == 4
+        if (lane == 0u) {
+            term += dot4(first + r, p);
+        }
+#else
+        if (lane < DEPTH_COUNT) {
+            term += feature(lane, first + r) * probabilities[p + lane];
+        }
+#endif
+#ifdef USE_SUBGROUP_REDUCTION
+        let total = subgroupAdd(term);
+        if (invocation == 0u) {
+            partials[r * WG_SIZE + subgroup] = total;
+        }
+#else
+        partials[r * WG_SIZE + lane] = term;
+#endif
+    }
+    workgroupBarrier();
+#ifdef USE_SUBGROUP_REDUCTION
+    for (var r = subgroup; r < OUTPUTS_PER_WG; r += subgroups) {
+        var sum = 0.0;
+        for (var i = invocation; i < subgroups; i += subgroup_size) {
+            sum += partials[r * WG_SIZE + i];
+        }
+        let total = subgroupAdd(sum);
+        if (invocation == 0u) {
+            output_values[offset + first + r] = total;
+        }
+    }
+#else
+    for (var step = WG_SIZE / 2u; step > 0u; step /= 2u) {
+        if (lane < step) {
+            for (var r = 0u; r < OUTPUTS_PER_WG; r++) {
+                partials[r * WG_SIZE + lane] += partials[r * WG_SIZE + lane + step];
+            }
+        }
+        workgroupBarrier();
+    }
+    if (lane < OUTPUTS_PER_WG) {
+        output_values[offset + first + lane] = partials[lane * WG_SIZE];
+    }
+#endif
+#else
+    let column = group.x * WG_SIZE + lane;
+    if (column < WIDTH) {
+#if DEPTH == 4
+        output_values[offset + column] = dot4(column, p);
+#else
+        var result = 0.0;
+        for (var r = 0u; r < DEPTH_COUNT; r++) {
+            result += feature(r, column) * probabilities[p + r];
+        }
+        output_values[offset + column] = result;
+#endif
+    }
+#endif
+}
