+static void st_validate_header(const nlohmann::json& header, uint64_t payload_bytes) {
+    if (!header.is_object()) throw std::runtime_error("safetensors header is not an object");
+    std::vector<std::pair<uint64_t, uint64_t>> ranges;
+    for (const auto& item : header.items()) {
+        if (item.key() == "__metadata__") {
