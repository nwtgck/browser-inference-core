// Source-extracted generic API with sparse CPU storage; no GPU allocation.
#include <cassert>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <map>
#include <unordered_map>
#include <vector>
#define GGML_ASSERT(value) assert(value)
struct ggml_tensor;
struct ggml_backend_buffer;
using ggml_backend_buffer_t = ggml_backend_buffer *;
using ggml_backend_buffer_type_t = void *;
using batch_hook = void (*)(ggml_backend_buffer_t, ggml_tensor * const *, const void * const *, const size_t *, const size_t *, size_t);
struct buffer_iface {
    void (*set_tensor)(ggml_backend_buffer_t, ggml_tensor *, const void *, size_t, size_t);
    void (*set_tensor_2d)(ggml_backend_buffer_t, ggml_tensor *, const void *, size_t, size_t, size_t, size_t, size_t);
    batch_hook set_tensor_n;
};
struct ggml_backend_buffer {
    buffer_iface iface{};
    ggml_backend_buffer_type_t buft;
    std::map<size_t, uint8_t> bytes;
};
struct ggml_tensor {
    ggml_tensor * view_src = nullptr;
    ggml_backend_buffer_t buffer;
    void * data = reinterpret_cast<void *>(1);
    size_t extent = 256;
    size_t base = 0;
};
static size_t ggml_nbytes(const ggml_tensor * tensor) { return tensor->extent; }
static int batches = 0, writes = 0;
static std::vector<size_t> order;
static void scalar(ggml_backend_buffer_t buffer, ggml_tensor * tensor, const void * input, size_t offset, size_t size) {
    writes++;
    order.push_back(tensor->base + offset);
    const auto * bytes = static_cast<const uint8_t *>(input);
    for (size_t i = 0; i < size; i++) buffer->bytes[tensor->base + offset + i] = bytes[i];
}
static void ggml_backend_webgpu_buffer_set_tensor_n(ggml_backend_buffer_t, ggml_tensor * const *, const void * const *, const size_t *, const size_t *, size_t) { batches++; }
struct hook_slot { batch_hook set_tensor_n; };
static hook_slot selected = {
@HOOK@
};
@GENERIC@
int main() {
    ggml_backend_buffer a{{scalar, nullptr, selected.set_tensor_n}, reinterpret_cast<void *>(1), {}};
    ggml_backend_buffer b{{scalar, nullptr, selected.set_tensor_n}, reinterpret_cast<void *>(1), {}};
    ggml_tensor first{nullptr, &a}, second{nullptr, &b};
    uint8_t bytes[] = {11, 12, 13, 21, 22, 23, 31, 32};
    ggml_tensor * tensors[] = {&first, &second};
    size_t offsets[] = {1, 2}, sizes[] = {3, 2}, data_offsets[] = {0, 3};
    ggml_backend_tensor_set_n(tensors, bytes, offsets, sizes, data_offsets, 0);
    assert(writes == 0 && batches == 0);
    ggml_backend_tensor_set_n(tensors, bytes, offsets, sizes, data_offsets, 2);
#ifndef __EMSCRIPTEN__
    assert(batches == 1 && writes == 0);
    std::cout << "{\"browser\":false,\"passed\":true}\n";
#else
    assert(batches == 0 && writes == 2);
    assert(a.bytes[1] == 11 && a.bytes[3] == 13 && b.bytes[2] == 21 && b.bytes[3] == 22);
    // Same-tensor regular batches take the actual set_2d scalar fallback.
    tensors[1] = &first;
    offsets[0] = 1; offsets[1] = 2;
    sizes[0] = sizes[1] = 3;
    data_offsets[0] = 0; data_offsets[1] = 3;
    order.clear();
    ggml_backend_tensor_set_n(tensors, bytes, offsets, sizes, data_offsets, 2);
    assert((order == std::vector<size_t>{1, 2}));
    assert(a.bytes[1] == 11 && a.bytes[2] == 21 && a.bytes[4] == 23);
    // Views preserve size_t offsets above 4 GiB without allocating that storage.
    ggml_tensor view{&first, nullptr};
    view.base = size_t{1} << 32;
    tensors[0] = &view; tensors[1] = &first;
    offsets[0] = 3; offsets[1] = 8;
    sizes[0] = 2; sizes[1] = 0;
    order.clear();
    ggml_backend_tensor_set_n(tensors, bytes, offsets, sizes, data_offsets, 2);
    assert(order.size() == 1 && order[0] == (size_t{1} << 32) + 3);
    assert(a.bytes[(size_t{1} << 32) + 3] == 11);
    bytes[0] = 99;
    assert(a.bytes[(size_t{1} << 32) + 3] == 11);
    std::cout << "{\"browser\":true,\"passed\":true}\n";
#endif
}
