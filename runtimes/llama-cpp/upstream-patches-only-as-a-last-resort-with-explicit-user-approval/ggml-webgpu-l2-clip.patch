diff --git a/ggml/src/ggml-webgpu/ggml-webgpu-l2-clip.hpp b/ggml/src/ggml-webgpu/ggml-webgpu-l2-clip.hpp
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/ggml-webgpu-l2-clip.hpp
@@ -0,0 +1,109 @@
+#pragma once
+
+#include "ggml-impl.h"
+#include "ggml-webgpu-rms-scale.hpp"
+#include "ggml-webgpu-fusion-view-sources.hpp"
+
+#include <cmath>
+#include <initializer_list>
+
+struct l2_clip_plan {
+    const ggml_tensor * input = nullptr;
+    const ggml_tensor * output = nullptr;
+    uint64_t input_bytes = 0;
+    uint64_t output_bytes = 0;
+    uint32_t width = 0;
+    uint32_t rows = 0;
+    float threshold = 0;
+};
+
+inline constexpr ggml_op l2_clip_ops[] = {
+    GGML_OP_SQR, GGML_OP_SUM_ROWS, GGML_OP_SQRT, GGML_OP_SCALE,
+    GGML_OP_FILL, GGML_OP_DIV, GGML_OP_CLAMP, GGML_OP_MUL,
+};
+
+inline constexpr int l2_clip_node_count = sizeof(l2_clip_ops) / sizeof(l2_clip_ops[0]);
+
+inline bool plan_l2_clip(const ggml_cgraph * graph, int index, webgpu_fusion_view_sources & views, l2_clip_plan & plan) {
+    plan = {};
+    if (!graph || index < 0 || index > graph->n_nodes - l2_clip_node_count) {
+        return false;
+    }
+    const auto * square = graph->nodes[index];
+    const auto width = square->ne[0];
+    const auto rows = square->ne[1];
+    if (square->op != GGML_OP_SQR || graph->nodes[index + 1]->op != GGML_OP_SUM_ROWS ||
+        square->ne[2] < 1 || square->ne[2] > 128 || square->ne[3] != 1 ||
+        !((width == 128 && (rows == 8 || rows == 24)) || (width == 16 && rows == 24))) {
+        return false;
+    }
+
+    int indices[l2_clip_node_count];
+    for (int i = 0; i < l2_clip_node_count; ++i) {
+        indices[i] = index + i;
+        const auto * node = graph->nodes[indices[i]];
+        if (node->op != l2_clip_ops[i] || node->type != GGML_TYPE_F32 || node->view_src ||
+            !ggml_is_contiguous(node)) {
+            return false;
+        }
+        const int operand_count = (node->op == GGML_OP_DIV || node->op == GGML_OP_MUL) ? 2 : 1;
+        for (int s = operand_count; s < GGML_MAX_SRC; ++s) {
+            if (node->src[s]) {
+                return false;
+            }
+        }
+    }
+
+    const auto * sum = graph->nodes[index + 1];
+    const auto * norm = graph->nodes[index + 2];
+    const auto * denom = graph->nodes[index + 3];
+    const auto * fill = graph->nodes[index + 4];
+    const auto * divide = graph->nodes[index + 5];
+    const auto * clamp = graph->nodes[index + 6];
+    const auto * output = graph->nodes[index + 7];
+    const auto * input = square->src[0];
+    if (!input || !ggml_are_same_shape(input, square) || !ggml_are_same_shape(input, output)) {
+        return false;
+    }
+    if (input->view_src && (input->view_src == input || input->view_src->view_src ||
+                            input->view_src->type != GGML_TYPE_F32)) {
+        return false;
+    }
+    if (sum->src[0] != square || norm->src[0] != sum || denom->src[0] != norm ||
+        fill->src[0] != denom || divide->src[0] != fill || divide->src[1] != denom ||
+        clamp->src[0] != divide || output->src[0] != input || output->src[1] != clamp) {
+        return false;
+    }
+    for (const auto * row_tensor : {sum, norm, denom, fill, divide, clamp}) {
+        if (row_tensor->ne[0] != 1 || row_tensor->ne[1] != rows ||
+            row_tensor->ne[2] != square->ne[2] || row_tensor->ne[3] != 1) {
+            return false;
+        }
+    }
+    const auto threshold = ggml_get_op_params_f32(fill, 0);
+    if (!std::isfinite(threshold) || threshold <= 0 ||
+        ggml_get_op_params_f32(denom, 0) != 1.0f || ggml_get_op_params_f32(denom, 1) != 1e-6f ||
+        ggml_get_op_params_i32(clamp, 0) != 0 || ggml_get_op_params_f32(clamp, 1) != 1.0f) {
+        return false;
+    }
+
+    const int output_index = index + l2_clip_node_count - 1;
+    if (!ggml_can_fuse_subgraph_ext(graph, indices, l2_clip_node_count, l2_clip_ops, &output_index, 1)) {
+        return false;
+    }
+
+    for (int i = 0; i < l2_clip_node_count - 1; ++i) {
+        if (views.contains(graph->nodes[indices[i]])) {
+            return false;
+        }
+    }
+
+    uint64_t input_bytes, output_bytes;
+    uint32_t elements, layout_rows;
+    if (!rms_scale_layout(input, true, input_bytes, elements, layout_rows) ||
+        !rms_scale_layout(output, true, output_bytes, elements, layout_rows)) {
+        return false;
+    }
+    plan = {input, output, input_bytes, output_bytes, uint32_t(width), layout_rows, threshold};
+    return true;
+}
