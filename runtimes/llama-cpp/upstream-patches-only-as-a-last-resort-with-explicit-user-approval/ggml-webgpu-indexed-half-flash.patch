+enable f16;
+
+struct Params {
+    kv: u32,
+    queries: u32,
+    heads: u32,
+    table_heads: u32,
+    head_first: u32,
+    buckets: u32,
+    pairs: u32,
+    table_offset: u32,
+    ids_offset: u32,
+    raw_offset: u32,
+    out_offset: u32,
+}
+
+@group(0) @binding(0) var<storage, read_write> table: array<f32>;
+@group(0) @binding(1) var<storage, read_write> relative_ids: array<i32>;
+@group(0) @binding(2) var<storage, read_write> raw: array<f16>;
+@group(0) @binding(3) var<storage, read_write> out_mask: array<vec2<f16>>;
+@group(0) @binding(4) var<uniform> params: Params;
+
+fn combined(index: u32) -> f16 {
+    let row = index / params.kv;
+    let query = row % params.queries;
+    let head_stream = row / params.queries;
+    let head = params.head_first + head_stream % params.heads;
+    let stream = head_stream / params.heads;
+    let flat_query = stream * params.queries + query;
+    let cell = flat_query * params.kv + index % params.kv;
+    let bucket = u32(relative_ids[params.ids_offset + cell]);
+    let bias = table[params.table_offset + (flat_query * params.table_heads + head) * params.buckets + bucket];
+    return f16(bias + f32(raw[params.raw_offset + cell]));
+}
+
+@compute @workgroup_size(128)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) grid: vec3<u32>) {
+    let pair = id.x + grid.x * 128u * id.y;
+    if (pair < params.pairs) {
+        out_mask[params.out_offset + pair] = vec2<f16>(combined(pair * 2u), combined(pair * 2u + 1u));
+    }
+}
