+// Q2_0 K640 uses four lanes for each of its ten 64-element blocks.
+// A smaller workgroup preserves each lane's block and each group's output rows.
+inline uint32_t ggml_webgpu_q2_indexed_short_workgroup(const ggml_webgpu_shader_lib_context & context) {
+    constexpr uint32_t fallback = WEBGPU_MUL_MAT_VEC_WG_SIZE;
+    const auto * a = context.src0;
+    const auto * x = context.src1;
+    const auto * ids = context.src2;
+    const auto * dst = context.dst;
+    const uint32_t sg_min = context.min_subgroup_size;
+    const uint32_t sg_max = context.max_subgroup_size;
+    if (!a || !x || !ids || !dst || !context.supports_subgroups ||
+        a->type != GGML_TYPE_Q2_0 || x->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32 ||
+        a->ne[0] != 640 || a->ne[1] != 2560 || x->ne[0] != a->ne[0] || dst->ne[0] != a->ne[1] ||
+        a->ne[2] <= 0 || a->ne[2] > UINT32_MAX || dst->ne[1] <= 0 || dst->ne[1] > a->ne[2] ||
+        ids->ne[0] != dst->ne[1] || (x->ne[1] != 1 && x->ne[1] != dst->ne[1]) ||
+        x->ne[2] != 1 || dst->ne[2] != 1 || ids->ne[1] != 1 || ids->ne[2] != 1 ||
+        a->ne[3] != 1 || x->ne[3] != 1 || dst->ne[3] != 1 || ids->ne[3] != 1 ||
+        sg_min < 4 || sg_max > 128 || sg_min > sg_max ||
+        (sg_min & (sg_min - 1)) != 0 || (sg_max & (sg_max - 1)) != 0) {
+        return fallback;
+    }
+    const uint32_t workgroup = std::max(64u, sg_max);
+    return workgroup <= context.max_wg_size ? workgroup : fallback;
 }
 
