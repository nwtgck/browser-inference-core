+static bool packed_bytes(const ggml_tensor * tensor, uint64_t & bytes) {
+    const uint64_t block = ggml_blck_size(tensor->type);
+    const uint64_t unit = ggml_type_size(tensor->type);
+    if (tensor->ne[0] <= 0 || uint64_t(tensor->ne[0]) % block != 0 ||
+        uint64_t(tensor->ne[0]) / block > UINT32_MAX / unit || tensor->nb[0] != unit) {
+        return false;
+    }
+    bytes = uint64_t(tensor->ne[0]) / block * unit;
+    for (int axis = 1; axis < GGML_MAX_DIMS; ++axis) {
+        if (tensor->ne[axis] <= 0 || uint64_t(tensor->ne[axis]) > UINT32_MAX / bytes ||
+            tensor->nb[axis] != bytes) {
+            return false;
+        }
+        bytes *= uint64_t(tensor->ne[axis]);
+    }
+    return true;
+}
+
+static bool shape(const ggml_tensor * tensor, ggml_type type, int64_t width, int64_t rows) {
+    uint64_t bytes;
+    return tensor && tensor->type == type && tensor->ne[0] == width && tensor->ne[1] == rows &&
+        tensor->ne[2] == 1 && tensor->ne[3] == 1 && packed_bytes(tensor, bytes);
+}
