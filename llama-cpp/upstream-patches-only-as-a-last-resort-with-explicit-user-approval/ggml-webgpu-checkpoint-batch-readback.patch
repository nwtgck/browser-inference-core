+#pragma once
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace batch_readback {
+constexpr size_t max_requests = 256;
+constexpr size_t max_pieces = 256;
+constexpr size_t staging_cap = 4 * 1024 * 1024;
+
+struct range {
+    size_t source_offset = 0;
+    size_t size = 0;
+};
+struct cursor {
+    size_t request = 0;
+    size_t consumed = 0;
+};
+struct piece {
+    size_t request;
+    size_t request_offset;
+    size_t source_offset;
+    size_t local_offset;
+    size_t size;
+    size_t slot;
+    size_t copy_size;
+};
+struct plan {
+    std::array<piece, max_pieces> pieces{};
+    size_t count = 0;
+    size_t bytes = 0;
+};
+
+// The provider validates complete source/destination ranges before this runs.
+// Each request copy span fits cap. cap is at least 8 and divisible by 8.
+inline plan next(const range * ranges, size_t count, cursor & position, size_t cap = staging_cap) {
+    assert(count <= max_requests && cap >= 8 && cap <= staging_cap && cap % 8 == 0);
+    plan result;
+    while (position.request < count && result.count < max_pieces) {
+        const auto & current = ranges[position.request];
+        if (position.consumed == current.size) {
+            ++position.request;
+            position.consumed = 0;
+            continue;
+        }
+        const size_t slot = (result.bytes + 7) & ~size_t(7);
+        if (slot == cap) break;
+        assert(position.consumed == 0);
+        const size_t source = current.source_offset;
+        const size_t local = source % 4;
+        const size_t size = current.size;
+        const size_t copy_size = (local + size + 3) & ~size_t(3);
+        assert(copy_size <= cap);
+        if (copy_size > cap - slot) break;
+        result.pieces[result.count++] = {position.request, position.consumed, source - local,
+                                       local, size, slot, copy_size};
+        result.bytes = slot + copy_size;
+        position.consumed += size;
+    }
+    return result;
+}
+
+struct slice {
+    size_t mapped_offset;
+    size_t mapped_size;
+    size_t destination_offset;
+    size_t source_skip;
+    size_t size;
+    bool direct;
+};
+struct scatter_plan {
+    std::array<slice, 3> slices{};
+    size_t count = 0;
+};
+
+// Every mapping is offset-aligned to 8, size-aligned to 4, and disjoint. Only
+// the edges use the caller's 8-byte scratch; padding never reaches its output.
+inline scatter_plan scatter(const piece & p) {
+    scatter_plan result;
+    if (p.local_offset == 0 && p.size % 4 == 0) {
+        result.slices[result.count++] = {p.slot, p.size, 0, 0, p.size, true};
+        return result;
+    }
+    size_t offset = p.slot, destination = 0, remaining = p.size;
+    if (p.local_offset || remaining < 8) {
+        const size_t mapped_size = std::min(size_t(8), p.copy_size);
+        const size_t size = std::min(remaining, mapped_size - p.local_offset);
+        result.slices[result.count++] = {offset, mapped_size, destination, p.local_offset, size, false};
+        offset += mapped_size; destination += size; remaining -= size;
+    }
+    const size_t body = remaining & ~size_t(7);
+    if (body) {
+        result.slices[result.count++] = {offset, body, destination, 0, body, true};
+        offset += body; destination += body; remaining -= body;
+    }
+    if (remaining) result.slices[result.count++] = {offset, (remaining + 3) & ~size_t(3), destination, 0, remaining, false};
+    return result;
+}
+} // namespace batch_readback
