+#pragma once
+
+#include "ggml-webgpu-ssm-conv-silu.hpp"
+
+struct ssm_conv_gate_plan {
+    ggml_tensor * history = nullptr;
+    ggml_tensor * weights = nullptr;
+    ggml_tensor * gate = nullptr;
+    ggml_tensor * output = nullptr;
+    uint64_t history_bytes = 0, weights_bytes = 0, gate_bytes = 0, output_bytes = 0;
+};
+
+inline bool plan_ssm_conv_gate(const ggml_cgraph * graph, int index, webgpu_fusion_view_sources & views,
+                              ssm_conv_gate_plan & plan) {
+    plan = {};
+    if (!graph || index < 0 || index >= graph->n_nodes || graph->n_nodes - index < 2 ||
+        !ggml_can_fuse(graph, index, {GGML_OP_SSM_CONV, GGML_OP_MUL})) {
+        return false;
+    }
+    auto * conv = graph->nodes[index];
+    auto * output = graph->nodes[index + 1];
+    auto * history = conv->src[0];
+    auto * weights = conv->src[1];
+    auto * gate = output->src[0];
+    if (!history || !weights || !gate || conv->view_src || output->view_src || output->src[1] != conv ||
+        gate == conv || gate->view_src == conv || !ggml_are_same_shape(gate, conv) ||
+        !ggml_are_same_shape(conv, output)) {
+        return false;
+    }
+    for (int source = 2; source < GGML_MAX_SRC; ++source) {
+        if (conv->src[source] || output->src[source]) {
+            return false;
+        }
+    }
+    uint64_t h, w, g, c, o;
+    if (!ssm_conv_silu_layout(history, false, h) || !ssm_conv_silu_layout(weights, false, w) ||
+        !ssm_conv_silu_layout(gate, false, g) || !ssm_conv_silu_layout(conv, true, c) ||
+        !ssm_conv_silu_layout(output, true, o) || history->ne[3] != 1 || weights->ne[2] != 1 ||
+        weights->ne[3] != 1 || output->ne[3] != 1 ||
+        history->ne[0] != weights->ne[0] - 1 + output->ne[1] ||
+        history->ne[1] != weights->ne[1] || output->ne[0] != history->ne[1] ||
+        output->ne[2] != history->ne[2] || views.contains(conv)) {
+        return false;
+    }
+    plan = {history, weights, gate, output, h, w, g, o};
+    return true;
+}
