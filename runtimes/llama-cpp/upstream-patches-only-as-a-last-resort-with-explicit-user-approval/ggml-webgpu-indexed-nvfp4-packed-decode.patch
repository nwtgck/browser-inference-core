+// UE4M3 reserves code 127. Exponent zero includes zero and subnormal scales.
+fn decode_nvfp4_scale(u: u32) -> f32 {
+    let exp = (u >> 3u) & 15u;
+    let man = u & 7u;
+    let normal = bitcast<f32>(((exp + 120u) << 23u) | (man << 20u));
+    let value = select(normal, f32(man) * (1.0 / 512.0), exp == 0u);
+    return select(value, 0.0, u == 127u);
+}
+
+fn decode_nvfp4_value(code: u32) -> f32 {
+    // Pack E2M1 magnitudes [0, 1, 2, 3, 4, 6, 8, 12] into eight nibbles.
+    let magnitude = (0xc8643210u >> ((code & 7u) * 4u)) & 15u;
+    return f32(i32(magnitude) * (1 - 2 * i32(code >> 3u)));
+}
