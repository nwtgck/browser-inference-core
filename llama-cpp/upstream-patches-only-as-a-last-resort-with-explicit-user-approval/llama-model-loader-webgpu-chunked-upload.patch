+// Loader-local queue budget: these are charged upload bytes, not a browser RAM limit.
+// The existing WebGPU synchronize path yields through the configured Wasm runtime.
+struct llama_webgpu_load_uploads {
+    static constexpr size_t budget = 32 * MiB;
+    static constexpr size_t overhead = 24; // up to two 12-byte head/tail parameter uploads
+    ggml_backend_dev_t device = nullptr;
+    ggml_backend_t backend = nullptr;
+    size_t pending = 0;
+
+    llama_webgpu_load_uploads() = default;
+    llama_webgpu_load_uploads(const llama_webgpu_load_uploads &) = delete;
+    llama_webgpu_load_uploads & operator=(const llama_webgpu_load_uploads &) = delete;
+
+    struct projection {
+        size_t waits;
+        size_t pending;
+    };
+
+    // Replay repeated full chunks and one tail without allocating or touching a
+    // backend. Products are limited by the charged budget, not the tensor size.
+    static projection project(size_t size, size_t chunk, size_t initial_pending) {
+        const size_t charge = chunk + overhead;
+        size_t full = size / chunk;
+        const size_t tail = size % chunk;
+        const size_t first = std::min(full, (budget - initial_pending) / charge);
+        size_t projected_pending = initial_pending + first * charge;
+        full -= first;
+        size_t waits = 0;
+        if (full != 0) {
+            const size_t per_batch = budget / charge;
+            waits = 1 + (full - 1) / per_batch;
+            projected_pending = (1 + (full - 1) % per_batch) * charge;
+        }
+        if (tail != 0) {
+            const size_t tail_charge = tail + overhead;
+            if (tail_charge > budget - projected_pending) {
+                ++waits;
+                projected_pending = 0;
+            }
+            projected_pending += tail_charge;
+        }
+        return { waits, projected_pending };
+    }
+
+    size_t chunk_size_for(ggml_backend_dev_t destination, size_t size, size_t alignment) const {
+        static constexpr size_t maximum = 8 * MiB;
+        static_assert(budget / 4 > overhead, "model upload budget must allow four charged chunks");
+        if (size == 0) {
+            return 0;
+        }
+        if (alignment == 0 || alignment > maximum) {
+            throw std::runtime_error("invalid WebGPU model upload chunk alignment");
+        }
+        const size_t original = std::min(size, (maximum / alignment) * alignment);
+        const size_t candidate = std::min(size, ((budget / 4 - overhead) / alignment) * alignment);
+        if (candidate == 0 || candidate >= original ||
+            (size - 1) / candidate != (size - 1) / original) {
+            return original;
+        }
+        // A device switch drains the old queue in reserve(), after the file read.
+        // Choosing a chunk must not initialize a backend or advance that wait.
+        const size_t initial = device == destination ? pending : 0;
+        const projection before = project(size, original, initial);
+        const projection after = project(size, candidate, initial);
+        // Equal read counts alone can increase waits when the larger final tail
+        // meets an earlier tensor's pending uploads. This ordering is preserved
+        // by every subsequent charged upload, including the final drain.
+        if (after.waits < before.waits ||
+            (after.waits == before.waits && after.pending <= before.pending)) {
+            return candidate;
+        }
+        return original;
+    }
+
+    void drain() {
+        if (pending != 0) {
+            ggml_backend_synchronize(backend);
+            pending = 0;
+        }
+    }
+
+    void reserve(ggml_backend_dev_t destination, size_t size) {
+        if (size > budget - overhead) {
+            throw std::runtime_error("WebGPU model upload exceeds loader budget");
+        }
+        if (device != destination) {
+            // One budget across all tensors/devices: retire the old queue first.
+            drain();
+            ggml_backend_free(backend);
+            backend = nullptr;
+            device = nullptr;
+            backend = ggml_backend_dev_init(destination, nullptr);
+            if (!backend) {
+                throw std::runtime_error("failed to initialize WebGPU model upload synchronizer");
+            }
+            device = destination;
+        }
+        const size_t charge = size + overhead;
+        if (charge > budget - pending) {
+            drain();
+        }
+        // Reserve before tensor_set so ordinary exceptions also drain partial work.
+        pending += charge;
+    }
+
+    ~llama_webgpu_load_uploads() {
+        // Final partial batches, callback cancellation and ordinary C++ exceptions.
+        // Upstream device-loss/abort behavior is unchanged; completion is not proof
+        // of successful uploads and cancellation cannot interrupt this wait.
+        drain();
+        ggml_backend_free(backend);
+    }
+};
