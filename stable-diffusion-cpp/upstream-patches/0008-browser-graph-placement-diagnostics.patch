         if (use_scheduler) {
             if (allocator_ != nullptr) {
@@ -130,6 +212,9 @@
                 return false;
             }
         }
+#ifdef SD_BROWSER_WEBGPU
+        placement.report(graph, backend_, scheduler_);
+#endif
         active_ = true;
         return true;
     }
