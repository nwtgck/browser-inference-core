enum ggml_op { GGML_OP_GET_ROWS, GGML_OP_MUL_MAT, GGML_OP_MUL_MAT_ID };
struct tensor {
    ggml_type type;
    size_t offset = 0;
    int64_t ne[4] = {1, 1, 1, 1};
};
struct limits_record { size_t minStorageBufferOffsetAlignment = 256; };
struct capabilities_record { limits_record limits; };
struct context_record { capabilities_record capabilities; };
struct device_record { context_record *webgpu_global_ctx; };
static size_t ggml_type_size(ggml_type type) {
    return type == GGML_TYPE_BF16 || type == GGML_TYPE_F16 ? 2 : 4;
}
static size_t ggml_webgpu_tensor_misalignment(const tensor *value, size_t alignment) {
    return value->offset % alignment;
}
static bool ggml_webgpu_supported_qtype(ggml_type) { return false; }
static bool admitted(ggml_op operation, tensor *src0, tensor *src1, tensor *op) {
    context_record global;
    device_record record{&global};
    auto *ctx = &record;
    bool supports_op = false;
    switch (operation) {
@CASES@
    }
    return supports_op;
}
