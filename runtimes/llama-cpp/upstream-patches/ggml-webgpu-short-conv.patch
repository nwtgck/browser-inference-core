+++ b/ggml/src/ggml-webgpu/ggml-webgpu-short-conv-state.hpp
@@ -0,0 +1,60 @@
+#pragma once
+
+#include "ggml-impl.h"
+
+struct short_conv_state_plan {
+    const ggml_tensor * past;
+    const ggml_tensor * current;
+    const ggml_tensor * history;
+    const ggml_tensor * state;
+};
+
+// Single-token normal state store. Copying the tail preserves its original
+// side effect and the complete concat tensor remains available to every user.
+inline bool plan_short_conv_state(const ggml_cgraph * graph, int index, short_conv_state_plan & plan) {
+    constexpr ggml_op ops[] = {GGML_OP_CONCAT, GGML_OP_VIEW, GGML_OP_VIEW, GGML_OP_CPY};
+    if (!graph || index < 0 || index > graph->n_nodes - 4) {
+        return false;
+    }
+    const auto * concat = graph->nodes[index];
+    const auto * tail = graph->nodes[index + 1];
+    const auto * cell = graph->nodes[index + 2];
+    const auto * copy = graph->nodes[index + 3];
+    if (concat->op != ops[0] || tail->op != ops[1] || cell->op != ops[2] || copy->op != ops[3] ||
+        ggml_get_op_params_i32(concat, 0) != 0 || !concat->src[0] || !concat->src[1] ||
+        tail->src[0] != concat || tail->view_src != concat || tail->view_offs != sizeof(float) ||
+        copy->src[0] != tail || copy->src[1] != cell || !cell->view_src || copy->view_src != cell->view_src ||
+        copy->view_offs != cell->view_offs) {
+        return false;
+    }
+    const auto * past = concat->src[0];
+    const auto * current = concat->src[1];
+    const auto * current_root = current->view_src;
+    const int64_t channels = concat->ne[1];
+    if (channels <= 0 || channels > UINT32_MAX / 4 || !current_root || current->view_offs || current_root->view_src) {
+        return false;
+    }
+    for (const auto * tensor : {past, current, concat, tail, cell, copy, current_root}) {
+        if (tensor->type != GGML_TYPE_F32 || tensor->ne[2] != 1 || tensor->ne[3] != 1) {
+            return false;
+        }
+    }
+    if (past->ne[0] != 3 || past->ne[1] != channels || past->nb[0] != 4 || past->nb[1] != 12 ||
+        current->ne[0] != 1 || current->ne[1] != channels || current->nb[1] != 4 ||
+        current_root->ne[0] != channels || current_root->ne[1] != 1 || current_root->nb[0] != 4 ||
+        concat->ne[0] != 4 || concat->nb[0] != 4 || concat->nb[1] != 16 || concat->view_src ||
+        tail->ne[0] != 3 || tail->ne[1] != channels || tail->nb[0] != 4 || tail->nb[1] != 16 ||
+        cell->ne[0] != 3 * channels || cell->ne[1] != 1 || cell->nb[0] != 4 ||
+        !ggml_are_same_shape(cell, copy) || !ggml_are_same_stride(cell, copy)) {
+        return false;
+    }
+
+    // The destination view and copy refer to persistent state. They stay
+    // explicit outputs in the closure check, alongside the materialized concat.
+    const int outputs[] = {index, index + 2, index + 3};
+    if (!ggml_can_fuse_subgraph(graph, index, 4, ops, outputs, 3)) {
+        return false;
+    }
+    plan = {past, current_root, concat, copy};
+    return true;
+}
diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/short_conv_residual.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/short_conv_residual.wgsl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/short_conv_residual.wgsl
@@ -0,0 +1,49 @@
+// Four-tap, single-decode-row kernel prototype.
+// The normal provider writes two F32 intermediates for this expression.
+// Compare this exact operator order with emitted SSM_CONV + ADD + SCALE.
+
+struct Params {
+    history_offset: u32,
+    weight_offset: u32,
+    residual_offset: u32,
+    output_offset: u32,
+    channels: u32,
+    history_stride: u32,
+    weight_stride: u32,
+    scale: f32,
+    bias: f32,
+};
+
+// All non-overlapping bindings can come from the same GGML backing buffer.
+// Use one WebGPU storage usage for that buffer throughout this dispatch.
+@group(0) @binding(0) var<storage, read_write> history: array<f32>;
+@group(0) @binding(1) var<storage, read_write> weights: array<f32>;
+#ifdef INPLACE_RESIDUAL
+@group(0) @binding(2) var<storage, read_write> residual: array<f32>;
+@group(0) @binding(3) var<uniform> params: Params;
+#else
+@group(0) @binding(2) var<storage, read_write> residual: array<f32>;
+@group(0) @binding(3) var<storage, read_write> output: array<f32>;
+@group(0) @binding(4) var<uniform> params: Params;
+#endif
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
+    let channel = gid.x;
+    if (channel >= params.channels) {
+        return;
+    }
+    let h = params.history_offset + channel * params.history_stride;
+    let w = params.weight_offset + channel * params.weight_stride;
+    let conv = history[h + 0u] * weights[w + 0u] +
+               history[h + 1u] * weights[w + 1u] +
+               history[h + 2u] * weights[w + 2u] +
+               history[h + 3u] * weights[w + 3u];
+    let combined = residual[params.residual_offset + channel] + conv;
+    let result = combined * params.scale + params.bias;
+#ifdef INPLACE_RESIDUAL
+    residual[params.output_offset + channel] = result;
+#else
+    output[params.output_offset + channel] = result;
+#endif
+}
diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/short_conv_concat_state.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/short_conv_concat_state.wgsl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/short_conv_concat_state.wgsl
@@ -0,0 +1,35 @@
+struct Params {
+    past_offset: u32,
+    current_offset: u32,
+    history_offset: u32,
+    state_offset: u32,
+    channels: u32,
+};
+
+@group(0) @binding(0) var<storage, read_write> past: array<u32>;
+@group(0) @binding(1) var<storage, read_write> current: array<u32>;
+@group(0) @binding(2) var<storage, read_write> history: array<u32>;
+@group(0) @binding(3) var<storage, read_write> state: array<u32>;
+@group(0) @binding(4) var<uniform> params: Params;
+
+@compute @workgroup_size(128)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
+    let channel = gid.x;
+    if (channel >= params.channels) {
+        return;
+    }
+    let p = params.past_offset + channel * 3u;
+    let h = params.history_offset + channel * 4u;
+    let s = params.state_offset + channel * 3u;
+    let p0 = past[p];
+    let p1 = past[p + 1u];
+    let p2 = past[p + 2u];
+    let cur = current[params.current_offset + channel];
+    history[h] = p0;
+    history[h + 1u] = p1;
+    history[h + 2u] = p2;
+    history[h + 3u] = cur;
+    state[s] = p1;
+    state[s + 1u] = p2;
+    state[s + 2u] = cur;
+}
