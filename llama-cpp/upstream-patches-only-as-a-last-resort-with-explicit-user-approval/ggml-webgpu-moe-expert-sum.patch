+// Called before encoding any member of the ADD chain. All failure paths leave
+// num_encoded_ops and the command stream unchanged, preserving staged fallback.
+static std::optional<webgpu_encoded_op> ggml_webgpu_moe_sum(webgpu_context & ctx,
+                                                          ggml_cgraph * graph,
+                                                          int node_idx,
+                                                          int & num_encoded_ops) {
+    moe_sum_plan plan;
+    if (!plan_moe_sum(graph, node_idx, plan)) { return std::nullopt; }
+    auto * src = plan.source;
+    auto * dst = plan.output;
+    if (!src->buffer || !dst->buffer || !src->buffer->context || !dst->buffer->context ||
+        !src->data || !dst->data || !src->buffer->buft || src->buffer->buft != dst->buffer->buft ||
+        src->buffer->buft->iface.get_name != ggml_backend_webgpu_buffer_type_get_name) { return std::nullopt; }
+    auto * sc = static_cast<ggml_backend_webgpu_buffer_context *>(src->buffer->context);
+    auto * dc = static_cast<ggml_backend_webgpu_buffer_context *>(dst->buffer->context);
+    if (sc->global_ctx != ctx->global_ctx || dc->global_ctx != ctx->global_ctx) { return std::nullopt; }
+    const auto & limits = ctx->global_ctx->capabilities.limits;
+    if (limits.maxComputeInvocationsPerWorkgroup < 128 || limits.maxComputeWorkgroupSizeX < 128 ||
+        limits.maxStorageBuffersPerShaderStage < 2) { return std::nullopt; }
+    uint32_t x, y;
+    if (!moe_sum_grid(uint64_t(plan.width_vec4) * plan.tokens,
+                      limits.maxComputeWorkgroupsPerDimension, x, y)) { return std::nullopt; }
+    auto valid = [&](ggml_tensor * tensor, const wgpu::Buffer & buffer) {
+        const uint64_t offset = ggml_webgpu_tensor_align_offset(ctx, tensor);
+        const uint64_t size = ggml_webgpu_tensor_binding_size(ctx, tensor);
+        const uint64_t prefix = ggml_webgpu_tensor_misalignment(ctx, tensor);
+        return prefix % 16 == 0 && size <= limits.maxStorageBufferBindingSize &&
+               size / 16 <= UINT32_MAX && offset <= buffer.GetSize() && size <= buffer.GetSize() - offset;
+    };
+    if (!valid(src, sc->buffer) || !valid(dst, dc->buffer)) { return std::nullopt; }
+    if (sc->buffer.Get() == dc->buffer.Get() &&
+        !moe_sum_disjoint(ggml_webgpu_tensor_align_offset(ctx, src), ggml_webgpu_tensor_binding_size(ctx, src),
+                          ggml_webgpu_tensor_align_offset(ctx, dst), ggml_webgpu_tensor_binding_size(ctx, dst))) {
+        return std::nullopt;
+    }
+    const std::vector<uint32_t> params = {
+        uint32_t(ggml_webgpu_tensor_misalignment(ctx, src) / 16),
+        uint32_t(ggml_webgpu_tensor_misalignment(ctx, dst) / 16), plan.width_vec4, plan.tokens,
+    };
+    const std::vector<wgpu::BindGroupEntry> entries = {
+        ggml_webgpu_make_tensor_bind_group_entry(ctx, 0, src),
+        ggml_webgpu_make_tensor_bind_group_entry(ctx, 1, dst),
+    };
+    auto pipeline = ctx->shader_lib->get_moe_sum_pipeline(plan.experts);
+    auto encoded = ggml_backend_webgpu_build(ctx, pipeline, params, entries, x, y);
+    num_encoded_ops = plan.operations;
+    return encoded;
+}
