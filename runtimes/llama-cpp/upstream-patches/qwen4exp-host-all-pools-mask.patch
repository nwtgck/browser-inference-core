+    template <typename T>
+    void fill_host_selection(T * dst, T drop) const {
+        std::fill_n(dst, n_kv, drop);
+        const auto keep = [&](int32_t cell) {
+            if (cell >= 0 && uint32_t(cell) < n_kv) {
+                dst[cell] = T(0);
+            }
