+// Never stage a same-device aligned copy through MapRead/host memory. Refuse
+// unsupported ranges before encoding anything, so GGML can retain its fallback.
+static bool ggml_backend_webgpu_copy_tensor(const ggml_tensor * src, ggml_tensor * dst, bool wait) {
+    auto src_buffer = src->view_src != nullptr ? src->view_src->buffer : src->buffer;
+    auto dst_buffer = dst->view_src != nullptr ? dst->view_src->buffer : dst->buffer;
+    if (src_buffer == nullptr || dst_buffer == nullptr ||
+        src_buffer->iface.get_base != ggml_backend_webgpu_buffer_get_base ||
+        dst_buffer->iface.get_base != ggml_backend_webgpu_buffer_get_base) {
+        return false;
+    }
+    auto src_ctx = static_cast<ggml_backend_webgpu_buffer_context *>(src_buffer->context);
+    auto dst_ctx = static_cast<ggml_backend_webgpu_buffer_context *>(dst_buffer->context);
+    if (src_ctx->global_ctx != dst_ctx->global_ctx || src->type != dst->type ||
+        !ggml_are_same_shape(src, dst) || !ggml_are_same_stride(src, dst)) {
+        return false;
+    }
+    const size_t bytes = ggml_nbytes(src);
+    if (bytes == 0) {
+        return true;
+    }
+    const size_t src_offset = ggml_webgpu_tensor_offset(src);
+    const size_t dst_offset = ggml_webgpu_tensor_offset(dst);
+    const size_t src_size = src_ctx->buffer.GetSize();
+    const size_t dst_size = dst_ctx->buffer.GetSize();
+    // copyBufferToBuffer requires different GPU buffers and four-byte-aligned
+    // ranges. Do not round F16 tails into a neighboring tensor or risk overflow.
+    if (bytes % 4 != 0 || src_offset % 4 != 0 || dst_offset % 4 != 0 ||
+        src_offset > src_size || bytes > src_size - src_offset ||
+        dst_offset > dst_size || bytes > dst_size - dst_offset ||
+        src_ctx->buffer.Get() == dst_ctx->buffer.Get()) {
+        return false;
+    }
+    auto global = src_ctx->global_ctx;
+    std::lock_guard<std::recursive_mutex> lock(global->mutex);
+    auto encoder = global->device.CreateCommandEncoder();
+    encoder.CopyBufferToBuffer(src_ctx->buffer, src_offset, dst_ctx->buffer, dst_offset, bytes);
+    auto commands = encoder.Finish();
+    global->queue.Submit(1, &commands);
+    if (wait) {
+        ggml_backend_webgpu_wait_queue(global);
+    }
+    return true;
+}
+
+static bool ggml_backend_webgpu_buffer_cpy_tensor(ggml_backend_buffer_t buffer,
+                                                  const ggml_tensor * src,
+                                                  ggml_tensor * dst) {
+    GGML_UNUSED(buffer);
+    // The synchronous buffer API must remain complete on return. RunnerCache
+    // uses the async backend API, then synchronizes once for all saved outputs.
+    return ggml_backend_webgpu_copy_tensor(src, dst, true);
+}
