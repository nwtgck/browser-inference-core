+
+static void ggml_backend_webgpu_get_tensor_async(ggml_backend_t backend,
+                                                 const ggml_tensor * tensor,
+                                                 void *              data,
+                                                 size_t              offset,
+                                                 size_t              size) {
+    auto * backend_ctx = (ggml_backend_webgpu_context *) backend->context;
+    ggml_backend_buffer_t buffer = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    bool same_queue = false;
+    if (size != 0 && buffer && buffer->iface.get_tensor == ggml_backend_webgpu_buffer_get_tensor) {
+        auto * buf_ctx = (ggml_backend_webgpu_buffer_context *) buffer->context;
+        same_queue = buf_ctx->global_ctx == backend_ctx->webgpu_ctx->global_ctx;
+    }
+    if (!same_queue) {
+        // Preserve the generic fallback for foreign buffers and zero-byte reads.
+        ggml_backend_synchronize(backend);
+    }
+    // Deliberately blocking: graph_compute submits its final batch before returning,
+    // and this buffer's copy is ordered after those submissions on the same queue.
+    // The existing MapAsync/WaitAny completes before data is copied or we return.
+    ggml_backend_tensor_get(tensor, data, offset, size);
+}
