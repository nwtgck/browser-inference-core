+static constexpr uint64_t WEBGPU_INDEXED_LIVE_GRID_ARGS_BYTES = 3 * sizeof(uint32_t);
+
+static bool ggml_webgpu_indexed_live_grid_binding_fits(const wgpu::Limits & limits) {
+    return limits.maxStorageBuffersPerShaderStage >= 5 && limits.maxBindingsPerBindGroup >= 6 &&
+           limits.maxBufferSize >= WEBGPU_INDEXED_LIVE_GRID_ARGS_BYTES &&
+           limits.maxStorageBufferBindingSize >= WEBGPU_INDEXED_LIVE_GRID_ARGS_BYTES;
+}
+
+static void ggml_webgpu_issue_indexed_live_grid_args(webgpu_global_context_struct & global) {
+    using phase = webgpu_global_context_struct::indexed_live_grid_phase;
+    auto expected = phase::idle;
+    if (!global.indexed_live_grid_state.compare_exchange_strong(expected, phase::issuing, std::memory_order_acq_rel)) {
+        return;
+    }
+    const auto & limits = global.capabilities.limits;
+    // Even the smallest reviewed matrix uses 64 threads and at least this many
+    // direct workgroups. Devices below these bounds use the canonical grid.
+    if (!ggml_webgpu_indexed_live_grid_binding_fits(limits) ||
+        limits.maxComputeInvocationsPerWorkgroup < 64 || limits.maxComputeWorkgroupSizeX < 64 ||
+        limits.maxComputeWorkgroupsPerDimension < 1716) {
+        global.indexed_live_grid_state.store(phase::rejected, std::memory_order_release);
+        return;
+    }
+
+    // Use the provider's scoped, terminal-aware creation protocol. In
+    // particular, a non-null buffer can still be a validation/OOM error object.
+    // The first exact-shape caller issues the three scopes synchronously.
+    // Each spawned callback holds only its independent CPU status record.
+    struct ops {
+        using Pipeline = wgpu::Buffer;
+        wgpu::Device & device;
+        wgpu::Instance & instance;
+
+        uint64_t now_ns() const noexcept {
+            return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count());
+        }
+        void push(wgpu::ErrorFilter filter) { device.PushErrorScope(filter); }
+        Pipeline create() {
+            Pipeline buffer;
+            ggml_webgpu_create_buffer(device, buffer, WEBGPU_INDEXED_LIVE_GRID_ARGS_BYTES,
+                                      wgpu::BufferUsage::Storage | wgpu::BufferUsage::Indirect,
+                                      "mul_mat_id indirect dispatch");
+            return buffer;
+        }
+        wgpu::Future pop(wgpu::CallbackMode mode,
+                        void (*callback)(wgpu::PopErrorScopeStatus, wgpu::ErrorType, wgpu::StringView,
+                                         ggml_webgpu_optional::Ticket *) noexcept,
+                        ggml_webgpu_optional::Ticket * ticket) {
+            return device.PopErrorScope(mode, callback, ticket);
+        }
+        wgpu::WaitStatus wait(wgpu::Future future, uint64_t timeout) { return instance.WaitAny(future, timeout); }
+        bool valid(const Pipeline & buffer) { return static_cast<bool>(buffer); }
+    } api{global.device, global.instance};
+    auto attempt = ggml_webgpu_optional::create_optional(api, global.optional_device->control, 0, true);
+    if (attempt.outcome != ggml_webgpu_optional::Outcome::pending) {
+        GGML_ABORT("ggml_webgpu: indexed indirect buffer scope issue failed (reason %d)", int(attempt.fatal));
+    }
+    global.indexed_live_grid_pending = std::move(attempt);
+    global.indexed_live_grid_state.store(phase::pending, std::memory_order_release);
+}
+
+static const wgpu::Buffer * ggml_webgpu_snapshot_indexed_live_grid_args(webgpu_global_context_struct & global,
+                                                                       bool & may_issue) {
+    using phase = webgpu_global_context_struct::indexed_live_grid_phase;
+    const auto state = global.indexed_live_grid_state.load(std::memory_order_acquire);
+    may_issue = state == phase::idle;
+    if (state != phase::pending) {
+        return state == phase::ready ? &global.indexed_live_grid_args : nullptr;
+    }
+
+    const std::unique_lock<std::mutex> lock(global.indexed_live_grid_mutex, std::try_to_lock);
+    if (!lock.owns_lock()) {
+        return nullptr;
+    }
+    const auto current = global.indexed_live_grid_state.load(std::memory_order_relaxed);
+    if (current != phase::pending) {
+        return current == phase::ready ? &global.indexed_live_grid_args : nullptr;
+    }
+    auto & pending = global.indexed_live_grid_pending;
+    if (std::any_of(pending.scopes.begin(), pending.scopes.end(), [](const auto & scope) {
+            return !scope->done.load(std::memory_order_acquire);
+        })) {
+        return nullptr;
+    }
+    ggml_webgpu_optional::finish_optional(pending, global.optional_device->control,
+                                         [](const wgpu::Buffer & buffer) { return static_cast<bool>(buffer); });
+    if (pending.outcome == ggml_webgpu_optional::Outcome::terminal) {
+        GGML_ABORT("ggml_webgpu: indexed indirect buffer scope completion failed (reason %d)", int(pending.fatal));
+    }
+    const bool ready = pending.outcome == ggml_webgpu_optional::Outcome::ready;
+    if (ready) {
+        global.indexed_live_grid_args = std::move(pending.pipeline);
+    }
+    pending = {};
+    global.indexed_live_grid_state.store(ready ? phase::ready : phase::rejected, std::memory_order_release);
+    return ready ? &global.indexed_live_grid_args : nullptr;
+}
