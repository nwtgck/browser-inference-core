+#ifdef SD_BROWSER_WEBGPU
+sd_image_t* tensor_to_sd_video_frames_checked(const sd::Tensor<float>& tensor,
+                                             int requested_frames, int* frame_count,
+                                             bool (*cancelled)(void*), void* user_data) {
+    if (frame_count != nullptr) *frame_count = 0;
+    const auto& shape = tensor.shape();
+    const auto stopped = [&]() { return cancelled != nullptr && cancelled(user_data); };
+    if (frame_count == nullptr || tensor.empty() || shape.size() != 5 || shape[4] != 1 ||
+        shape[0] <= 0 || shape[0] > std::numeric_limits<int>::max() ||
+        shape[1] <= 0 || shape[1] > std::numeric_limits<int>::max() ||
+        shape[2] <= 0 || shape[2] > std::numeric_limits<int>::max() ||
+        (shape[3] != 3 && shape[3] != 4) || requested_frames <= 0 || stopped()) return nullptr;
+    size_t frame_bytes = static_cast<size_t>(shape[0]);
+    for (int axis : {1, 3}) {
+        if (static_cast<size_t>(shape[axis]) > std::numeric_limits<size_t>::max() / frame_bytes) return nullptr;
+        frame_bytes *= static_cast<size_t>(shape[axis]);
+    }
+    const int count = static_cast<int>(std::min<int64_t>(requested_frames, shape[2]));
+    if (static_cast<size_t>(count) > std::numeric_limits<size_t>::max() / sizeof(sd_image_t)) return nullptr;
+    auto frames = static_cast<sd_image_t*>(calloc(static_cast<size_t>(count), sizeof(sd_image_t)));
+    if (frames == nullptr) return nullptr;
+    // calloc initializes unfilled records, so the same cleanup handles every
+    // partial allocation and cancellation point without publishing ownership.
+    auto discard = [&]() -> sd_image_t* {
+        for (int i = 0; i < count; ++i) free(frames[i].data);
+        free(frames); return nullptr;
+    };
+    for (int i = 0; i < count; ++i) {
+        if (stopped()) return discard();
+        auto data = static_cast<uint8_t*>(malloc(frame_bytes));
+        if (data == nullptr) return discard();
+        frames[i] = {static_cast<uint32_t>(shape[0]), static_cast<uint32_t>(shape[1]),
+                     static_cast<uint32_t>(shape[3]), data};
+        preprocessing_tensor_frame_to_sd_image(tensor, i, data);
+    }
+    if (stopped()) return discard();
+    *frame_count = count;
+    return frames;
+}
+#endif
+
 sd::Tensor<float> sd_image_to_tensor(sd_image_t image,
                                      int target_width,
                                      int target_height,
