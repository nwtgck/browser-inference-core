+#ifdef SD_BROWSER_WEBGPU
+// Split queries, never keys: each row retains its complete softmax denominator,
+// mask and optional sink. This preserves manual attention (including precision)
+// instead of silently enabling Flash Attention when its setting is disabled.
+static ggml_tensor* browser_bounded_attention(ggml_context* ctx, ggml_backend_t backend,
+                                               ggml_tensor* q, ggml_tensor* k, ggml_tensor* v,
+                                               ggml_tensor* mask, ggml_tensor* sinks, float scale) {
+    if (!sd_backend_is(backend, "WebGPU") || q->type != GGML_TYPE_F32 || q->ne[1] <= 1 ||
+        (k->type != GGML_TYPE_F32 && k->type != GGML_TYPE_F16) ||
+        (v->type != GGML_TYPE_F32 && v->type != GGML_TYPE_F16) ||
+        (mask != nullptr && mask->ne[1] != 1 && mask->ne[1] != q->ne[1])) {
+        return nullptr;
+    }
+    auto full = ggml_mul_mat(ctx, k, q);
+    if (ggml_backend_supports_op(backend, full)) {
+        return nullptr;
+    }
+    const int64_t queries = q->ne[1];
+    constexpr int64_t max_chunks = 64;
+    for (int64_t rows = queries / 2; rows > 0 && 1 + (queries - 1) / rows <= max_chunks; rows /= 2) {
+        auto output = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, v->ne[1], queries, full->ne[2], full->ne[3]);
+        bool supported = true;
+        for (int64_t begin = 0; begin < queries; begin += rows) {
+            const int64_t count = std::min(rows, queries - begin);
+            auto query = ggml_view_4d(ctx, q, q->ne[0], count, q->ne[2], q->ne[3],
+                                        q->nb[1], q->nb[2], q->nb[3], begin * q->nb[1]);
+            auto scores = ggml_mul_mat(ctx, k, query);
+            ggml_mul_mat_set_prec(scores, GGML_PREC_F32);
+            auto scaled = ggml_scale_inplace(ctx, scores, scale);
+            auto logits = scaled;
+            if (mask != nullptr) {
+                auto chunk_mask = mask->ne[1] == 1 ? mask :
+                    ggml_view_4d(ctx, mask, mask->ne[0], count, mask->ne[2], mask->ne[3],
+                                 mask->nb[1], mask->nb[2], mask->nb[3], begin * mask->nb[1]);
+                logits = ggml_add_inplace(ctx, scaled, chunk_mask);
+            }
+            auto probabilities = sinks != nullptr ? ggml_soft_max(ctx, logits) : ggml_soft_max_inplace(ctx, logits);
+            if (sinks != nullptr) {
+                ggml_soft_max_add_sinks(probabilities, sinks);
+            }
+            auto chunk = ggml_mul_mat(ctx, v, probabilities);
+            auto merged = ggml_set_inplace(ctx, output, chunk, output->nb[1], output->nb[2], output->nb[3],
+                                            begin * output->nb[1]);
+            if (!ggml_backend_supports_op(backend, scores) || !ggml_backend_supports_op(backend, scaled) ||
+                !ggml_backend_supports_op(backend, logits) || !ggml_backend_supports_op(backend, probabilities) ||
+                !ggml_backend_supports_op(backend, chunk) || !ggml_backend_supports_op(backend, merged)) {
+                supported = false;
+                break;
+            }
+            output = merged;
+        }
+        if (supported) {
+            ggml_set_name(output, "browser.bounded_attention");
+            return output;
+        }
+    }
+    return nullptr;
+}
