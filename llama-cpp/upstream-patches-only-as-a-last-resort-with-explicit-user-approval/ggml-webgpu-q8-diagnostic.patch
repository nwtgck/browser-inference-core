+struct webgpu_q8_diagnostic_binding {
+    wgpu::Buffer buffer;
+    uint64_t offset, size, payload_offset, payload_size;
+};
+
+static bool ggml_webgpu_q8_diagnostic_binding(webgpu_context & ctx, const ggml_tensor * tensor,
+                                              uint64_t bytes, uint64_t block_bytes,
+                                              webgpu_q8_diagnostic_binding & out) {
+    auto * buffer = tensor->buffer;
+    if (!buffer || !buffer->context || buffer->iface.get_base != ggml_backend_webgpu_buffer_get_base ||
+        !tensor->data || tensor->view_src || tensor->view_offs) { return false; }
+    auto * bc = (ggml_backend_webgpu_buffer_context *) buffer->context;
+    if (bc->global_ctx != ctx->global_ctx || !bc->buffer ||
+        (bc->buffer.GetUsage() & wgpu::BufferUsage::Storage) == wgpu::BufferUsage::None) { return false; }
+    const uint64_t base = reinterpret_cast<uintptr_t>(webgpu_ptr_base);
+    const uint64_t data = reinterpret_cast<uintptr_t>(tensor->data);
+    if (data < base) { return false; }
+    const uint64_t offset = data - base;
+    const uint64_t alignment = ctx->global_ctx->capabilities.limits.minStorageBufferOffsetAlignment;
+    if (alignment < 4 || (alignment & (alignment - 1)) || offset % (block_bytes == 34 ? 2 : 4)) { return false; }
+    uint64_t aligned = offset & ~(alignment - 1);
+    // The inherited quantized binding helper aligns a whole number of blocks.
+    // There are at most 17 residues for Q8_0 and a power-of-two alignment.
+    for (unsigned i = 0; (offset - aligned) % block_bytes; ++i) {
+        if (i >= 17 || aligned < alignment) { return false; }
+        aligned -= alignment;
+    }
+    const uint64_t size = (offset - aligned + bytes + 3) & ~uint64_t(3);
+    const auto & limits = ctx->global_ctx->capabilities.limits;
+    if (offset > buffer->size || bytes > buffer->size - offset ||
+        aligned > buffer->size || size > buffer->size - aligned ||
+        aligned > bc->buffer.GetSize() || size > bc->buffer.GetSize() - aligned ||
+        size > limits.maxStorageBufferBindingSize || size > UINT32_MAX - 4u) { return false; }
+    out = {bc->buffer, aligned, size, offset, bytes};
+    return true;
+}
+
+static bool ggml_webgpu_q8_diagnostic_shape(ggml_tensor * dst, uint64_t (&bytes)[3]) {
+    if (!dst || dst->op != GGML_OP_MUL_MAT || !dst->src[0] || !dst->src[1]) { return false; }
+    for (int i = 2; i < GGML_MAX_SRC; ++i) { if (dst->src[i]) { return false; } }
+    auto * a = dst->src[0]; auto * x = dst->src[1];
+    if (a->type != GGML_TYPE_Q8_0 || x->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        a->ne[0] < 32 || a->ne[0] > 16384 || a->ne[0] % 32 ||
+        a->ne[1] < 1 || a->ne[1] > 65536 || x->ne[0] != a->ne[0] || dst->ne[0] != a->ne[1] ||
+        x->ne[1] != 1 || dst->ne[1] != 1) { return false; }
+    for (auto * t : {a, x, dst}) {
+        if (t->view_src || t->view_offs || t->ne[2] != 1 || t->ne[3] != 1) { return false; }
+    }
+    const uint64_t row = uint64_t(a->ne[0] / 32) * 34;
+    bytes[0] = row * uint64_t(a->ne[1]); bytes[1] = uint64_t(x->ne[0]) * 4; bytes[2] = uint64_t(dst->ne[0]) * 4;
+    if (bytes[0] > 64u * 1024u * 1024u) { return false; }
+    const ggml_tensor * tensors[3] = {a, x, dst};
+    for (unsigned i = 0; i < 3; ++i) {
+        const auto * t = tensors[i];
+        const uint64_t nb0 = i == 0 ? 34 : 4;
+        const uint64_t nb1 = i == 0 ? row : bytes[i];
+        if (t->nb[0] != nb0 || t->nb[1] != nb1 || t->nb[2] != bytes[i] || t->nb[3] != bytes[i]) { return false; }
+    }
+    return true;
+}
+
+static int32_t ggml_backend_webgpu_q8_diagnostic_v1(ggml_backend_t backend, ggml_tensor * dst,
+                  const ggml_webgpu_q8_diagnostic_request_v1 * request,
+                  ggml_webgpu_q8_diagnostic_report_v1 * report, uint32_t report_capacity) {
+    if (!report || report_capacity < sizeof(*report) || !request) { return GGML_WEBGPU_Q8_DIAGNOSTIC_BAD_REQUEST_V1; }
+    const auto req = *request; // Copy before pipeline creation or profile-map suspension.
+    ggml_webgpu_q8_diagnostic_report_v1 result{};
+    result.abi_version = 1; result.struct_size = sizeof(result); result.requested_variant = req.variant; result.phase = req.phase;
+    const auto finish = [&](int32_t status) { result.status = uint32_t(status); *report = result; return status; };
+    if (req.abi_version != 1 || req.struct_size != sizeof(req) || req.reserved || req.variant > 5 ||
+        (req.phase != 1 && req.phase != 2) || (req.phase == 1 && req.repetitions) ||
+        (req.phase == 2 && (!req.repetitions || req.repetitions > 128))) { return finish(GGML_WEBGPU_Q8_DIAGNOSTIC_BAD_REQUEST_V1); }
+    if (!backend || backend->guid != ggml_backend_webgpu_guid() || !backend->context) { return finish(GGML_WEBGPU_Q8_DIAGNOSTIC_UNAVAILABLE_V1); }
+    auto ctx = ((ggml_backend_webgpu_context *) backend->context)->webgpu_ctx;
+    webgpu_profile_operation_guard guard(ctx->operation_in_progress);
+    if (!guard.acquired) { return finish(GGML_WEBGPU_Q8_DIAGNOSTIC_BUSY_V1); }
+    uint64_t bytes[3];
+    if (!ggml_webgpu_q8_diagnostic_shape(dst, bytes)) { return finish(GGML_WEBGPU_Q8_DIAGNOSTIC_UNSUPPORTED_V1); }
+    ggml_tensor * tensors[3] = {dst->src[0], dst->src[1], dst};
+    webgpu_q8_diagnostic_binding bindings[3];
+    for (unsigned i = 0; i < 3; ++i) {
+        if (!ggml_webgpu_q8_diagnostic_binding(ctx, tensors[i], bytes[i], i == 0 ? 34 : 4, bindings[i])) { return finish(GGML_WEBGPU_Q8_DIAGNOSTIC_UNSUPPORTED_V1); }
+    }
+    for (unsigned i = 0; i < 3; ++i) for (unsigned j = i + 1; j < 3; ++j) {
+        const auto & a = bindings[i]; const auto & b = bindings[j];
+        if (a.buffer.Get() == b.buffer.Get() &&
+            (!(a.payload_offset <= b.payload_offset ? a.payload_size <= b.payload_offset - a.payload_offset : b.payload_size <= a.payload_offset - b.payload_offset) ||
+             !(a.offset <= b.offset ? a.size <= b.offset - a.offset : b.size <= a.offset - b.offset))) { return finish(GGML_WEBGPU_Q8_DIAGNOSTIC_UNSUPPORTED_V1); }
+    }
+    const auto context = ggml_webgpu_mat_context(ctx, tensors[0], tensors[1], dst);
+    auto key = ggml_webgpu_shader_lib::make_mul_mat_vec_key(context, false);
+    if (req.variant == 0 && key.use_mmvq) { return finish(GGML_WEBGPU_Q8_DIAGNOSTIC_UNSUPPORTED_V1); }
+    if (req.variant) {
+        key.use_mmvq = false;
+        key.workgroup_size = req.variant == 1 ? 256 : 128;
+        key.subgroup_size = req.variant >= 2 && req.variant <= 4 ? context.min_subgroup_size : 0;
+        key.q8_rows_per_tile = req.variant == 3 ? 1 : req.variant == 4 || req.variant == 5 ? 2 : 4;
+        if (req.variant >= 2 && req.variant <= 4 &&
+            (!context.supports_subgroups || key.subgroup_size != context.max_subgroup_size ||
+             key.subgroup_size < 4 || key.subgroup_size > 64 || (key.subgroup_size & (key.subgroup_size - 1)))) {
+            return finish(GGML_WEBGPU_Q8_DIAGNOSTIC_UNSUPPORTED_V1);
+        }
+    }
+    const auto & limits = ctx->global_ctx->capabilities.limits;
+    const uint32_t outputs = key.subgroup_size ? key.q8_rows_per_tile * (key.workgroup_size / key.subgroup_size) : key.q8_rows_per_tile;
+    const uint32_t groups = (uint32_t(dst->ne[0]) + outputs - 1) / outputs;
+    if (!limits.maxComputeWorkgroupsPerDimension || uint64_t(groups) > uint64_t(limits.maxComputeWorkgroupsPerDimension) * limits.maxComputeWorkgroupsPerDimension ||
+        limits.maxComputeInvocationsPerWorkgroup < key.workgroup_size || limits.maxComputeWorkgroupSizeX < key.workgroup_size ||
+        (!key.subgroup_size && limits.maxComputeWorkgroupStorageSize < key.q8_rows_per_tile * key.workgroup_size * 4) ||
+        limits.maxStorageBuffersPerShaderStage < 3 || limits.maxBindingsPerBindGroup < 4 || limits.maxUniformBuffersPerShaderStage < 1 ||
+        limits.maxUniformBufferBindingSize < ctx->param_arena.slot_size || !ctx->global_ctx->device.HasFeature(wgpu::FeatureName::ShaderF16)) {
+        return finish(GGML_WEBGPU_Q8_DIAGNOSTIC_UNSUPPORTED_V1);
+    }
+    result.actual_algorithm = key.subgroup_size ? 2 : 1;
+    result.workgroup_size = key.workgroup_size; result.logical_subgroup_size = key.subgroup_size;
+    result.real_min_subgroup_size = context.min_subgroup_size; result.real_max_subgroup_size = context.max_subgroup_size;
+    result.rows_per_tile = key.q8_rows_per_tile; result.outputs_per_workgroup = outputs;
+    result.cooperative_subgroup_reduction = !key.subgroup_size && key.subgroup_reduction;
+    compute_2d_workgroups(groups, limits.maxComputeWorkgroupsPerDimension, result.grid_x, result.grid_y); result.grid_z = 1;
+    result.codegen_revision = 1;
+    auto pipeline = req.phase == 1 ? std::optional<webgpu_pipeline>(ctx->shader_lib->prepare_q8_diagnostic_pipeline(context, key)) :
+                                     ctx->shader_lib->find_q8_diagnostic_pipeline(key);
+    if (!pipeline) { return finish(GGML_WEBGPU_Q8_DIAGNOSTIC_NOT_PREPARED_V1); }
+    memcpy(result.shader_sha256, pipeline->diagnostic_sha256.data(), sizeof(result.shader_sha256));
+    if (req.phase == 1) { return finish(GGML_WEBGPU_Q8_DIAGNOSTIC_OK_V1); }
+    std::vector<ggml_tensor *> nodes(req.repetitions, dst);
+    ggml_cgraph graph{}; graph.n_nodes = int(nodes.size()); graph.nodes = nodes.data();
+    const auto status = ggml_backend_webgpu_graph_compute_impl(backend, &graph,
+        [&](webgpu_context & op_ctx, ggml_cgraph *, int, int & count) -> std::optional<webgpu_encoded_op> {
+            count = 1;
+            auto encoded = ggml_webgpu_mul_mat_impl<true>(op_ctx, tensors[0], tensors[1], dst, &*pipeline);
+            result.dispatches += encoded.num_kernels;
+            return encoded;
+        });
+    GGML_ASSERT(status == GGML_STATUS_SUCCESS);
+    return finish(GGML_WEBGPU_Q8_DIAGNOSTIC_OK_V1);
+}
