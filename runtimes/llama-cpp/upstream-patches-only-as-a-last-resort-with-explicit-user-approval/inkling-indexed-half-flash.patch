+static ggml_tensor * build_dense_relative_attention_mask(
+        const llm_graph_context & graph, ggml_tensor * raw, ggml_tensor * table, ggml_tensor * buckets, int il) {
+    ggml_context * ctx = graph.ctx0;
+    auto * transposed = ggml_cont(ctx, ggml_permute(ctx, table, 1, 0, 2, 3));
+    auto * bias = ggml_get_rows(ctx, transposed, buckets);
+    bias = ggml_reshape_4d(ctx, bias, table->ne[1], raw->ne[0], raw->ne[1], raw->ne[3]);
+    bias = ggml_cont(ctx, ggml_permute(ctx, bias, 2, 0, 1, 3));
+    graph.cb(bias, "kq_b", il);
+
+    auto * mask = raw->type == GGML_TYPE_F32 ? raw : ggml_cast(ctx, raw, GGML_TYPE_F32);
+    mask = ggml_add(ctx, bias, mask);
+    if (graph.cparams.flash_attn) {
+        mask = ggml_cast(ctx, mask, GGML_TYPE_F16);
+    }
+    graph.cb(mask, "kq_mask_rel_pos", il);
+    return mask;
+}
