+        dst->ne[2] != 128 || input->ne[2] != 128 || ids->ne[1] != 128 ||
+        weights->ne[3] != 1 || input->ne[3] != 1 || ids->ne[2] != 1 || ids->ne[3] != 1 || dst->ne[3] != 1) {
