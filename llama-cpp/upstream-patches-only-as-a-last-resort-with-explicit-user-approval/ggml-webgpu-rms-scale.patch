diff --git a/ggml/src/ggml-webgpu/ggml-webgpu-rms-scale.hpp b/ggml/src/ggml-webgpu/ggml-webgpu-rms-scale.hpp
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/ggml-webgpu-rms-scale.hpp
@@ -0,0 +1,82 @@
+#pragma once
+#include "ggml-impl.h"
+#include <cstdint>
+
+struct rms_scale_plan {
+    ggml_tensor * source = nullptr;
+    ggml_tensor * rms = nullptr;
+    ggml_tensor * output = nullptr;
+    uint64_t source_bytes = 0;
+    uint64_t output_bytes = 0;
+    uint32_t elements = 0;
+    uint32_t rows = 0;
+};
+
+// Contiguous F32 rows, with checked ordered, nonoverlapping higher strides.
+// Source views may retain padding between heads, tokens and sequences.
+inline bool rms_scale_layout(const ggml_tensor * tensor, bool dense, uint64_t & span,
+                             uint32_t & elements, uint32_t & rows) {
+    span = elements = rows = 0;
+    if (!tensor || tensor->type != GGML_TYPE_F32 || tensor->nb[0] != 4 ||
+        tensor->ne[0] <= 0 || tensor->ne[0] > UINT32_MAX - 127u) { return false; }
+    constexpr uint64_t max_bytes = uint64_t(UINT32_MAX) * 4;
+    uint64_t count = uint64_t(tensor->ne[0]);
+    uint64_t bytes = count * 4;
+    for (int axis = 1; axis < GGML_MAX_DIMS; ++axis) {
+        const uint64_t stride = tensor->nb[axis];
+        if (tensor->ne[axis] <= 0 || uint64_t(tensor->ne[axis]) > UINT32_MAX ||
+            stride % 4 || stride < bytes || stride > max_bytes ||
+            (dense && stride != count * 4) || uint64_t(tensor->ne[axis]) > UINT32_MAX / count) { return false; }
+        const uint64_t extra_rows = uint64_t(tensor->ne[axis]) - 1;
+        if (extra_rows > (max_bytes - bytes) / stride) { return false; }
+        bytes += extra_rows * stride;
+        count *= uint64_t(tensor->ne[axis]);
+    }
+    span = bytes; elements = uint32_t(count); rows = uint32_t(count / uint64_t(tensor->ne[0]));
+    return true;
+}
+
+inline bool plan_rms_scale(const ggml_cgraph * graph, int index, rms_scale_plan & plan) {
+    plan = {};
+    if (!graph || index < 0 || index >= graph->n_nodes || graph->n_nodes - index < 2 ||
+        !ggml_can_fuse(graph, index, { GGML_OP_RMS_NORM, GGML_OP_SCALE })) { return false; }
+    auto * rms = graph->nodes[index];
+    auto * output = graph->nodes[index + 1];
+    auto * source = rms->src[0];
+    if (!source || rms->view_src || output->view_src || output->src[0] != rms ||
+        !ggml_are_same_shape(source, rms) || !ggml_are_same_shape(rms, output)) { return false; }
+    for (auto * node : { rms, output }) {
+        for (int s = 1; s < GGML_MAX_SRC; ++s) { if (node->src[s]) { return false; } }
+    }
+    if (source->view_src && (source->view_src == source || source->view_src->view_src ||
+                            source->view_src->type != GGML_TYPE_F32)) { return false; }
+    uint64_t source_bytes, rms_bytes, output_bytes;
+    uint32_t elements, rows, rms_elements, rms_rows, output_elements, output_rows;
+    if (!rms_scale_layout(source, false, source_bytes, elements, rows) ||
+        !rms_scale_layout(rms, true, rms_bytes, rms_elements, rms_rows) ||
+        !rms_scale_layout(output, true, output_bytes, output_elements, output_rows) ||
+        elements != rms_elements || elements != output_elements || rows != rms_rows || rows != output_rows) { return false; }
+    plan = { source, rms, output, source_bytes, output_bytes, elements, rows };
+    return true;
+}
+
+inline bool rms_scale_same_mapping(const ggml_tensor * a, const ggml_tensor * b) {
+    if (!ggml_are_same_shape(a, b)) { return false; }
+    for (int axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+        if ((axis == 0 || a->ne[axis] > 1) && a->nb[axis] != b->nb[axis]) { return false; }
+    }
+    return true;
+}
+
+inline bool rms_scale_disjoint(uint64_t a, uint64_t an, uint64_t b, uint64_t bn) {
+    return an && bn && (a <= b ? an <= b - a : bn <= a - b);
+}
+
+inline bool rms_scale_grid(uint64_t rows, uint32_t limit, uint32_t & x, uint32_t & y) {
+    x = y = 0;
+    if (!rows || rows > UINT32_MAX || !limit) { return false; }
+    const uint64_t gy = (rows + limit - 1) / limit;
+    const uint64_t gx = (rows + gy - 1) / gy;
+    if (gx > limit || gy > limit || gx * gy > UINT32_MAX) { return false; }
+    x = uint32_t(gx); y = uint32_t(gy); return true;
+}
