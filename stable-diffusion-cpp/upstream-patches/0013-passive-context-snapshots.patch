+ModelManager::MemoryInfo ModelManager::memory_info() const {
+    MemoryInfo result;
+    auto add = [&](uint64_t& total, uint64_t value) {
+        if (value > UINT64_MAX - total) {
+            total = UINT64_MAX;
+            result.saturated = true;
+        } else {
+            total += value;
+        }
+    };
+    std::unordered_set<const ggml_tensor*> tensors;
+    for (const auto& state : tensor_states_) {
+        if (state && state->tensor && tensors.insert(state->tensor).second) {
+            add(result.registered_tensor_count, 1);
+            add(result.registered_tensor_bytes, ggml_nbytes(state->tensor));
+        }
+    }
+    std::unordered_set<ggml_backend_buffer_t> buffers;
+    auto add_buffer = [&](ggml_backend_buffer_t buffer) {
+        if (buffer == nullptr || !buffers.insert(buffer).second) return;
+        const bool host = ggml_backend_buffer_is_host(buffer);
+        add(host ? result.manager_host_buffer_count : result.manager_device_buffer_count, 1);
+        add(host ? result.manager_host_buffer_bytes : result.manager_device_buffer_bytes,
+            ggml_backend_buffer_get_size(buffer));
+    };
+    for (auto buffer : model_loader_.get_device_mmap_buffers()) add_buffer(buffer);
+    for (const auto& block : params_storage_blocks_) {
+        if (!block) continue;
+        add_buffer(block->buffer);
+        for (const auto& store : block->mmap_tensor_stores) add_buffer(store.mmbuffer.get());
+    }
+    for (const auto& block : compute_staging_blocks_) {
+        if (block) add_buffer(block->buffer);
+    }
+    for (const auto& entry : prefetch_blocks_) {
+        if (!entry.second) continue;
+        for (const auto& block : entry.second->staging_blocks) {
+            if (block) add_buffer(block->buffer);
+        }
+    }
+    // Existing runner publications: no runner traversal or forced synchronization.
+    for (const auto& entry : runtime_residencies_) {
+        auto backend = entry.second.compute_backend;
+        auto device = backend ? ggml_backend_get_device(backend) : nullptr;
+        auto& bytes = device == nullptr ? result.tracked_runtime_unknown_bytes
+                    : ggml_backend_dev_type(device) == GGML_BACKEND_DEVICE_TYPE_CPU
+                        ? result.tracked_runtime_cpu_bytes : result.tracked_runtime_non_cpu_bytes;
+        add(bytes, entry.second.resident_bytes);
+    }
+    return result;
+}
