diff --git a/ggml/src/ggml-webgpu/ggml-webgpu-short-conv-residual.hpp b/ggml/src/ggml-webgpu/ggml-webgpu-short-conv-residual.hpp
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/ggml-webgpu-short-conv-residual.hpp
@@ -0,0 +1,61 @@
+#pragma once
+
+#include "ggml-impl.h"
+
+struct short_conv_residual_plan {
+    const ggml_tensor * history;
+    const ggml_tensor * weights;
+    const ggml_tensor * residual;
+    const ggml_tensor * output;
+};
+
+// Binding validation is separate. A logical match cannot authorize overlap between
+// different channels or a mutable input and the output. One exact same-range
+// residual/output mapping is safe because each invocation uses its own channel.
+inline bool plan_short_conv_residual(const ggml_cgraph * graph, int index, short_conv_residual_plan & plan) {
+    constexpr ggml_op ops[] = {GGML_OP_SSM_CONV, GGML_OP_RESHAPE, GGML_OP_ADD, GGML_OP_SCALE};
+    if (!graph || index < 0 || index > graph->n_nodes - 4) {
+        return false;
+    }
+    const auto * conv = graph->nodes[index];
+    const auto * flat = graph->nodes[index + 1];
+    const auto * add = graph->nodes[index + 2];
+    const auto * output = graph->nodes[index + 3];
+    if (conv->op != ops[0] || flat->op != ops[1] || add->op != ops[2] || output->op != ops[3] ||
+        flat->src[0] != conv || flat->view_src != conv || flat->view_offs || add->src[1] != flat || output->src[0] != add) {
+        return false;
+    }
+    const auto * history = conv->src[0];
+    const auto * weights = conv->src[1];
+    const auto * residual = add->src[0];
+    if (!history || !weights || !residual || conv->view_src || add->view_src || output->view_src) {
+        return false;
+    }
+    const auto channels = conv->ne[0];
+    if (channels <= 0 || channels > UINT32_MAX / 4) {
+        return false;
+    }
+    if (history->ne[0] != 4 || weights->ne[0] != 4 || history->ne[1] != channels || weights->ne[1] != channels) {
+        return false;
+    }
+    for (const auto * tensor : {conv, flat, residual, add, output}) {
+        if (tensor->ne[0] != channels || tensor->ne[1] != 1) {
+            return false;
+        }
+    }
+    for (const auto * tensor : {history, weights, conv, flat, residual, add, output}) {
+        if (tensor->type != GGML_TYPE_F32 || tensor->ne[2] != 1 || tensor->ne[3] != 1 || !ggml_is_contiguous(tensor)) {
+            return false;
+        }
+    }
+    // The residual is a fully external operand, including its underlying view source.
+    if (residual == conv || residual == flat || residual->view_src == conv || residual->view_src == flat) {
+        return false;
+    }
+    const int outputs[] = {index + 3};
+    if (!ggml_can_fuse_subgraph(graph, index, 4, ops, outputs, 1)) {
+        return false;
+    }
+    plan = {history, weights, residual, output};
+    return true;
+}
diff --git a/ggml/src/ggml-webgpu/ggml-webgpu-short-conv-state.hpp b/ggml/src/ggml-webgpu/ggml-webgpu-short-conv-state.hpp
