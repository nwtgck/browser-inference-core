index 0000000000000000000000000000000000000000..b8a68559717d1c343c72d130d1c7bd3c4a8547a9
--- /dev/null
+++ b/ggml/src/ggml-webgpu/ggml-webgpu-hc.hpp
@@ -0,0 +1,90 @@
+#pragma once
+#include "ggml.h"
+#include <cstdint>
+#include <cstring>
+
+struct ggml_webgpu_hc_limits {
+    uint64_t max_binding_size;
+    uint32_t storage_alignment;
+    uint32_t max_workgroups;
+    uint32_t max_invocations;
+    uint32_t max_workgroup_x;
+    uint32_t max_storage_buffers;
+};
+
+static bool ggml_webgpu_hc_tensor_supported(const ggml_tensor * t, const ggml_webgpu_hc_limits & limits) {
+    if (!t || t->type != GGML_TYPE_F32 || !limits.storage_alignment ||
+        limits.storage_alignment % 4 || (limits.storage_alignment & (limits.storage_alignment - 1))) {
+        return false;
+    }
+    uint64_t size = 4;
+    for (int i = 0; i < 4; ++i) {
+        if (t->ne[i] <= 0 || uint64_t(t->ne[i]) > UINT32_MAX || t->nb[i] != size ||
+            size > UINT32_MAX * uint64_t(4) / uint64_t(t->ne[i])) {
+            return false;
+        }
+        size *= uint64_t(t->ne[i]);
+    }
+    const uint64_t padding = uint64_t(limits.storage_alignment) - 1 + 3;
+    return size + padding <= limits.max_binding_size && (size + padding) / 4 <= UINT32_MAX;
+}
+
+static bool ggml_webgpu_hc_shape(const ggml_tensor * t, int64_t d, int64_t h, int64_t n, int64_t s) {
+    return t->ne[0] == d && t->ne[1] == h && t->ne[2] == n && t->ne[3] == s;
+}
+
+static bool ggml_webgpu_hc_supported(const ggml_tensor * op, const ggml_webgpu_hc_limits & limits) {
+    if (!op || limits.max_invocations < 64 || limits.max_workgroup_x < 64 || !limits.max_workgroups ||
+        !ggml_webgpu_hc_tensor_supported(op, limits)) {
+        return false;
+    }
+    for (int i = 4; i < GGML_MAX_SRC; ++i) {
+        if (op->src[i]) { return false; }
+    }
+    const ggml_tensor * x = op->src[0];
+    const ggml_tensor * y = op->src[1];
+    if (!ggml_webgpu_hc_tensor_supported(x, limits) || !ggml_webgpu_hc_tensor_supported(y, limits)) {
+        return false;
+    }
+    const int64_t d = x->ne[0];
+    if (op->op == GGML_OP_DSV4_HC_PRE) {
+        int32_t gated;
+        std::memcpy(&gated, reinterpret_cast<const char *>(op->op_params) + 4, sizeof(gated));
+        const int64_t t = x->ne[2];
+        if (gated != 1 || limits.max_storage_buffers < 3 || op->src[2] || op->src[3] ||
+            !ggml_webgpu_hc_shape(x, d, 4, t, 1) || !ggml_webgpu_hc_shape(y, d, 4, t, 1) ||
+            !ggml_webgpu_hc_shape(op, d, t, 1, 1)) {
+            return false;
+        }
+    } else if (op->op == GGML_OP_DSV4_HC_POST) {
+        const ggml_tensor * p = op->src[2];
+        const int64_t t = x->ne[1];
+        if (op->src[3] || limits.max_storage_buffers < 4 || !ggml_webgpu_hc_tensor_supported(p, limits) ||
+            !ggml_webgpu_hc_shape(x, d, t, 1, 1) || !ggml_webgpu_hc_shape(y, d, 4, t, 1) ||
+            !ggml_webgpu_hc_shape(p, 4, t, 1, 1) || !ggml_webgpu_hc_shape(op, d, 4, t, 1)) {
+            return false;
+        }
+    } else {
+        return false;
+    }
+    // Distinct live allocations are storage-aligned. Views of one root can
+    // still overlap after binding alignment, even when their values are disjoint.
+    // No merged-binding shader is provided: reject those graphs before placement
+    // so the existing upstream fusion probe keeps its staged implementation.
+    const ggml_tensor * tensors[] = { op, x, y, op->src[2] };
+    const int tensor_count = op->op == GGML_OP_DSV4_HC_PRE ? 3 : 4;
+    for (int i = 0; i < tensor_count; ++i) {
+        const ggml_tensor * a = tensors[i]->view_src ? tensors[i]->view_src : tensors[i];
+        for (int j = 0; j < i; ++j) {
+            const ggml_tensor * b = tensors[j]->view_src ? tensors[j]->view_src : tensors[j];
+            if (a == b) {
+                return false;
+            }
+        }
+    }
+    const uint64_t count = op->nb[3] / 4;
+    const uint64_t groups = (count + 63) / 64;
+    // Include the padded last row of the two-dimensional launch in u32 indexing.
+    return groups <= uint64_t(limits.max_workgroups) * limits.max_workgroups &&
+           groups + limits.max_workgroups - 1 <= UINT32_MAX / 64;
+}
