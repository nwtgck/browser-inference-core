diff --git a/ggml/src/ggml-webgpu/ggml-webgpu-short-conv-dynamic.hpp b/ggml/src/ggml-webgpu/ggml-webgpu-short-conv-dynamic.hpp
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/ggml-webgpu-short-conv-dynamic.hpp
@@ -0,0 +1,132 @@
+#pragma once
+
+#include "ggml-webgpu-fusion-view-sources.hpp"
+
+namespace webgpu_short_conv_dynamic {
+
+constexpr int nodes = 29;
+
+struct plan {
+    const ggml_tensor * history;
+    const ggml_tensor * taps;
+    const ggml_tensor * convolution;
+    const ggml_tensor * residual;
+    ggml_tensor * output;
+    uint32_t channels_per_head;
+};
+
+inline bool dense(const ggml_tensor * tensor, int64_t columns, int64_t rows) {
+    return tensor && tensor->type == GGML_TYPE_F32 && tensor->ne[0] == columns && tensor->ne[1] == rows &&
+           tensor->ne[2] == 1 && tensor->ne[3] == 1 && ggml_is_contiguous(tensor);
+}
+
+inline bool reshape(const ggml_tensor * tensor, const ggml_tensor * source, int64_t columns, int64_t rows) {
+    return dense(tensor, columns, rows) && tensor->op == GGML_OP_RESHAPE && tensor->src[0] == source &&
+           tensor->view_src == source && !tensor->view_offs;
+}
+
+// The first tap projection can be scheduled after SSM_CONV. Keep that producer
+// and the first window copy; fuse only the ordered four-tap residual suffix.
+inline bool match(const ggml_cgraph & graph, int first, webgpu_fusion_view_sources & views, plan & result) {
+    if (first < 0 || first > graph.n_nodes - nodes) { return false; }
+    auto * const * n = graph.nodes + first;
+    if (n[1]->op != GGML_OP_RESHAPE || n[2]->op != GGML_OP_ADD || n[nodes - 1]->op != GGML_OP_SCALE) {
+        return false;
+    }
+    const auto * initial_mul = n[0];
+    const int64_t width = initial_mul->ne[0];
+    const int64_t heads = initial_mul->ne[1];
+    if (initial_mul->op != GGML_OP_MUL || width <= 0 || heads <= 0 ||
+        width > UINT32_MAX / 16u || uint64_t(heads) > UINT32_MAX / (16u * uint64_t(width))) { return false; }
+    const int64_t channels = width * heads;
+    const auto * first_window = initial_mul->src[0];
+    const auto * first_tap = initial_mul->src[1];
+    const auto * taps = first_tap ? first_tap->src[0] : nullptr;
+    if (!taps || !dense(taps, 4, heads) || taps->op != GGML_OP_RESHAPE || taps->view_offs ||
+        taps->view_src != taps->src[0] || !dense(taps->src[0], 4 * heads, 1) || taps->src[0]->view_src) {
+        return false;
+    }
+    const auto * copy = first_window ? first_window->src[0] : nullptr;
+    const auto * transpose = copy ? copy->src[0] : nullptr;
+    const auto * window = transpose ? transpose->src[0] : nullptr;
+    const auto * history = window ? window->src[0] : nullptr;
+    if (!dense(history, 4, channels) || history->view_src) { return false; }
+    const auto * initial = n[2]->src[0];
+    const auto * convolution = initial ? initial->src[0] : nullptr;
+    if (!dense(convolution, channels, 1) || convolution->op != GGML_OP_SSM_CONV || convolution->view_src ||
+        convolution->src[0] != history || !reshape(initial, convolution, channels, 1)) { return false; }
+
+    int indices[20];
+    ggml_op ops[20];
+    int count = 0;
+    const auto include = [&](int relative) {
+        indices[count] = first + relative;
+        ops[count++] = n[relative]->op;
+    };
+    const ggml_tensor * previous = initial;
+    for (int lag = 0; lag < 4; ++lag) {
+        const int at = 8 * lag;
+        const auto * mul = n[at];
+        const auto * term = n[at + 1];
+        const auto * sum = n[at + 2];
+        const auto * shape = mul->src[0];
+        const auto * tap = mul->src[1];
+        const auto * cont = shape ? shape->src[0] : nullptr;
+        const auto * trans = cont ? cont->src[0] : nullptr;
+        const auto * view = trans ? trans->src[0] : nullptr;
+        if (!dense(mul, width, heads) || mul->op != GGML_OP_MUL || mul->view_src ||
+            !reshape(term, mul, channels, 1) || !dense(sum, channels, 1) || sum->op != GGML_OP_ADD ||
+            sum->view_src || sum->src[0] != previous || sum->src[1] != term ||
+            !reshape(shape, cont, width, heads) || !dense(cont, channels, 1) || cont->op != GGML_OP_CONT ||
+            cont->view_src || !trans || trans->op != GGML_OP_TRANSPOSE || trans->src[0] != view ||
+            !view || view->op != GGML_OP_VIEW || view->src[0] != history || view->view_src != history ||
+            view->view_offs != uint64_t(3 - lag) * sizeof(float) || view->type != GGML_TYPE_F32 ||
+            view->ne[0] != 1 || view->ne[1] != channels || view->ne[2] != 1 || view->ne[3] != 1 ||
+            view->nb[0] != 4 || view->nb[1] != 16 || view->nb[2] != uint64_t(channels) * 16 ||
+            view->nb[3] != view->nb[2] || trans->view_src != history || trans->view_offs != view->view_offs ||
+            trans->type != GGML_TYPE_F32 || trans->ne[0] != channels || trans->ne[1] != 1 ||
+            trans->ne[2] != 1 || trans->ne[3] != 1 || trans->nb[0] != 16 || trans->nb[1] != 4 ||
+            trans->nb[2] != view->nb[2] || trans->nb[3] != view->nb[3] ||
+            !tap || tap->op != GGML_OP_VIEW || tap->src[0] != taps || tap->view_src != taps->src[0] ||
+            tap->view_offs != uint64_t(lag) * sizeof(float) || tap->type != GGML_TYPE_F32 ||
+            tap->ne[0] != 1 || tap->ne[1] != heads || tap->ne[2] != 1 || tap->ne[3] != 1 ||
+            tap->nb[0] != 4 || tap->nb[1] != 16 || tap->nb[2] != uint64_t(heads) * 16 ||
+            tap->nb[3] != tap->nb[2]) { return false; }
+        if (lag) {
+            if (n[at - 5] != view || n[at - 4] != trans || n[at - 3] != cont ||
+                n[at - 2] != shape || n[at - 1] != tap) { return false; }
+            include(at - 3);
+            include(at - 2);
+        }
+        include(at);
+        include(at + 1);
+        include(at + 2);
+        previous = sum;
+    }
+    auto * add = n[27];
+    auto * output = n[28];
+    const auto * residual = add->src[0];
+    if (!dense(residual, channels, 1) || !dense(add, channels, 1) || add->op != GGML_OP_ADD || add->view_src ||
+        add->src[1] != previous || !dense(output, channels, 1) || output->op != GGML_OP_SCALE ||
+        output->src[0] != add || output->view_src) { return false; }
+    include(27);
+    include(28);
+    GGML_ASSERT(count == 20);
+    // Borrowed history/tap views remain valid: their inputs are retained and
+    // cannot overlap the output. Only materialized nodes and their own reshapes
+    // are discarded; use the shared closure and raw-view observer checks.
+    if (!ggml_can_fuse_subgraph_ext(&graph, indices, count, ops, indices + count - 1, 1)) { return false; }
+    for (int i = 0; i < count - 1; ++i) {
+        if (views.contains(graph.nodes[indices[i]])) { return false; }
+    }
+    const ggml_tensor * inputs[] = {history, taps->src[0], convolution, residual};
+    for (const auto * input : inputs) {
+        for (int i = 0; i < nodes; ++i) {
+            if (input == n[i] || input->view_src == n[i]) { return false; }
+        }
+    }
+    result = {history, taps->src[0], convolution, residual, output, uint32_t(width)};
+    return true;
+}
+
+} // namespace webgpu_short_conv_dynamic
