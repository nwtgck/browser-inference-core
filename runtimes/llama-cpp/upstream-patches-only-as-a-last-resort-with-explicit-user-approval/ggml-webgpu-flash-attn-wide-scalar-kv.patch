+inline uint32_t ggml_webgpu_flash_attn_wider_scalar_kv_tile(
+        const ggml_webgpu_shader_lib_context & context,
+        const ggml_webgpu_flash_attn_decisions & decisions,
+        const ggml_webgpu_flash_attn_pipeline_key & key) {
+    if (decisions.use_sg_matrix || key.common.kv_overlap || key.common.q_type != GGML_TYPE_F32 ||
+        key.common.k_type != GGML_TYPE_F16 || key.common.v_type != GGML_TYPE_F16 ||
+        key.common.head_dim_qk != key.common.head_dim_v ||
+        (key.common.head_dim_qk != 128 && key.common.head_dim_qk != 256 && key.common.head_dim_qk != 512) ||
+        context.src0->ne[1] < 32 || context.src1->ne[1] < 768 || context.wg_mem_limit_bytes < 32768) {
+        return decisions.kv_tile;
+    }
+    const auto shared_bytes = [&](uint32_t kv_tile) {
+        return ggml_webgpu_flash_attn_scalar_tile_shared_bytes(
+            decisions.q_tile, kv_tile, key.common.head_dim_qk, key.common.head_dim_v, key.skip_masked_tiles);
+    };
+    const size_t fixed = shared_bytes(0);
+    if (context.wg_mem_limit_bytes <= fixed) {
+        return decisions.kv_tile;
+    }
+    // Bound the search with unrounded per-row storage, then validate the complete variables.
+    const size_t bytes_per_row = (size_t(key.common.head_dim_qk) + decisions.q_tile) * sizeof(uint16_t);
+    const size_t available_rows = (context.wg_mem_limit_bytes - fixed) / bytes_per_row;
+    auto kv_tile = uint32_t(std::min<size_t>(GGML_WEBGPU_FLASH_ATTN_TILE_MAX_KV_TILE, available_rows));
+    while (kv_tile > decisions.kv_tile && shared_bytes(kv_tile) > context.wg_mem_limit_bytes) {
+        --kv_tile;
+    }
+    return std::max(decisions.kv_tile, kv_tile);
+}
