+struct buffer_facts {
+    WGPUBuffer handle = nullptr;
+    uint64_t size = 0;
+    bool storage = false;
+};
+
+template<size_t N>
+static bool get_binding(webgpu_context & ctx, const ggml_tensor * tensor,
+                        std::array<buffer_facts, N> & facts, binding & result) {
+    const auto * buffer = tensor->buffer;
+    if (!buffer || !buffer->context || buffer->iface.get_base != ggml_backend_webgpu_buffer_get_base ||
+        !tensor->data) {
+        return false;
+    }
+    const auto * buffer_ctx = static_cast<const ggml_backend_webgpu_buffer_context *>(buffer->context);
+    if (buffer_ctx->global_ctx != ctx->global_ctx || !buffer_ctx->buffer) {
+        return false;
+    }
+
+    const auto * root = tensor->view_src ? tensor->view_src : tensor;
+    uint64_t bytes, root_bytes;
+    const auto base = reinterpret_cast<uintptr_t>(webgpu_ptr_base);
+    const auto root_data = reinterpret_cast<uintptr_t>(root->data);
+    if (root->view_src || root->view_offs || root->type != tensor->type || root->buffer != buffer ||
+        root_data < base || tensor->view_offs > UINTPTR_MAX - root_data ||
+        reinterpret_cast<uintptr_t>(tensor->data) != root_data + tensor->view_offs ||
+        !packed_bytes(tensor, bytes)) {
+        return false;
+    }
+    if (root != tensor && (!packed_bytes(root, root_bytes) || tensor->view_offs > root_bytes ||
+        bytes > root_bytes - tensor->view_offs)) {
+        return false;
+    }
+
+    const uint64_t payload = root_data - base + tensor->view_offs;
+    const uint64_t unit = ggml_type_size(tensor->type);
+    const auto & limits = ctx->global_ctx->capabilities.limits;
+    const uint64_t alignment = limits.minStorageBufferOffsetAlignment;
+    if (alignment < 4 || (alignment & (alignment - 1)) || payload % 4 != 0) {
+        return false;
+    }
+    // Match ordinary quantized matvec's block-aligned rebase, with a checked
+    // underflow path for a tensor offset which cannot be expressed in blocks.
+    uint64_t offset = payload & ~(alignment - 1);
+    while ((payload - offset) % unit != 0) {
+        if (offset < alignment) {
+            return false;
+        }
+        offset -= alignment;
+    }
+    const uint64_t prefix = payload - offset;
+    if (prefix > UINT32_MAX - bytes) {
+        return false;
+    }
+    const uint64_t size = prefix + bytes;
+    if (size % 4 || size > limits.maxStorageBufferBindingSize || offset > buffer->size || size > buffer->size - offset) {
+        return false;
+    }
+
+    const auto handle = buffer_ctx->buffer.Get();
+    auto found = std::find_if(facts.begin(), facts.end(), [handle](const buffer_facts & fact) {
+        return !fact.handle || fact.handle == handle;
+    });
+    if (found == facts.end()) {
+        return false;
+    }
+    if (!found->handle) {
+        *found = {handle, buffer_ctx->buffer.GetSize(),
+            (buffer_ctx->buffer.GetUsage() & wgpu::BufferUsage::Storage) != wgpu::BufferUsage::None};
+    }
+    if (!found->storage || offset > found->size || size > found->size - offset) {
+        return false;
+    }
+    result = {buffer_ctx->buffer, offset, size, uint32_t(prefix / unit)};
+    return true;
+}
+
+static bool bindings_overlap(const binding & first, const binding & second) {
+    // The binding ranges include the payload. Reject overlap by physical
+    // handle even when the ggml buffer wrappers are distinct.
+    return first.buffer.Get() == second.buffer.Get() &&
+        first.offset < second.offset + second.size && second.offset < first.offset + first.size;
+}
+
+}  // namespace webgpu_checked_tensor_binding
