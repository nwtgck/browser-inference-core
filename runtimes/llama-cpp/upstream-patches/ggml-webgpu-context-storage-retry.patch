+static bool ggml_webgpu_drain_context_storage(ggml_backend_dev_t dev) {
+    auto * ctx = static_cast<ggml_backend_webgpu_device_context *>(dev->context);
+    auto & global = *ctx->webgpu_global_ctx;
+    auto & control = global.optional_device->control;
+    if (!control.healthy()) {
+        return false;
+    }
+    struct completion {
+        std::atomic<bool> done{false};
+        wgpu::QueueWorkDoneStatus status = wgpu::QueueWorkDoneStatus::Error;
+    };
+    using ticket = std::shared_ptr<completion>;
+    try {
+        const auto state = std::make_shared<completion>();
+        // The callback owns its ticket even if the future does not complete
+        // during this wait. Never hand WebGPU a pointer into the caller stack.
+        auto callback = [](wgpu::QueueWorkDoneStatus status, wgpu::StringView, ticket * pending) noexcept {
+            const std::unique_ptr<ticket> owner(pending);
+            (*owner)->status = status;
+            (*owner)->done.store(true, std::memory_order_release);
+        };
+        const auto future = global.queue.OnSubmittedWorkDone(
+            wgpu::CallbackMode::WaitAnyOnly, callback, new ticket(state));
+        if (future.id && global.instance.WaitAny(future, WEBGPU_RUNTIME_WAIT_TIMEOUT_NS) == wgpu::WaitStatus::Success &&
+            state->done.load(std::memory_order_acquire) && state->status == wgpu::QueueWorkDoneStatus::Success &&
+            control.healthy()) {
+            return true;
+        }
+    } catch (...) {
+        // A failed or indeterminate wait cannot certify memory for reload.
+    }
+    control.terminal.store(true, std::memory_order_release);
+    return false;
