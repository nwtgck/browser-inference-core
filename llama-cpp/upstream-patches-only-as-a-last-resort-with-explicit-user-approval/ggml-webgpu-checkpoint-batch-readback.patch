+#pragma once
+#include "ggml-backend.h"
+
+#define GGML_BACKEND_TENSOR_GET_BATCH_V1 "ggml_backend_try_tensor_get_batch_v1"
+#define GGML_BACKEND_TENSOR_GET_BATCH_V1_MAX_REQUESTS 256
+#define GGML_BACKEND_TENSOR_GET_BATCH_V1_MAX_BYTES (4 * 1024 * 1024)
+
+// One shared definition for the host writer and provider. Callers retain all
+// descriptors, tensor/buffer metadata and destinations until the blocking call
+// returns. Metadata remains unchanged and cannot alias a destination.
+// Destinations may overlap each other; later requests win in order.
+struct ggml_backend_tensor_get_request_v1 {
+    const struct ggml_tensor * tensor;
+    void * data;
+    size_t offset;
+    size_t size;
+};
+
+// true: every requested byte is written and all mappings are released.
+// false: unsupported, before any enqueue/map/host write. Operational failures
+// keep the existing error behavior and must never be converted to false.
+// A request is never divided across maps. Requests too large for the provider
+// retain the ordinary single-request getter and its existing memory policy.
+typedef bool (*ggml_backend_try_tensor_get_batch_v1_t)(
+    const struct ggml_backend_tensor_get_request_v1 * requests, size_t count);
