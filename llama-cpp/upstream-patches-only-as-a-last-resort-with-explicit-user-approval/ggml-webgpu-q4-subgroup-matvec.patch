+// Shape and range admission is independent of the subgroup-width policy.
+// A later explicit-width caller must establish the same capability contract.
+inline bool ggml_webgpu_q4_matvec_subgroup_eligible(const ggml_webgpu_shader_lib_context & context,
+                                                  bool use_mmvq, bool src_overlap) {
+    const auto * a = context.src0;
+    const auto * x = context.src1;
+    const auto * dst = context.dst;
+    if (!a || !x || !dst || context.src2 || use_mmvq || src_overlap || context.max_wg_size < 128 ||
+        context.matvec_epilogue != ggml_webgpu_shader_lib_context::matvec_post_op::none ||
+        (a->type != GGML_TYPE_Q4_0 && a->type != GGML_TYPE_Q4_K) ||
+        x->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        a->ne[0] < 1024 || a->ne[0] > 4096 ||
+        a->ne[0] % (a->type == GGML_TYPE_Q4_0 ? 32 : 256) != 0 ||
+        a->ne[1] < 4096 || a->ne[1] > UINT32_MAX - 127u ||
+        x->ne[0] != a->ne[0] || dst->ne[0] != a->ne[1] || x->ne[1] != 1 || dst->ne[1] != 1) {
+        return false;
+    }
+    uint64_t output_elements = static_cast<uint64_t>(dst->ne[0]);
+    for (int axis = 2; axis < 4; ++axis) {
+        if (a->ne[axis] <= 0 || a->ne[axis] > UINT32_MAX ||
+            x->ne[axis] <= 0 || x->ne[axis] > UINT32_MAX ||
+            dst->ne[axis] != x->ne[axis] || x->ne[axis] % a->ne[axis] != 0 ||
+            static_cast<uint64_t>(x->ne[axis]) > UINT32_MAX / output_elements) {
+            return false;
+        }
+        output_elements *= static_cast<uint64_t>(x->ne[axis]);
+    }
+    return true;
+}
+
+// Reuse four-row independent subgroups only for a fixed advertised width.
+// The unchanged accumulator requires at least sixteen lanes for Q4_K blocks.
+inline uint32_t ggml_webgpu_q4_matvec_subgroup_size(const ggml_webgpu_shader_lib_context & context,
+                                                  bool use_mmvq, bool src_overlap) {
+    const uint32_t sg = context.min_subgroup_size;
+    if (!context.supports_subgroups || sg != context.max_subgroup_size || (sg != 16 && sg != 32)) {
+        return 0;
+    }
+    return ggml_webgpu_q4_matvec_subgroup_eligible(context, use_mmvq, src_overlap) ? sg : 0;
 }
 
