+static bool relative_attention_cache_on_device(const ggml_tensor * cache, ggml_backend_dev_t device) {
+    const auto * root = cache->view_src ? cache->view_src : cache;
+    if (!root->buffer) {
+        return false;
+    }
+    const auto buffer_type = ggml_backend_buffer_get_type(root->buffer);
+    return ggml_backend_buft_get_device(buffer_type) == device &&
+           ggml_backend_dev_supports_buft(device, buffer_type);
+}
