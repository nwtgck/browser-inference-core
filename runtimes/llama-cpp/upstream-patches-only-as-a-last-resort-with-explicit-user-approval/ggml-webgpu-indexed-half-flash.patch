+static bool ggml_webgpu_flash_supports_indexed_half_bias(const webgpu_global_context & global,
+                                                          const ggml_tensor * node) {
+    const auto * q = node->src[0];
+    const auto * k = node->src[1];
+    const auto * v = node->src[2];
+    const auto * mask = node->src[3];
+    const auto * sinks = node->src[4];
+    const auto * table = node->src[6];
+    const auto * ids = node->src[7];
+    if (!q || !k || !v || !mask || !table || !ids ||
+        q->type != GGML_TYPE_F32 || k->type != GGML_TYPE_F16 || v->type != GGML_TYPE_F16 ||
+        node->type != GGML_TYPE_F32 || mask->type != GGML_TYPE_F16 ||
+        table->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32 || node->src[5] ||
+        q->ne[1] < 1 ||
+        q->ne[1] > UINT32_MAX || q->ne[2] < 1 || q->ne[2] > UINT32_MAX ||
+        q->ne[3] < 1 || q->ne[3] > UINT32_MAX || k->ne[1] < 1 || k->ne[1] > UINT32_MAX ||
+        q->ne[1] > UINT32_MAX / q->ne[3] || table->ne[0] < 1 || table->ne[0] > UINT32_MAX) {
+        return false;
+    }
+    const int64_t queries = q->ne[1] * q->ne[3];
+    if (mask->ne[0] != k->ne[1] || mask->ne[1] != q->ne[1] || mask->ne[2] != 1 || mask->ne[3] != q->ne[3] ||
+        table->ne[1] != q->ne[2] || table->ne[2] != queries || table->ne[3] != 1 ||
+        ids->ne[0] != k->ne[1] || ids->ne[1] != queries || !ggml_is_matrix(ids) ||
+        !ggml_is_contiguous(mask) || !ggml_is_contiguous(table) || !ggml_is_contiguous(ids) ||
+        (sinks && (sinks->type != GGML_TYPE_F32 || !ggml_is_contiguous(sinks) || ggml_nelements(sinks) != q->ne[2]))) {
+        return false;
+    }
+    const auto & caps = global->capabilities;
+    const auto & limits = caps.limits;
+    const uint64_t head_groups = 1 + (q->ne[1] - 1) / GGML_WEBGPU_FLASH_ATTN_TILE_Q_TILE;
+    const uint64_t count_per_stream = head_groups * uint64_t(q->ne[2]);
+    if (!caps.supports_subgroups || caps.min_subgroup_size == 0 ||
+        caps.max_subgroup_size < caps.min_subgroup_size ||
+        limits.maxStorageBuffersPerShaderStage < (sinks ? 8u : 7u) ||
+        limits.maxBindingsPerBindGroup < (sinks ? 9u : 8u) || limits.maxUniformBuffersPerShaderStage < 1 ||
+        limits.maxUniformBufferBindingSize < WEBGPU_PARAMS_BUF_SIZE_BYTES ||
+        limits.minStorageBufferOffsetAlignment < 4u ||
+        count_per_stream > limits.maxComputeWorkgroupsPerDimension / uint64_t(q->ne[3])) {
+        return false;
+    }
+    const auto wg = std::min<uint64_t>(limits.maxComputeInvocationsPerWorkgroup,
+        std::max<uint64_t>(GGML_WEBGPU_FLASH_ATTN_PREFERRED_WG_SIZE,
+                           GGML_WEBGPU_FLASH_ATTN_TILE_Q_TILE * uint64_t(caps.max_subgroup_size)));
+    if (wg > limits.maxComputeWorkgroupSizeX ||
+        wg < GGML_WEBGPU_FLASH_ATTN_TILE_Q_TILE * uint64_t(caps.max_subgroup_size)) {
+        return false;
+    }
+    for (const auto * t : {q, k, v, mask, sinks, node, ids, table}) {
+        if (!t) {
+            continue;
+        }
+        const uint64_t bytes = ggml_nbytes(t);
+        const uint64_t maximum = std::min<uint64_t>(UINT32_MAX,
+            std::min(limits.maxStorageBufferBindingSize, limits.maxBufferSize));
+        const uint64_t alignment = limits.minStorageBufferOffsetAlignment;
+        const uint64_t prefix = t->buffer ? ggml_webgpu_tensor_misalignment(t, alignment) : t->view_offs % alignment;
+        if (!bytes || bytes > maximum || prefix > maximum - bytes ||
+            ROUNDUP_POW2(bytes + prefix, WEBGPU_STORAGE_BUF_BINDING_MULT) > maximum) {
+            return false;
+        }
+    }
+    const auto reserve_queries = std::min<int64_t>(q->ne[1], GGML_WEBGPU_FLASH_ATTN_VEC_MAX_SEQ_LEN - 1);
+    if (ggml_webgpu_flash_attn_use_vec_path(global, q, k, v, reserve_queries)) {
+        const auto layout = ggml_webgpu_flash_indexed_vec_layout(global, node, reserve_queries);
+        if (!layout || !ggml_webgpu_flash_indexed_vec_resident(global, node, *layout)) {
+            return false;
+        }
+    }
+    // Before allocation roots have no physical regions. Once assigned, accept
+    // only the nonoverlapping storage regions produced by the normal allocator.
+    for (const auto * input : {mask, table, ids}) {
+        for (const auto * other : {q, k, v, sinks, node, mask, table, ids}) {
+            if (other && input != other && input->buffer && other->buffer &&
+                ggml_webgpu_tensor_binding_overlap(global, input, other)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
