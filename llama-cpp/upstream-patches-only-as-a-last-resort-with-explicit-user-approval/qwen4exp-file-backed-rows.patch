 void llama_model_save_to_file(const struct llama_model * model, const char * path_model) {
+    // The PLE table is deliberately absent from resident tensor enumeration.
+    // Refuse export before opening the destination rather than omit its weights.
+    if (lcb_qwen4exp_file_backed_shard(model) >= 0) {
+        throw std::runtime_error("file-backed rows: model export requires resident weights");
+    }
     llama_model_saver ms(model);
     ms.add_kv_from_model();
     ms.add_tensors_from_model();
