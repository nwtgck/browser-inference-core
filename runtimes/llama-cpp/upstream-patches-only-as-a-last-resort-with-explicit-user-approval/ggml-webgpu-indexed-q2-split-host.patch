+static uint64_t ggml_webgpu_q2_buffer_limit(const wgpu::Limits & limits) {
+    return sizeof(size_t) < sizeof(uint64_t) ?
+        std::min<uint64_t>(limits.maxBufferSize, SIZE_MAX / 2) : limits.maxBufferSize;
+}
+
+static std::optional<webgpu_q2_weight_windows> ggml_webgpu_q2_weight_windows(
+        const ggml_tensor * weight, const wgpu::Limits & limits) {
+    if (weight->type != GGML_TYPE_Q2_0 || weight->view_src || weight->ne[0] <= 0 ||
+        weight->ne[0] % ggml_blck_size(weight->type) || weight->ne[1] <= 0 || weight->ne[2] <= 0 ||
+        weight->ne[3] != 1 || !ggml_is_contiguous(weight)) {
+        return {};
+    }
+
+    // Check in u64 before calling the regular size helpers, including on Wasm32.
+    const uint64_t alignment = limits.minStorageBufferOffsetAlignment;
+    const uint64_t storage_limit = std::min<uint64_t>(limits.maxStorageBufferBindingSize, UINT32_MAX) & ~UINT64_C(3);
+    const uint64_t bytes_per_expert = weight->nb[2];
+    const uint64_t experts = weight->ne[2];
+    if (alignment < 4 || (alignment & (alignment - 1)) || bytes_per_expert == 0 ||
+        experts > (UINT32_MAX - UINT64_C(3)) / bytes_per_expert) {
+        return {};
+    }
+    const uint64_t bytes = ROUNDUP_POW2(bytes_per_expert * experts, UINT64_C(4));
+    if (ROUNDUP_POW2(bytes, alignment) > ggml_webgpu_q2_buffer_limit(limits)) {
+        return {};
+    }
+    if (bytes <= storage_limit) {
+        return webgpu_q2_weight_windows{ bytes, 0 };
+    }
+
+    // Split only at an expert boundary that is also a legal storage offset.
+    const uint64_t first_min = CEIL_DIV(bytes - storage_limit, bytes_per_expert);
+    const uint64_t first_max = std::min(experts - 1, storage_limit / bytes_per_expert);
+    const uint64_t step = alignment / std::gcd(alignment, bytes_per_expert);
+    const uint64_t middle = CEIL_DIV(std::max(experts / 2, first_min), step) * step;
+    const uint64_t first_experts = std::min(middle, first_max / step * step);
+    if (first_experts < first_min) {
+        return {};
+    }
+    const uint64_t first = first_experts * bytes_per_expert;
+    return webgpu_q2_weight_windows{ first, bytes - first };
+}
+
+static bool ggml_webgpu_q2_weight_range_fits(const ggml_tensor * weight,
+                                             const wgpu::Limits & limits,
+                                             const webgpu_q2_weight_windows & windows) {
+    const uint64_t offset = ggml_webgpu_tensor_offset(weight);
+    const uint64_t size = ggml_webgpu_tensor_buf(weight).GetSize();
+    return offset % limits.minStorageBufferOffsetAlignment == 0 && offset <= size &&
+           windows.first + windows.second <= size - offset;
+}
+
+static std::optional<webgpu_q2_weight_windows> ggml_webgpu_q2_split_for_encoding(
+        const ggml_tensor * weight, const wgpu::Limits & limits) {
+    if (weight->type != GGML_TYPE_Q2_0 ||
+        ggml_nbytes(weight) <= (limits.maxStorageBufferBindingSize & ~UINT64_C(3))) {
+        return {};
+    }
+    const auto windows = ggml_webgpu_q2_weight_windows(weight, limits);
+    GGML_ASSERT(windows && windows->second && ggml_webgpu_q2_weight_range_fits(weight, limits, *windows));
+    return windows;
+}
+
+static void ggml_webgpu_bind_q2_high_range(const webgpu_q2_weight_windows & windows,
+                                           std::vector<uint32_t> & params,
+                                           std::vector<wgpu::BindGroupEntry> & bindings) {
+    auto & first = bindings.front();
+    GGML_ASSERT(params[0] == 0 && first.size == windows.first + windows.second);
+    for (size_t i = 1; i < bindings.size(); ++i) {
+        const auto & other = bindings[i];
+        if (first.buffer.Get() != other.buffer.Get()) {
+            continue;
+        }
+        GGML_ASSERT(first.offset < other.offset ? other.offset - first.offset >= first.size :
+                                                    first.offset - other.offset >= other.size);
+    }
+    first.size = windows.first;
+    bindings.push_back(ggml_webgpu_make_bind_group_entry(
+        uint32_t(bindings.size()), first.buffer, first.offset + windows.first, windows.second));
+    params.push_back(uint32_t(windows.first / sizeof(uint32_t)));
+}
