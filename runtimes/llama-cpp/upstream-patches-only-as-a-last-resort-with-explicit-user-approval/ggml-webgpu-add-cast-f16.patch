+#pragma once
+
+namespace webgpu_add_cast_f16 {
+
+static bool payloads_overlap(const webgpu_checked_tensor_binding::binding & a, uint64_t a_unit,
+                             const webgpu_checked_tensor_binding::binding & b, uint64_t b_unit) {
+    const uint64_t a_start = a.offset + uint64_t(a.element_offset) * a_unit;
+    const uint64_t b_start = b.offset + uint64_t(b.element_offset) * b_unit;
+    return a.buffer.Get() == b.buffer.Get() && a_start < b.offset + b.size && b_start < a.offset + a.size;
+}
+
+static bool has_other_readers(const ggml_cgraph & graph, webgpu_fusion_view_sources & views,
+                              const ggml_tensor * input) {
+    // The allocator can reuse the storage of a private, single-use producer.
+    // Keep explicit views and caller-owned inputs/outputs observable.
+    if (input->view_src || (input->flags & (GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT)) || views.contains(input)) {
+        return true;
+    }
+    const auto & visited = graph.visited_hash_set;
+    const size_t slot = ggml_hash_find(&visited, input);
+    return !graph.use_counts || slot >= visited.size || !ggml_bitset_get(visited.used, slot) || graph.use_counts[slot] != 1;
+}
+
+static std::optional<webgpu_encoded_op> encode(webgpu_context & ctx, const ggml_cgraph & graph, int node_idx,
+                                               bool input_cast, webgpu_fusion_view_sources & views, int & num_encoded_ops) {
+    using namespace webgpu_checked_tensor_binding;
+    constexpr uint32_t workgroup_size = 256;
+    const int add_idx = node_idx + (input_cast ? 1 : 0);
+    if (graph.n_nodes - node_idx < (input_cast ? 3 : 2) ||
+        !ggml_can_fuse(&graph, add_idx, {GGML_OP_ADD, GGML_OP_CPY})) {
+        return std::nullopt;
+    }
+
+    const auto * add = graph.nodes[add_idx];
+    const auto * dst = graph.nodes[add_idx + 1];
+    const auto * a = add->src[0];
+    const auto * b = add->src[1];
+    if (!a || !b || add->type != GGML_TYPE_F32 || a->type != GGML_TYPE_F32 || b->type != GGML_TYPE_F32 ||
+        dst->type != GGML_TYPE_F16 || dst->src[0] != add || dst->src[1] != dst || dst->view_src ||
+        !ggml_are_same_shape(a, dst) || !ggml_can_repeat(b, a)) {
+        return std::nullopt;
+    }
+
+    if (input_cast) {
+        const auto * cast = graph.nodes[node_idx];
+        const auto * raw = cast->src[0];
+        if (cast != b || cast->op != GGML_OP_CPY || cast->src[1] != cast || cast->view_src ||
+            (cast->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || (cast->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+            !raw || raw->type != GGML_TYPE_F16 || !ggml_are_same_shape(raw, cast) ||
+            !ggml_node_has_n_uses(&graph, node_idx, 2)) {
+            return std::nullopt;
+        }
+        b = raw;
+    }
+
+    const auto & limits = ctx->global_ctx->capabilities.limits;
+    if (limits.maxComputeInvocationsPerWorkgroup < workgroup_size || limits.maxComputeWorkgroupSizeX < workgroup_size ||
+        limits.maxStorageBuffersPerShaderStage < 3 || limits.maxUniformBuffersPerShaderStage < 1 ||
+        limits.maxBindingsPerBindGroup < 4 || limits.maxUniformBufferBindingSize < WEBGPU_PARAMS_BUF_SIZE_BYTES ||
+        limits.maxComputeWorkgroupsPerDimension == 0) {
+        return std::nullopt;
+    }
+
+    std::array<buffer_facts, 5> facts{};
+    binding bias, mask, result, sum;
+    if (!get_binding(ctx, a, facts, bias) || !get_binding(ctx, b, facts, mask) || !get_binding(ctx, dst, facts, result) ||
+        bindings_overlap(bias, mask) || bindings_overlap(bias, result) || bindings_overlap(mask, result) ||
+        result.element_offset % 2 || views.contains(add) || (input_cast && views.contains(graph.nodes[node_idx])) ||
+        !get_binding(ctx, add, facts, sum) || ggml_backend_buffer_get_usage(add->buffer) != GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+        return std::nullopt;
+    }
+    const uint32_t b_unit = ggml_type_size(b->type);
+    if ((payloads_overlap(sum, sizeof(float), bias, sizeof(float)) && has_other_readers(graph, views, a)) ||
+        (payloads_overlap(sum, sizeof(float), mask, b_unit) && has_other_readers(graph, views, b))) {
+        return std::nullopt;
+    }
+    if (input_cast) {
+        // The omitted write can change another input even when it is a different
+        // tensor root. Compare the payloads, excluding binding alignment padding.
+        binding converted;
+        const auto * cast = graph.nodes[node_idx];
+        if (!get_binding(ctx, cast, facts, converted) ||
+            ggml_backend_buffer_get_usage(cast->buffer) != GGML_BACKEND_BUFFER_USAGE_COMPUTE ||
+            payloads_overlap(converted, sizeof(float), bias, sizeof(float)) ||
+            payloads_overlap(converted, sizeof(float), mask, b_unit)) {
+            return std::nullopt;
+        }
+    }
+
+    const uint32_t count = uint32_t(ggml_nelements(dst));
+    const uint64_t max_groups = limits.maxComputeWorkgroupsPerDimension;
+    const uint32_t groups = CEIL_DIV(count / 2, workgroup_size);
+    if (count % 2 || groups > max_groups * max_groups) {
+        return std::nullopt;
+    }
+
+    auto & pipeline = ctx->shader_lib->get_add_cast_f16_pipeline(input_cast);
+    if (!pipeline.pipeline) {
+        return std::nullopt;
+    }
+    const std::vector<uint32_t> params = {
+        count, bias.element_offset, mask.element_offset, result.element_offset / 2,
+        uint32_t(a->nb[0] / sizeof(float)), uint32_t(a->nb[1] / sizeof(float)),
+        uint32_t(a->nb[2] / sizeof(float)), uint32_t(a->nb[3] / sizeof(float)),
+        uint32_t(b->nb[0] / b_unit), uint32_t(b->nb[1] / b_unit),
+        uint32_t(b->nb[2] / b_unit), uint32_t(b->nb[3] / b_unit),
+        uint32_t(a->ne[0]), uint32_t(a->ne[1]), uint32_t(a->ne[2]),
+        uint32_t(b->ne[0]), uint32_t(b->ne[1]), uint32_t(b->ne[2]), uint32_t(b->ne[3]),
+    };
+    const std::vector<wgpu::BindGroupEntry> entries = {
+        ggml_webgpu_make_bind_group_entry(0, bias.buffer, bias.offset, bias.size),
+        ggml_webgpu_make_bind_group_entry(1, mask.buffer, mask.offset, mask.size),
+        ggml_webgpu_make_bind_group_entry(2, result.buffer, result.offset, result.size),
+    };
+    uint32_t x, y;
+    compute_2d_workgroups(groups, limits.maxComputeWorkgroupsPerDimension, x, y);
+    auto command = ggml_backend_webgpu_build(ctx, pipeline, params, entries, x, y);
+    num_encoded_ops = input_cast ? 3 : 2;
+    return command;
+}
+
+} // namespace webgpu_add_cast_f16
