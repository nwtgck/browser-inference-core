+static webgpu_encoded_op ggml_webgpu_hc(webgpu_context & ctx, ggml_tensor * dst) {
+    const bool pre = dst->op == GGML_OP_DSV4_HC_PRE;
+    ggml_tensor * x = dst->src[0];
+    ggml_tensor * y = dst->src[1];
+    auto offset = [&](ggml_tensor * t) { return (uint32_t) (ggml_webgpu_tensor_misalignment(ctx, t) / 4); };
+    std::vector<uint32_t> params;
+    std::vector<wgpu::BindGroupEntry> entries = {
+        ggml_webgpu_make_tensor_bind_group_entry(ctx, 0, x),
+        ggml_webgpu_make_tensor_bind_group_entry(ctx, 1, y),
+    };
+    if (pre) {
+        params = { offset(x), offset(y), offset(dst), (uint32_t) x->ne[0], (uint32_t) x->ne[2],
+                   ggml_webgpu_u32_from_f32(ggml_get_op_params_f32(dst, 0)), 0 };
+        entries.push_back(ggml_webgpu_make_tensor_bind_group_entry(ctx, 2, dst));
+    } else {
+        ggml_tensor * p = dst->src[2];
+        params = { offset(x), offset(y), offset(p), offset(dst), (uint32_t) x->ne[0], (uint32_t) x->ne[1] };
+        entries.push_back(ggml_webgpu_make_tensor_bind_group_entry(ctx, 2, p));
+        entries.push_back(ggml_webgpu_make_tensor_bind_group_entry(ctx, 3, dst));
+    }
+    webgpu_pipeline pipeline = ctx->shader_lib->get_hc_pipeline(pre);
+    uint32_t wg_x, wg_y;
+    const uint32_t groups = (uint32_t) ((ggml_nelements(dst) + 63) / 64);
+    compute_2d_workgroups(groups, ctx->global_ctx->capabilities.limits.maxComputeWorkgroupsPerDimension, wg_x, wg_y);
+    return ggml_backend_webgpu_build(ctx, pipeline, params, entries, wg_x, wg_y);
+}
