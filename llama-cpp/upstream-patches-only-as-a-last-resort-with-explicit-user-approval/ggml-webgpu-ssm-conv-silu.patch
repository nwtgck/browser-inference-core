+    const uint64_t tokens_per_wg = plan.output->ne[1] == 1 ? 1 : 8;
+    const uint64_t token_tiles = (uint64_t(plan.output->ne[1]) + tokens_per_wg - 1) / tokens_per_wg;
+    const uint64_t x = (uint64_t(plan.output->ne[0]) + 31) / 32;
+    const uint64_t y = token_tiles * uint64_t(plan.output->ne[2]);
+    if (limits.maxComputeInvocationsPerWorkgroup < 32 * tokens_per_wg ||
+        limits.maxComputeWorkgroupSizeX < 32 || limits.maxComputeWorkgroupSizeY < tokens_per_wg ||
+        limits.maxStorageBuffersPerShaderStage < 3 || limits.maxBindingsPerBindGroup < 4 ||
+        limits.maxUniformBuffersPerShaderStage < 1 || limits.maxUniformBufferBindingSize < WEBGPU_PARAMS_BUF_SIZE_BYTES ||
+        x > limits.maxComputeWorkgroupsPerDimension || y > limits.maxComputeWorkgroupsPerDimension ||
+        y * tokens_per_wg > UINT32_MAX) { return std::nullopt; }
