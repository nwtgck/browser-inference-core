+// Includes the existing vec partial-output and mask-block surfaces plus the
+// materialized mask. Reserve for the largest vec batch even from a tile node.
+static std::optional<ggml_webgpu_indexed_vec_layout> ggml_webgpu_flash_indexed_vec_layout(
+        const webgpu_global_context & global, const ggml_tensor * node, uint64_t queries) {
+    const auto * q = node->src[0];
+    const auto * k = node->src[1];
+    const auto * v = node->src[2];
+    const auto & caps = global->capabilities;
+    const auto & limits = caps.limits;
+    const uint64_t alignment = limits.minStorageBufferOffsetAlignment;
+    const uint64_t cap = std::min<uint64_t>({limits.maxStorageBufferBindingSize, limits.maxBufferSize, UINT32_MAX});
+    const uint32_t wg_limit = limits.maxComputeInvocationsPerWorkgroup;
+    const uint32_t size_x = limits.maxComputeWorkgroupSizeX;
+    const uint32_t subgroup = caps.max_subgroup_size;
+    if (!queries || !caps.min_subgroup_size || subgroup < caps.min_subgroup_size || subgroup > size_x ||
+        subgroup > wg_limit || wg_limit < 128u || size_x < 128u || alignment < 4u ||
+        !std::has_single_bit(alignment) || node->view_src || node->view_offs) {
+        return std::nullopt;
+    }
+    const auto kv = uint32_t(k->ne[1]);
+    const auto d = uint32_t(q->ne[0]);
+    const auto dv = uint32_t(v->ne[0]);
+    const bool kd = ggml_webgpu_flash_attn_k_direct(q, k, GGML_WEBGPU_FLASH_ATTN_TILE_KV_VEC_WIDTH);
+    const bool vd = ggml_webgpu_flash_attn_v_direct(q, v, GGML_WEBGPU_FLASH_ATTN_TILE_KV_VEC_WIDTH);
+    if (!ggml_webgpu_flash_attn_max_kv_tile(limits.maxComputeWorkgroupStorageSize, 1u, 1u, d, dv, true, kd && vd)) {
+        return std::nullopt;
+    }
+    const uint32_t tile = ggml_webgpu_flash_attn_get_vec_kv_tile(limits.maxComputeWorkgroupStorageSize, d, dv, true, kd, vd);
+    const uint32_t nwg = ggml_webgpu_flash_attn_vec_nwg(caps.min_subgroup_size, tile, kv);
+    const uint32_t block_width = std::max(1u, std::bit_floor(tile <= 32u ? std::min(wg_limit, 32u) : wg_limit));
+    const uint64_t group_cap = limits.maxComputeWorkgroupsPerDimension;
+    const uint64_t blocks = (uint64_t(kv) + tile - 1u) / tile;
+    if (!kv || !nwg || !group_cap || blocks > group_cap || block_width > size_x ||
+        12u * uint64_t(block_width) > limits.maxComputeWorkgroupStorageSize ||
+        (nwg > 1u && std::min<uint64_t>(uint64_t(nwg) * subgroup, wg_limit) > size_x)) {
+        return std::nullopt;
+    }
+    const uint64_t row_cap = group_cap / nwg;
+    if (queries > row_cap / uint64_t(q->ne[2]) / uint64_t(q->ne[3])) {
+        return std::nullopt;
+    }
+    const uint64_t rows = queries * q->ne[2] * q->ne[3];
+    if (rows > cap / sizeof(uint32_t) / blocks || rows > cap / sizeof(uint16_t) / kv ||
+        (nwg > 1u && rows * nwg > cap / sizeof(float) / (uint64_t(dv) + 2u))) {
+        return std::nullopt;
+    }
+    const uint64_t mask_bytes = rows * kv * sizeof(uint16_t);
+    const uint64_t block_bytes = rows * blocks * sizeof(uint32_t);
+    const uint64_t tmp_bytes = nwg > 1u ? rows * nwg * (uint64_t(dv) + 2u) * sizeof(float) : WEBGPU_STORAGE_BUF_BINDING_MULT;
+    const uint64_t pairs = mask_bytes / 4u;
+    const uint64_t groups = (pairs + 127u) / 128u;
+    if (!groups || mask_bytes % 4u || groups > group_cap * group_cap) {
+        return std::nullopt;
+    }
+    const uint64_t tmp_offset = ROUNDUP_POW2(uint64_t(ggml_nbytes(node)), alignment);
+    const uint64_t blk_offset = ROUNDUP_POW2(tmp_offset + tmp_bytes, alignment);
+    const uint64_t mask_offset = ROUNDUP_POW2(blk_offset + block_bytes, alignment);
+    const uint64_t bytes = ROUNDUP_POW2(mask_offset + mask_bytes, alignment);
+    const uint64_t allocation_cap = sizeof(size_t) < sizeof(uint64_t) ?
+        std::min<uint64_t>(limits.maxBufferSize, SIZE_MAX / 2) : limits.maxBufferSize;
+    if (bytes > allocation_cap) {
+        return std::nullopt;
+    }
+    return ggml_webgpu_indexed_vec_layout{mask_offset, bytes, uint32_t(pairs), uint32_t(groups)};
+}
