+++ b/ggml/src/ggml-webgpu/wgsl-shaders/indexed_vec_mask_block.wgsl
@@ -0,0 +1,70 @@
+enable f16;
+
+// Shares the uniform layout of indexed_vec_mask. The dispatcher requires one query per stream.
+struct Params {
+    kv: u32,
+    queries: u32,
+    heads: u32,
+    table_heads: u32,
+    head_first: u32,
+    buckets: u32,
+    pairs: u32,
+    table_offset: u32,
+    ids_offset: u32,
+    raw_offset: u32,
+    out_offset: u32,
+}
+
+@group(0) @binding(0) var<storage, read_write> table: array<f32>;
+@group(0) @binding(1) var<storage, read_write> relative_ids: array<i32>;
+@group(0) @binding(2) var<storage, read_write> raw: array<f16>;
+@group(0) @binding(3) var<storage, read_write> out_mask: array<vec2<f16>>;
+@group(0) @binding(4) var<storage, read_write> states: array<u32>;
+@group(0) @binding(5) var<uniform> params: Params;
+
+const PAIRS_PER_BLOCK: u32 = 16u;
+const WORKGROUP_SIZE: u32 = 128u;
+const MASK_MAX: f32 = 65504.0;
+var<workgroup> values: array<vec2<f16>, WORKGROUP_SIZE>;
+
+@compute @workgroup_size(WORKGROUP_SIZE)
+fn main(@builtin(global_invocation_id) id: vec3<u32>,
+        @builtin(local_invocation_id) lane: vec3<u32>,
+        @builtin(num_workgroups) grid: vec3<u32>) {
+    let pair = id.x + grid.x * WORKGROUP_SIZE * id.y;
+    if (pair < params.pairs) {
+        let left = pair * 2u;
+        let row = left / params.kv;
+        let flat_query = row / params.heads;
+        let head = params.head_first + row % params.heads;
+        let cell = flat_query * params.kv + left % params.kv;
+        let bias_base = params.table_offset + (flat_query * params.table_heads + head) * params.buckets;
+        let b0 = u32(relative_ids[params.ids_offset + cell]);
+        let b1 = u32(relative_ids[params.ids_offset + cell + 1u]);
+        let value = vec2<f16>(
+            f16(table[bias_base + b0] + f32(raw[params.raw_offset + cell])),
+            f16(table[bias_base + b1] + f32(raw[params.raw_offset + cell + 1u])));
+        values[lane.x] = value;
+        out_mask[params.out_offset + pair] = value;
+    }
+    workgroupBarrier();
+
+    if (pair < params.pairs && lane.x % PAIRS_PER_BLOCK == 0u) {
+        // Use the classifier's F16 inputs and its per-cell clamp and reduction order.
+        let first = f32(values[lane.x].x);
+        var mmin = min(MASK_MAX, first);
+        var mmax = max(-MASK_MAX, first);
+        for (var i = 1u; i < 2u * PAIRS_PER_BLOCK; i += 1u) {
+            let v = f32(values[lane.x + i / 2u][i % 2u]);
+            mmin = min(mmin, min(MASK_MAX, v));
+            mmax = max(mmax, max(-MASK_MAX, v));
+        }
+        var state = 1u;
+        if (mmax <= -MASK_MAX) {
+            state = 0u;
+        } else if (mmin == 0.0 && mmax == 0.0) {
+            state = 2u;
+        }
+        states[pair / PAIRS_PER_BLOCK] = state;
+    }
+}
