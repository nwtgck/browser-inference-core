diff --git a/src/core/browser_bf16_retention.h b/src/core/browser_bf16_retention.h
new file mode 100644
--- /dev/null
+++ b/src/core/browser_bf16_retention.h
@@ -0,0 +1,185 @@
+#ifndef __SD_CORE_BROWSER_BF16_RETENTION_H__
+#define __SD_CORE_BROWSER_BF16_RETENTION_H__
+
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+#include "ggml-backend.h"
+#include "core/ggml_compat.h"
+
+namespace sd {
+    inline bool browser_bf16_matrix_role(const ggml_tensor* tensor, ggml_op role) {
+        return tensor != nullptr && tensor->type == GGML_TYPE_BF16 &&
+               tensor->op == GGML_OP_NONE && tensor->view_src == nullptr &&
+               ggml_n_dims(tensor) == 2 && ggml_is_contiguous(tensor) &&
+               (role == GGML_OP_MUL_MAT || role == GGML_OP_GET_ROWS);
+    }
+
+    // Opt-in original-weight contract. Metadata views may borrow the original
+    // storage; copies, casts and weight-side arithmetic are never substitutes
+    // for retaining that storage. The caller must not retry on CPU or in F32.
+    class BrowserBf16RetainedGraph {
+        struct Consumer {
+            ggml_tensor* node;
+            ggml_tensor* weight;
+        };
+        std::vector<Consumer> consumers_;
+        ggml_backend_t backend_ = nullptr;
+
+        [[noreturn]] static void fail(const char* reason) {
+            throw std::runtime_error(std::string("WebGPU BF16 retention: ") + reason);
+        }
+
+        static bool is_view(ggml_op op) {
+            return op == GGML_OP_VIEW || op == GGML_OP_RESHAPE ||
+                   op == GGML_OP_PERMUTE || op == GGML_OP_TRANSPOSE;
+        }
+
+        static bool is_weight(const ggml_tensor* tensor, const std::unordered_set<const ggml_tensor*>& roots) {
+            return tensor != nullptr && (roots.count(tensor) != 0 ||
+                   (tensor->view_src != nullptr && roots.count(tensor->view_src) != 0));
+        }
+
+        static ggml_backend_buffer_t buffer_of(const ggml_tensor* tensor) {
+            return tensor == nullptr ? nullptr : tensor->buffer != nullptr ? tensor->buffer :
+                   tensor->view_src != nullptr ? tensor->view_src->buffer : nullptr;
+        }
+
+        static uint64_t checked_span(const ggml_tensor* tensor, uint64_t scalar_bytes) {
+            if (tensor == nullptr || tensor->nb[0] != scalar_bytes) fail("unsupported inner stride");
+            uint64_t span = scalar_bytes, elements = 1;
+            const auto limit = uint64_t(std::numeric_limits<uint32_t>::max());
+            for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+                if (tensor->ne[i] <= 0 || uint64_t(tensor->ne[i]) > limit || tensor->nb[i] == 0 ||
+                    tensor->nb[i] % scalar_bytes != 0 || tensor->nb[i] > limit) {
+                    fail("unsupported tensor shape or stride");
+                }
+                const auto count = uint64_t(tensor->ne[i]);
+                if (elements > limit / count || count - 1 > (limit - span) / tensor->nb[i]) {
+                    fail("tensor span exceeds the reviewed range");
+                }
+                elements *= count;
+                span += (count - 1) * tensor->nb[i];
+            }
+            return span;
+        }
+
+        void inspect(ggml_cgraph* graph, const std::unordered_set<const ggml_tensor*>& roots) {
+            if (roots.empty()) return;
+            if (graph == nullptr) fail("missing graph");
+            for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+                auto* node = ggml_graph_node(graph, i);
+                bool uses_weight = false;
+                for (const auto* input : node->src) uses_weight = uses_weight || is_weight(input, roots);
+                if (!uses_weight) continue;
+                if (is_view(node->op)) {
+                    if (!is_weight(node, roots)) fail("metadata view lost original storage");
+                    continue;
+                }
+                auto* weight = node->src[0];
+                auto* input = node->src[1];
+                if (!is_weight(weight, roots) || weight->type != GGML_TYPE_BF16 || node->type != GGML_TYPE_F32) {
+                    fail("unsupported weight operand or output type");
+                }
+                for (int s = 1; s < GGML_MAX_SRC; ++s) {
+                    if (is_weight(node->src[s], roots)) fail("weight used outside the left operand");
+                }
+                if (!ggml_is_contiguous(weight)) fail("non-contiguous retained weight");
+                auto* root = weight->view_src != nullptr ? weight->view_src : weight;
+                const auto root_bytes = checked_span(root, 2);
+                const auto weight_bytes = checked_span(weight, 2);
+                if (weight->view_offs % 4 != 0 || weight->view_offs > root_bytes ||
+                    weight_bytes > root_bytes - weight->view_offs) {
+                    fail("unaligned or out-of-bounds weight view");
+                }
+                checked_span(node, 4);
+                if (input == nullptr) fail("missing input");
+                checked_span(input, 4);
+                if (node->op == GGML_OP_MUL_MAT) {
+                    if (input->type != GGML_TYPE_F32 || weight->ne[0] != input->ne[0] ||
+                        input->ne[2] % weight->ne[2] != 0 || input->ne[3] % weight->ne[3] != 0 ||
+                        node->ne[0] != weight->ne[1] || node->ne[1] != input->ne[1] ||
+                        node->ne[2] != input->ne[2] || node->ne[3] != input->ne[3]) {
+                        fail("unsupported matmul input or shape");
+                    }
+                    const auto batches = uint64_t(input->ne[2]) * uint64_t(input->ne[3]);
+                    if (input->ne[1] > 65535 || batches > 65535 || uint64_t(weight->ne[1]) > 65535 / batches) {
+                        fail("matmul exceeds the reviewed dispatch envelope");
+                    }
+                } else if (node->op == GGML_OP_GET_ROWS) {
+                    const auto rows = uint64_t(node->ne[1]) * uint64_t(node->ne[2]) * uint64_t(node->ne[3]);
+                    if (input->type != GGML_TYPE_I32 || rows > 65535) {
+                        fail("row lookup exceeds the reviewed index or dispatch envelope");
+                    }
+                } else {
+                    fail("unsupported operation on retained weight");
+                }
+                consumers_.push_back({node, weight});
+            }
+        }
+
+    public:
+        static bool is_webgpu(ggml_backend_t backend) {
+            auto* device = backend != nullptr ? ggml_backend_get_device(backend) : nullptr;
+            auto* registry = device != nullptr ? ggml_backend_dev_backend_reg(device) : nullptr;
+            return registry != nullptr && std::strcmp(ggml_backend_reg_name(registry), "WebGPU") == 0;
+        }
+
+        // Check the complete graph before lazy weight preparation or graph-cut
+        // caches can hide an unsupported use behind a derived tensor.
+        static void validate_unallocated(ggml_cgraph* graph, const std::vector<ggml_tensor*>& weights) {
+            std::unordered_set<const ggml_tensor*> roots;
+            for (auto* weight : weights) {
+                if (weight == nullptr || weight->type != GGML_TYPE_BF16) fail("registered retained weight changed type");
+                roots.insert(weight);
+            }
+            BrowserBf16RetainedGraph check;
+            check.inspect(graph, roots);
+        }
+
+        void prepare(ggml_cgraph* graph, ggml_backend_sched_t scheduler, ggml_backend_t target,
+                     const std::vector<ggml_tensor*>& registered_weights) {
+            consumers_.clear();
+            backend_ = target;
+            if (registered_weights.empty()) return;
+            if (!is_webgpu(target)) fail("retained operation requires WebGPU");
+            std::unordered_set<const ggml_tensor*> roots;
+            for (auto* weight : registered_weights) {
+                if (weight == nullptr || weight->type != GGML_TYPE_BF16) fail("registered retained weight changed type");
+                roots.insert(weight);
+            }
+            inspect(graph, roots);
+            for (const auto& item : consumers_) {
+                auto* buffer = buffer_of(item.weight);
+                if (buffer == nullptr || !ggml_backend_supports_buft(target, ggml_backend_buffer_get_type(buffer))) {
+                    fail("retained storage is not accessible by WebGPU");
+                }
+                if (!ggml_backend_supports_op(target, item.node)) fail("WebGPU rejects retained weight operation");
+            }
+            // Validate the complete segment before changing assignments.
+            for (const auto& item : consumers_) ggml_backend_sched_set_tensor_backend(scheduler, item.node, target);
+        }
+
+        void verify_allocated(ggml_backend_sched_t scheduler) const {
+            for (const auto& item : consumers_) {
+                if (item.node->src[0] != item.weight) fail("scheduler copied retained storage");
+                if (ggml_backend_sched_get_tensor_backend(scheduler, item.node) != backend_) {
+                    fail("retained operation left WebGPU");
+                }
+                auto* weight = buffer_of(item.weight);
+                auto* input = buffer_of(item.node->src[1]);
+                auto* output = buffer_of(item.node);
+                if (weight == nullptr || input == nullptr || output == nullptr) fail("missing allocated buffer");
+                if (weight == input || weight == output) fail("weight shares an activation buffer");
+                if (!ggml_backend_supports_op(backend_, item.node)) fail("allocated operation is unsupported by WebGPU");
+            }
+        }
+    };
+}
+
+#endif  // __SD_CORE_BROWSER_BF16_RETENTION_H__
