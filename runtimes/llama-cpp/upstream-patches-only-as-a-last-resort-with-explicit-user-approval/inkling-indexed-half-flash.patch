+           table->ne[0] > 0 && table->ne[1] == q->ne[2] && table->ne[2] == flat_queries && table->ne[3] == 1 &&
+           buckets && buckets->type == GGML_TYPE_I32 && ggml_is_contiguous(buckets) && ggml_is_matrix(buckets) &&
+           buckets->ne[0] == raw->ne[0] && buckets->ne[1] == flat_queries;
