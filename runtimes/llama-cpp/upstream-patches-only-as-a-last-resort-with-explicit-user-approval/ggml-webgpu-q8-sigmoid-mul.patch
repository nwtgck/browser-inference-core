+static std::optional<webgpu_encoded_op> encode(webgpu_context & ctx, ggml_cgraph & graph, int index,
+                                               webgpu_fusion_view_sources & views, int & consumed) {
+    const auto * mat = graph.nodes[index];
+    auto * weights = mat->src[0];
+    if (!weights || weights->type != GGML_TYPE_Q8_0 ||
+        weights->ne[0] != input_width || weights->ne[1] != output_width ||
+        graph.n_nodes - index < operations) {
+        return std::nullopt;
+    }
+    const auto * sigmoid = graph.nodes[index + 1];
+    auto * output = graph.nodes[index + 2];
+    auto * input = mat->src[1];
+    const auto * value = output->src[0];
+    if (sigmoid->op != GGML_OP_UNARY || ggml_get_unary_op(sigmoid) != GGML_UNARY_OP_SIGMOID ||
+        sigmoid->src[0] != mat || output->op != GGML_OP_MUL || output->src[1] != sigmoid ||
+        !shape(weights, GGML_TYPE_Q8_0, input_width, output_width) ||
+        !shape(input, GGML_TYPE_F32, input_width, 1) || !shape(value, GGML_TYPE_F32, output_width, 1) ||
+        !std::all_of(std::begin(mat->op_params), std::end(mat->op_params), [](int32_t word) { return word == 0; })) {
+        return std::nullopt;
+    }
+    const ggml_tensor * chain[] = {mat, sigmoid, output};
+    for (const auto * node : chain) {
+        if (node->view_src || node->view_offs || !shape(node, GGML_TYPE_F32, output_width, 1) ||
+            std::any_of(std::begin(node->src) + (node == sigmoid ? 1 : 2), std::end(node->src),
+                [](const ggml_tensor * source) { return source != nullptr; })) {
+            return std::nullopt;
+        }
+    }
+
+    const auto & limits = ctx->global_ctx->capabilities.limits;
+    if (limits.maxStorageBuffersPerShaderStage < 3 || limits.maxBindingsPerBindGroup < 4 ||
+        limits.maxUniformBuffersPerShaderStage < 1 || limits.maxUniformBufferBindingSize < WEBGPU_PARAMS_BUF_SIZE_BYTES ||
+        ctx->param_arena.slot_size < WEBGPU_PARAMS_BUF_SIZE_BYTES ||
+        limits.maxComputeWorkgroupSizeX < workgroup ||
+        limits.maxComputeWorkgroupsPerDimension < output_width / 16) {
