+
+uint32_t mtmd_vision_bf16_storage_version(void) {
+    return 1;
+}
+
+mtmd_context * mtmd_init_from_file_with_vision_bf16_storage(
+        const char * path, const llama_model * text_model,
+        const mtmd_context_params params, int32_t storage) {
+    // Validate the raw i32 before conversion to the bounded C enum or any I/O.
+    if (storage != MTMD_VISION_BF16_STORAGE_LEGACY_EXPAND &&
+        storage != MTMD_VISION_BF16_STORAGE_RETAIN_CHECKED) {
+        LOG_ERR("%s: unknown vision BF16 storage policy\n", __func__);
+        return nullptr;
+    }
+    try {
+        return new mtmd_context(path, text_model, params, false,
+                               static_cast<mtmd_vision_bf16_storage>(storage));
+    } catch (const std::exception & error) {
+        LOG_ERR("%s: error: %s\n", __func__, error.what());
+        return nullptr;
+    }
+}
+
+mtmd_vision_bf16_storage mtmd_context_vision_bf16_storage(const mtmd_context * context) {
+    return context ? context->vision_bf16_storage : MTMD_VISION_BF16_STORAGE_INVALID;
+}
+
+
+uint32_t mtmd_vision_bf16_diagnostics_version(void) { return 1; }
+
+int32_t mtmd_vision_bf16_classify_metadata(int32_t has_vision, const char * common, const char * vision) {
+    return lcb_mtmd_classify_metadata(has_vision, common, vision);
+}
+
+mtmd_context * mtmd_init_from_file_with_vision_bf16_report(
+        const char * path, const llama_model * text_model, const mtmd_context_params params,
+        int32_t storage, mtmd_vision_bf16_load_report * report, uint32_t report_size) {
+    if (!report || report_size != sizeof(*report)) return nullptr;
+    *report = lcb_mtmd_new_load_report();
+    if (storage != MTMD_VISION_BF16_STORAGE_LEGACY_EXPAND && storage != MTMD_VISION_BF16_STORAGE_RETAIN_CHECKED) {
+        report->reason = MTMD_VISION_BF16_REASON_INVALID_MODE;
+        report->cleanup = MTMD_VISION_BF16_CLEANUP_NOT_REQUIRED;
+        return nullptr;
+    }
+    try {
+        auto * result = new mtmd_context(path, text_model, params, false,
+            static_cast<mtmd_vision_bf16_storage>(storage), report);
+        report->status = MTMD_VISION_BF16_LOAD_SUCCEEDED;
+        report->reason = MTMD_VISION_BF16_REASON_NONE;
+        report->phase = MTMD_VISION_BF16_PHASE_COMPLETE;
+        report->cleanup = MTMD_VISION_BF16_CLEANUP_NOT_REQUIRED;
+        return result;
+    } catch (const std::exception & error) {
+        LOG_ERR("%s: error: %s\n", __func__, error.what());
+        return nullptr;
+    }
+}
+
+int32_t mtmd_context_vision_bf16_statistics(const mtmd_context * context,
+        mtmd_vision_bf16_statistics * statistics, uint32_t statistics_size) {
+    if (!context || !statistics || statistics_size != sizeof(*statistics)) return 0;
+    *statistics = lcb_clip_vision_bf16_statistics(context->ctx_v);
+    return 1;
 }
 
