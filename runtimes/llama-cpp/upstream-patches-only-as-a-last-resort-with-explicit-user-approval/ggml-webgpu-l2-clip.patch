--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/l2_clip.wgsl
@@ -0,0 +1,44 @@
+struct Params {
+    input_offset: u32,
+    output_offset: u32,
+    width: u32,
+    threshold: f32,
+};
+
+@group(0) @binding(0) var<storage, read_write> input_values: array<f32>;
+#ifdef INPLACE
+@group(0) @binding(1) var<uniform> params: Params;
+#define OUTPUT_VALUES input_values
+#else
+@group(0) @binding(1) var<storage, read_write> output_values: array<f32>;
+@group(0) @binding(2) var<uniform> params: Params;
+#define OUTPUT_VALUES output_values
+#endif
+
+var<workgroup> squares: array<f32, WG_SIZE>;
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_id) lane: vec3<u32>) {
+    let index = group.x * params.width + lane.x;
+    var value = 0.0;
+    if (lane.x < params.width) {
+        value = input_values[params.input_offset + index];
+    }
+    squares[lane.x] = 0.0 + (value * value);
+    workgroupBarrier();
+
+    var step = WG_SIZE >> 1u;
+    while (step > 0u) {
+        if (lane.x < step) {
+            squares[lane.x] += squares[lane.x + step];
+        }
+        workgroupBarrier();
+        step >>= 1u;
+    }
+
+    if (lane.x < params.width) {
+        let denom = sqrt(squares[0]) * 1.0 + 1e-6;
+        let factor = clamp(params.threshold / denom, 0.0, 1.0);
+        OUTPUT_VALUES[params.output_offset + index] = value * factor;
+    }
+}
