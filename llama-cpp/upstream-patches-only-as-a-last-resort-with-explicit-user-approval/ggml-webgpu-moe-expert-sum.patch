diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/moe_expert_sum.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/moe_expert_sum.wgsl
new file mode 100644
index 0000000..9e6619e
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/moe_expert_sum.wgsl
@@ -0,0 +1,20 @@
+// Ordered expert-output sum. Slot order matches the original left-associated ADDs.
+// No tree reduction, selection change, weight change, or reduced precision.
+struct Params { offset_src: u32, offset_dst: u32, width_vec4: u32, tokens: u32, };
+@group(0) @binding(0) var<storage, read_write> src: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> dst: array<vec4<f32>>;
+@group(0) @binding(2) var<uniform> params: Params;
+@compute @workgroup_size(128)
+fn main(@builtin(local_invocation_id) lid: vec3<u32>, @builtin(workgroup_id) wid: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let i = (wid.y * num_wg.x + wid.x) * 128u + lid.x;
+    if (i >= params.width_vec4 * params.tokens) { return; }
+    let token = i / params.width_vec4;
+    let col = i % params.width_vec4;
+    let base = params.offset_src + token * params.width_vec4 * N_EXPERTS + col;
+    var sum = src[base];
+    for (var slot = 1u; slot < N_EXPERTS; slot++) {
+        sum = sum + src[base + slot * params.width_vec4];
+    }
+    dst[params.offset_dst + i] = sum;
+}
