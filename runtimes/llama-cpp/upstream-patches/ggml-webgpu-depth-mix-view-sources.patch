diff --git a/ggml/src/ggml-webgpu/ggml-webgpu-fusion-view-sources.hpp b/ggml/src/ggml-webgpu/ggml-webgpu-fusion-view-sources.hpp
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/ggml-webgpu-fusion-view-sources.hpp
@@ -0,0 +1,40 @@
+#pragma once
+
+#include "ggml-impl.h"
+
+#include <algorithm>
+#include <functional>
+#include <iterator>
+#include <optional>
+#include <vector>
+
+class webgpu_fusion_view_sources {
+public:
+    explicit webgpu_fusion_view_sources(const ggml_cgraph & graph) : graph_(graph) {}
+
+    bool contains(const ggml_tensor * source) {
+        const std::less<const ggml_tensor *> order;
+        if (!roots_) {
+            auto & roots = roots_.emplace();
+            // Raw views can use storage without a src edge. A graph slice
+            // keeps the original visit set, including readers in other slices.
+            const auto & visited = graph_.visited_hash_set;
+            for (size_t i = 0; i < visited.size; ++i) {
+                if (!ggml_bitset_get(visited.used, i)) {
+                    continue;
+                }
+                const auto * tensor = visited.keys[i];
+                const auto * root = tensor->view_src;
+                if (root && std::find(std::begin(tensor->src), std::end(tensor->src), root) == std::end(tensor->src)) {
+                    roots.push_back(root);
+                }
+            }
+            std::sort(roots.begin(), roots.end(), order);
+        }
+        return std::binary_search(roots_->begin(), roots_->end(), source, order);
+    }
+
+private:
+    const ggml_cgraph & graph_;
+    std::optional<std::vector<const ggml_tensor *>> roots_;
+};
