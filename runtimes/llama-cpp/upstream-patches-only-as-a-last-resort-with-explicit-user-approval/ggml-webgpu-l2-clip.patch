+        !ggml_webgpu_rms_scale_binding(ctx, plan.output, plan.output_bytes, output)) {
+        return std::nullopt;
+    }
+    const bool same_buffer = input.buffer.Get() == output.buffer.Get();
+    const bool inplace = same_buffer && input.tensor_offset == output.tensor_offset &&
+                         rms_scale_same_mapping(plan.input, plan.output);
+    if (same_buffer && !inplace &&
+        (!rms_scale_disjoint(input.tensor_offset, plan.input_bytes, output.tensor_offset, plan.output_bytes) ||
