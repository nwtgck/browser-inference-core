+    using Inputs = std::tuple<const sd::Tensor<float>*, const sd::Tensor<int32_t>*, const sd::Tensor<float>*>;
+private:
+    std::array<Inputs, capacity> inputs{};
+    size_t size = 0;
+    bool enabled = true;
+
+public:
+    void disable() { enabled = false; }
+
+    // The caller owns the sampling lifetime and guarantees immutable contents.
+    // Tensor addresses identify these objects only; they are not a content cache.
+    uint64_t get(const sd::Tensor<float>* context, const sd::Tensor<int32_t>* ids,
+                 const sd::Tensor<float>* weights) {
+        if (!enabled || context == nullptr || context->empty() || ids == nullptr || ids->empty()) return 0;
+        const Inputs key{context, ids, weights};
+        for (size_t i = 0; i < size; ++i) {
+            if (inputs[i] == key) return i + 1;
+        }
+        if (size == capacity) return 0;
+        inputs[size++] = key;
+        return size;
+    }
 };
 
