 static constexpr size_t ST_HEADER_SIZE_LEN = 8;
+// A file position is independent of the Wasm linear-memory/address width.
+static constexpr uint64_t ST_MAX_HEADER = 100ULL * 1024 * 1024;
+static uint64_t st_file_size(std::ifstream& file) {
+    static_assert(sizeof(std::streamoff) >= 8, "safetensors require 64-bit offsets");
+    file.seekg(0, std::ios::end);
+    const auto end = file.tellg();
+    if (end < 0) throw std::runtime_error("cannot determine safetensors file size");
+    file.seekg(0, std::ios::beg);
+    if (!file) throw std::runtime_error("cannot seek safetensors file");
+    return static_cast<uint64_t>(end);
+}
+static bool st_relative_path(const std::string& path) {
+    if (path.empty() || path.front() == '/' || path.find('\\') != std::string::npos ||
+        path.find(':') != std::string::npos || path.find('\0') != std::string::npos) return false;
+    size_t start = 0;
+    while (start <= path.size()) {
+        const size_t end = path.find('/', start);
+        const std::string part = path.substr(start, end == std::string::npos ? end : end - start);
+        if (part.empty() || part == "." || part == "..") return false;
+        if (end == std::string::npos) break;
+        start = end + 1;
+    }
+    return true;
+}
+// Reject ambiguous JSON rather than letting the last duplicate tensor win.
+static nlohmann::json st_parse_json(const char* begin, const char* end) {
+    std::vector<std::unordered_set<std::string>> keys;
+    size_t key_count = 0;
+    return nlohmann::json::parse(begin, end, [&](int depth, nlohmann::json::parse_event_t event, nlohmann::json& parsed) {
+        if (depth > 64) throw std::runtime_error("safetensors JSON nesting limit");
+        if (event == nlohmann::json::parse_event_t::object_start) keys.emplace_back();
+        else if (event == nlohmann::json::parse_event_t::key) {
+            if (++key_count > 1000000 || keys.empty() || !keys.back().insert(parsed.get<std::string>()).second)
+                throw std::runtime_error("duplicate safetensors JSON key");
+        } else if (event == nlohmann::json::parse_event_t::object_end) keys.pop_back();
+        return true;
+    });
+}
+static uint64_t st_unsigned(const nlohmann::json& value) {
