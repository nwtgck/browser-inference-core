+// VEC shaders divide binding-relative offsets and active strides by four.
+// Test the actual wire offset (including merged bindings), not view_offs alone.
+static bool ggml_webgpu_mul_mat_vec4_aligned(const ggml_tensor * tensor, uint32_t offset) {
+    if ((tensor->type != GGML_TYPE_F32 && tensor->type != GGML_TYPE_F16) || offset % 4 != 0) {
+        return false;
+    }
+    const size_t vector_bytes = tensor->type == GGML_TYPE_F32 ? 16u : 8u;
+    for (int axis = 1; axis < GGML_MAX_DIMS; ++axis) {
+        if (tensor->ne[axis] > 1 && (tensor->nb[axis] & (vector_bytes - 1)) != 0) {
+            return false;
+        }
+    }
+    return true;
+}
