// Actual prepared constructor/destructor bodies with controlled allocation and
// scheduling boundaries. This does not load a model or create GPU resources.
#include <algorithm>
#include <cassert>
#include <cstdlib>
#include <cstring>
#include <memory>
#include <stdexcept>
#include <string>
#include <vector>

#define LOG_INF(...) ((void) 0)
#define LOG_ERR(...) ((void) 0)
struct ggml_threadpool {};
struct backend_type { int id; bool alive = false; };
using ggml_backend_t = backend_type *;
using ggml_backend_dev_t = void *;
using ggml_backend_reg_t = void *;
using ggml_backend_buffer_type_t = void *;
using ggml_backend_sched_t = void *;
using ggml_backend_sched_eval_callback = void (*)(void);
enum { GGML_BACKEND_DEVICE_TYPE_CPU = 0 };
static struct {
    std::string failure;
    bool alias = false;
    bool scheduler = false;
    std::vector<std::string> events;
    backend_type cpu{1}, gpu{2};
    int frees = 0, created = 0;
} control;
static void point(const std::string & name) {
    control.events.push_back(name);
    if (control.failure == name) throw std::runtime_error(name);
}
static ggml_backend_t ggml_backend_init_by_type(int, const char *) {
    point("cpu-call");
    if (control.failure == "cpu-null") return nullptr;
    ++control.created;
    control.cpu.alive = true;
    return &control.cpu;
}
static ggml_backend_t ggml_backend_dev_init(void *, const char *) {
    point("gpu-call");
    if (control.failure == "gpu-null") return nullptr;
    if (control.alias) return &control.cpu;
    ++control.created;
    control.gpu.alive = true;
    return &control.gpu;
}
static void ggml_backend_free(ggml_backend_t backend) {
    assert(backend && backend->alive && !control.scheduler);
    control.events.push_back(backend->id == 1 ? "cpu-free" : "gpu-free");
    backend->alive = false;
    ++control.frees;
}
static void * ggml_backend_get_device(ggml_backend_t) { return nullptr; }
static void * ggml_backend_dev_backend_reg(void *) { return nullptr; }
static void * ggml_backend_reg_get_proc_address(void *, const char *) { return nullptr; }
static void ggml_backend_cpu_set_threadpool(ggml_backend_t, ggml_threadpool *) {}
static const char * ggml_backend_dev_name(void *) { return "controlled"; }
static const char * ggml_backend_name(ggml_backend_t) { return "controlled"; }
static ggml_backend_buffer_type_t ggml_backend_get_default_buffer_type(ggml_backend_t) {
    point("buffer-type");
    return nullptr;
}
static std::string mtmd_format(const char *, ...) { return "controlled backend failure"; }
static size_t ggml_tensor_overhead() { return 8; }
static size_t ggml_graph_overhead_custom(int, bool) { return 8; }
static ggml_backend_sched_t ggml_backend_sched_new(ggml_backend_t *, void **, size_t, int, bool, bool) {
    point("scheduler-new");
    assert(!control.scheduler);
    control.scheduler = true;
    return reinterpret_cast<void *>(1);
}
static void ggml_backend_sched_set_eval_callback(ggml_backend_sched_t, ggml_backend_sched_eval_callback, void *) {
    point("scheduler-callback");
}
struct scheduler_owner {
    void * value = nullptr;
    void * get() const { return value; }
    void reset(void * next = nullptr) {
        if (value) {
            assert(control.scheduler);
            control.events.push_back("scheduler-free");
            control.scheduler = false;
        }
        value = next;
    }
    ~scheduler_owner() { reset(); }
};
template<class T> struct controlled_vector {
    std::vector<T> values;
    const char * name;
    void push_back(T value) { point(name); values.push_back(value); }
    T * data() { return values.data(); }
    size_t size() { return values.size(); }
};
struct controlled_metadata {
    void resize(size_t) { point("metadata-resize"); }
};
enum { MTMD_FLASH_ATTN_TYPE_AUTO = -1, MTMD_FLASH_ATTN_TYPE_DISABLED = 0 };
enum { MTMD_MODALITY_VISION = 0, MTMD_MODALITY_GEN_AUDIO = 1 };
struct mtmd_model {
    int max_nodes = 8192;
    bool flash_attn_auto = false;
    int modality = MTMD_MODALITY_VISION;
    ~mtmd_model() {
        assert(!control.scheduler && !control.cpu.alive && !control.gpu.alive);
        control.events.push_back("model-free");
    }
};
struct mtmd_subctx_params {
    int flash_attn_type = MTMD_FLASH_ATTN_TYPE_AUTO;
    bool warmup = true;
};
static std::shared_ptr<ggml_threadpool> shared_pool;
static std::shared_ptr<ggml_threadpool> mtmd_threadpool_init(int n_threads) {
    point("threadpool");
    assert(n_threads == 4);
    return shared_pool;
}
struct batch {};
struct mtmd_backends {
    ggml_backend_t backend = nullptr, backend_cpu = nullptr;
    controlled_vector<ggml_backend_t> ptrs{{}, "backend-vector"};
    controlled_vector<void *> bufts{{}, "buffer-vector"};
    std::shared_ptr<ggml_threadpool> threadpool;
    scheduler_owner sched;
    mtmd_backends(ggml_backend_dev_t, int, int, ggml_backend_sched_eval_callback, void *);
    ~mtmd_backends();
};
struct mtmd_subcontext {
    const mtmd_model & model;
    mtmd_backends & backends;
    int max_nodes;
    int flash_attn_type;
    bool debug_output_embeddings = false;
    controlled_metadata buf_compute_meta;
    bool support_batch = false;
    mtmd_subcontext(const mtmd_model &, mtmd_backends &, const mtmd_subctx_params &);
    batch get_dummy_batch() { point("dummy-batch"); return {}; }
    void warmup(const batch &) { assert(backends.sched.get()); point("warmup"); }
};
struct builder {
    bool support_batch() { point("support-batch"); return true; }
};
static std::unique_ptr<builder> mtmd_get_graph_builder(mtmd_subcontext *, const batch &) {
    point("graph-builder");
    return std::make_unique<builder>();
}

@ACTUAL_BODIES@

static void run(const char * failure, bool cpu_only = false, bool alias = false, bool gen = false, bool do_warmup = true) {
    control = {};
    control.failure = failure;
    control.alias = alias;
    bool caught = false;
    {
        mtmd_model model;
        model.modality = gen ? MTMD_MODALITY_GEN_AUDIO : MTMD_MODALITY_VISION;
        mtmd_subctx_params params;
        params.warmup = do_warmup;
        auto pool = std::make_shared<ggml_threadpool>();
        shared_pool = pool;
        try {
            mtmd_backends owner(cpu_only ? nullptr : reinterpret_cast<void *>(1), 4, model.max_nodes, [] {}, nullptr);
            assert(owner.threadpool == pool && pool.use_count() == 3);
            try {
                mtmd_subcontext context(model, owner, params);
                assert(!*failure);
                assert(context.flash_attn_type == MTMD_FLASH_ATTN_TYPE_DISABLED);
                assert(context.model.max_nodes == context.max_nodes);
                if (!gen) assert(context.support_batch);
            } catch (const std::runtime_error &) {
                // A borrowed subcontext must never release the completed owner.
                assert(control.scheduler && control.cpu.alive && control.frees == 0);
                control.failure.clear();
                mtmd_subcontext recovered(model, owner, params);
                assert(control.scheduler && control.cpu.alive && control.frees == 0);
                throw;
            }
        } catch (const std::runtime_error &) {
            caught = true;
        }
        assert(caught == bool(*failure));
        assert(pool.use_count() == 2);
        assert(!control.scheduler && !control.cpu.alive && !control.gpu.alive);
        assert(control.frees == control.created);
        if (!*failure) {
            const bool warmed = std::find(control.events.begin(), control.events.end(), "warmup") != control.events.end();
            assert(warmed == do_warmup); // GEN now follows the upstream warmup request too.
        }
        shared_pool.reset();
    }
    assert(control.events.back() == "model-free");
}
int main() {
    for (const char * failure : {"threadpool", "cpu-call", "cpu-null", "gpu-call", "gpu-null", "backend-vector",
                                 "buffer-type", "buffer-vector", "scheduler-new", "scheduler-callback",
                                 "metadata-resize", "dummy-batch", "graph-builder", "support-batch", "warmup"}) {
        run(failure);
    }
    run("", false, false);
    run("", true, false);
    run("", false, true);
    run("warmup", false, true);
    run("", false, false, true);
    run("", false, false, true, false);
    run("", false, false, false, false);
    return 0;
}
