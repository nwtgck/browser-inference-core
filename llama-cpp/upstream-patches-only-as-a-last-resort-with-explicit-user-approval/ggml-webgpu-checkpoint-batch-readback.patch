+// Blocking checkpoint provider. Included after the getter/helpers so its
+// buffer identity, offset, allocation and blocking MapAsync path are shared.
+#include "ggml-backend-tensor-get-batch.h"
+#include "ggml-webgpu-batch-readback-geometry.hpp"
+static_assert(batch_readback::max_requests == GGML_BACKEND_TENSOR_GET_BATCH_V1_MAX_REQUESTS);
+static_assert(batch_readback::staging_cap == GGML_BACKEND_TENSOR_GET_BATCH_V1_MAX_BYTES);
+
+static bool ggml_backend_webgpu_try_tensor_get_batch_v1(
+    const ggml_backend_tensor_get_request_v1 * requests, size_t count) {
+    using namespace batch_readback;
+    if (count == 0) return true;
+    if (!requests || count > max_requests) return false;
+    std::array<range, max_requests> ranges{};
+    std::array<ggml_backend_webgpu_buffer_context *, max_requests> sources{};
+    std::array<uint8_t *, max_requests> destinations{};
+    webgpu_global_context global;
+    // All requests are checked before allocation, encoding or host writes.
+    for (size_t i = 0; i < count; ++i) {
+        const auto & request = requests[i];
+        if (request.size == 0) continue;
+        if (request.size > staging_cap) return false;
+        if (!request.tensor || !request.tensor->data || !request.data || request.offset > ggml_nbytes(request.tensor) ||
+            request.size > ggml_nbytes(request.tensor) - request.offset) return false;
+        const uintptr_t destination = reinterpret_cast<uintptr_t>(request.data);
+        if (request.size > std::numeric_limits<uintptr_t>::max() - destination) return false;
+        auto * buffer = request.tensor->view_src ? request.tensor->view_src->buffer : request.tensor->buffer;
+        if (!buffer || buffer->iface.get_tensor != ggml_backend_webgpu_buffer_get_tensor) return false;
+        auto * source = static_cast<ggml_backend_webgpu_buffer_context *>(buffer->context);
+        if (!source || !source->global_ctx || !source->buffer ||
+            (source->buffer.GetUsage() & wgpu::BufferUsage::CopySrc) == wgpu::BufferUsage::None) return false;
+        if (global && global != source->global_ctx) return false;
+        global = source->global_ctx;
+        const auto * root = request.tensor->view_src ? request.tensor->view_src : request.tensor;
+        const uintptr_t root_data = reinterpret_cast<uintptr_t>(root->data);
+        const uintptr_t pointer_base = reinterpret_cast<uintptr_t>(webgpu_ptr_base);
+        if (root_data < pointer_base ||
+            request.tensor->view_offs > std::numeric_limits<size_t>::max() - (root_data - pointer_base)) return false;
+        const size_t base = ggml_webgpu_tensor_offset(request.tensor);
+        if (request.offset > std::numeric_limits<size_t>::max() - base) return false;
+        const size_t offset = base + request.offset, physical = source->buffer.GetSize();
+        if (offset > physical || request.size > physical - offset) return false;
+        const size_t copy_size = (offset % 4 + request.size + 3) & ~size_t(3);
+        if (copy_size > staging_cap) return false;
+        const size_t end = offset + request.size;
+        const size_t padding = (4 - end % 4) % 4;
+        if (padding > physical - end) return false;
+        ranges[i] = {offset, request.size};
+        sources[i] = source;
+        destinations[i] = static_cast<uint8_t *>(request.data);
+    }
+    if (!global) return true;
+    std::lock_guard<std::recursive_mutex> lock(global->mutex);
+    cursor position;
+    while (position.request < count) {
+        const plan current = next(ranges.data(), count, position);
+        if (!current.count) break; // The remaining requests were empty.
+        GGML_ASSERT(current.bytes > 0 && current.bytes <= staging_cap && current.bytes % 4 == 0);
+        if (!global->get_tensor_staging_buf || global->get_tensor_staging_buf.GetSize() < current.bytes) {
+            if (global->get_tensor_staging_buf) global->get_tensor_staging_buf.Destroy();
+            ggml_webgpu_create_buffer(global->device, global->get_tensor_staging_buf, current.bytes,
+                                     wgpu::BufferUsage::CopyDst | wgpu::BufferUsage::MapRead, "batch_get_staging");
+        }
+        auto encoder = global->device.CreateCommandEncoder();
+        for (size_t i = 0; i < current.count; ++i) {
+            const auto & part = current.pieces[i];
+            encoder.CopyBufferToBuffer(sources[part.request]->buffer, part.source_offset,
+                                      global->get_tensor_staging_buf, part.slot, part.copy_size);
+        }
+        auto commands = encoder.Finish();
+        global->queue.Submit(1, &commands);
+        ggml_backend_webgpu_map_buffer(global, global->get_tensor_staging_buf, wgpu::MapMode::Read, 0, current.bytes);
+        bool okay = true;
+        try {
+            for (size_t i = 0; i < current.count && okay; ++i) {
+                const auto & part = current.pieces[i];
+                const auto copies = scatter(part);
+                uint8_t scratch[8];
+                for (size_t j = 0; j < copies.count; ++j) {
+                    const auto & copy = copies.slices[j];
+                    GGML_ASSERT(copy.mapped_offset % 8 == 0 && copy.mapped_size % 4 == 0);
+                    uint8_t * final = destinations[part.request] + part.request_offset + copy.destination_offset;
+                    void * target = copy.direct ? static_cast<void *>(final) : static_cast<void *>(scratch);
+                    if (global->get_tensor_staging_buf.ReadMappedRange(copy.mapped_offset, target, copy.mapped_size) != wgpu::Status::Success) {
+                        okay = false;
+                        break;
+                    }
+                    if (!copy.direct) std::memcpy(final, scratch + copy.source_skip, copy.size);
+                }
+            }
+        } catch (...) {
+            global->get_tensor_staging_buf.Unmap();
+            throw;
+        }
+        global->get_tensor_staging_buf.Unmap();
+        if (!okay) GGML_ABORT("ggml_webgpu: reading mapped batch data failed");
+    }
+    return true;
+}
