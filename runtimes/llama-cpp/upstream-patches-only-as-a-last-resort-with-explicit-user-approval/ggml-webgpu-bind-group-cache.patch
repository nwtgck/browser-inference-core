+// Retain exact bind groups by dispatch position across repeated graph encodes.
+// This bounds entry count, not the size of resources retained by WebGPU objects.
+struct webgpu_bind_group_cache {
+    static constexpr size_t max_slots = 8192;
+    static constexpr size_t max_buffer_entries = 16;
+
+    struct binding {
+        uint32_t binding_index;
+        wgpu::Buffer buffer;
+        uint64_t offset;
+        uint64_t size;
+    };
+    struct slot {
+        wgpu::ComputePipeline pipeline;
+        uint32_t group_index = 0;
+        std::vector<binding> bindings;
+        wgpu::BindGroup group;
+    };
+
+    std::vector<slot> slots;
+    size_t cursor = 0;
+    uint64_t generation = 0;
+
+    void check_generation(uint64_t current_generation) {
+        if (generation != current_generation) {
+            slots.clear();
+            generation = current_generation;
+        }
+    }
+
+    void begin_graph(uint64_t current_generation) {
+        check_generation(current_generation);
+        cursor = 0;
+    }
+
+    void end_graph() {
+        if (cursor < slots.size()) {
+            slots.resize(cursor);
+        }
+    }
+
+    static wgpu::BindGroup create(wgpu::Device & device,
+                                   const wgpu::ComputePipeline & pipeline,
+                                   uint32_t group_index,
+                                   const std::vector<wgpu::BindGroupEntry> & entries,
+                                   const char * label) {
+        wgpu::BindGroupDescriptor descriptor;
+        descriptor.layout = pipeline.GetBindGroupLayout(group_index);
+        descriptor.entryCount = entries.size();
+        descriptor.entries = entries.data();
+        descriptor.label = label;
+        return device.CreateBindGroup(&descriptor);
+    }
+
+    wgpu::BindGroup get(wgpu::Device & device,
+                         const wgpu::ComputePipeline & pipeline,
+                         uint32_t group_index,
+                         const std::vector<wgpu::BindGroupEntry> & entries,
+                         const char * label,
+                         uint64_t current_generation) {
+        check_generation(current_generation);
+        const size_t position = cursor;
+        if (cursor < max_slots) {
+            ++cursor;
+        }
+
+        bool cacheable = position < max_slots && entries.size() <= max_buffer_entries && pipeline;
+        for (const auto & entry : entries) {
+            if (entry.nextInChain || !entry.buffer || entry.sampler || entry.textureView) {
+                cacheable = false;
+                break;
+            }
+        }
+        if (!cacheable) {
+            if (position < slots.size()) {
+                slots[position] = {};
+            }
+            return create(device, pipeline, group_index, entries, label);
+        }
+
+        if (position < slots.size()) {
+            const slot & cached = slots[position];
+            bool matches = cached.group && cached.pipeline.Get() == pipeline.Get() &&
+                           cached.group_index == group_index && cached.bindings.size() == entries.size();
+            for (size_t i = 0; matches && i < entries.size(); ++i) {
+                const auto & key = cached.bindings[i];
+                const auto & entry = entries[i];
+                matches = key.binding_index == entry.binding && key.buffer.Get() == entry.buffer.Get() &&
+                          key.offset == entry.offset && key.size == entry.size;
+            }
+            if (matches) {
+                return cached.group;
+            }
+        }
+
+        slot replacement;
+        replacement.pipeline = pipeline;
+        replacement.group_index = group_index;
+        replacement.bindings.reserve(entries.size());
+        for (const auto & entry : entries) {
+            replacement.bindings.push_back({ entry.binding, entry.buffer, entry.offset, entry.size });
+        }
+        replacement.group = create(device, pipeline, group_index, entries, label);
+        if (!replacement.group) {
+            if (position < slots.size()) {
+                slots[position] = {};
+            }
+            return replacement.group;
+        }
+        if (position >= slots.size()) {
+            slots.resize(position + 1);
+        }
+        slots[position] = std::move(replacement);
+        return slots[position].group;
+    }
+};
+
