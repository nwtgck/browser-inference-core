+#pragma once
+#include "ggml-impl.h"
+#include <cstdint>
+
+struct router_tail_plan {
+    ggml_tensor * probs = nullptr;
+    ggml_tensor * ids = nullptr;
+    ggml_tensor * gather = nullptr;
+    ggml_tensor * flattened = nullptr;
+    ggml_tensor * sum = nullptr;
+    ggml_tensor * clamp = nullptr;
+    ggml_tensor * div = nullptr;
+    ggml_tensor * output = nullptr;
+    uint64_t probs_bytes = 0, ids_bytes = 0, output_bytes = 0;
+    uint32_t experts = 0, used = 0, tokens = 0, ids_stride = 0;
+};
+
+// Validate logical spans before ggml_nbytes or WGSL narrowing. Higher axes can
+// have padding, but may not overlap; dense tensors have the canonical strides.
+inline bool router_tail_span(const ggml_tensor * tensor, ggml_type type, bool dense, uint64_t & bytes) {
+    bytes = 0;
+    if (!tensor || tensor->type != type || (type != GGML_TYPE_F32 && type != GGML_TYPE_I32) || tensor->nb[0] != 4) { return false; }
+    constexpr uint64_t max_bytes = uint64_t(UINT32_MAX) * 4;
+    uint64_t count = 1, span = 4;
+    for (int axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+        if (tensor->ne[axis] <= 0 || uint64_t(tensor->ne[axis]) > UINT32_MAX ||
+            tensor->nb[axis] % 4 || tensor->nb[axis] < span || tensor->nb[axis] > max_bytes ||
+            (dense && tensor->nb[axis] != count * 4) || uint64_t(tensor->ne[axis]) > UINT32_MAX / count) { return false; }
+        const uint64_t extra = uint64_t(tensor->ne[axis]) - 1;
+        if (extra > (max_bytes - span) / tensor->nb[axis]) { return false; }
+        span += extra * tensor->nb[axis];
+        count *= uint64_t(tensor->ne[axis]);
+    }
+    bytes = span;
+    return true;
+}
+
+inline bool router_tail_shape(const ggml_tensor * tensor, int64_t a, int64_t b, int64_t c, int64_t d) {
+    return tensor && tensor->ne[0] == a && tensor->ne[1] == b && tensor->ne[2] == c && tensor->ne[3] == d;
+}
+
+inline bool plan_router_tail(const ggml_cgraph * graph, int index, router_tail_plan & plan) {
+    plan = {};
+    if (!graph || index < 0 || index >= graph->n_nodes || graph->n_nodes - index < 6) { return false; }
+    ggml_tensor * node[6];
+    for (int i = 0; i < 6; ++i) { node[i] = graph->nodes[index + i]; if (!node[i]) { return false; } }
+    auto * gather = node[0]; auto * flattened = node[1]; auto * sum = node[2];
+    auto * clamp = node[3]; auto * div = node[4]; auto * output = node[5];
+    auto * probs = gather->src[0]; auto * ids = gather->src[1];
+    if (!probs || !ids || gather->view_src || sum->view_src || clamp->view_src || div->view_src ||
+        gather->view_offs || sum->view_offs || clamp->view_offs || div->view_offs ||
+        flattened->src[0] != gather || flattened->view_src != gather || flattened->view_offs ||
+        sum->src[0] != flattened || clamp->src[0] != sum ||
+        div->src[0] != flattened || div->src[1] != clamp ||
+        output->src[0] != div || output->view_src != div || output->view_offs) { return false; }
+    for (int i = 0; i < 6; ++i) {
+        if (probs == node[i] || ids == node[i]) { return false; }
+        for (int s = (i == 0 || i == 4 ? 2 : 1); s < GGML_MAX_SRC; ++s) {
+            if (node[i]->src[s]) { return false; }
+        }
+    }
+    uint64_t probs_bytes, ids_bytes, output_bytes, ignored;
+    if (!router_tail_span(probs, GGML_TYPE_F32, true, probs_bytes) ||
+        !router_tail_span(ids, GGML_TYPE_I32, false, ids_bytes) ||
+        probs->ne[0] != 1 || probs->ne[3] != 1 || ids->ne[2] != 1 || ids->ne[3] != 1 ||
+        ids->ne[0] > probs->ne[1] || ids->ne[1] != probs->ne[2]) { return false; }
+    const int64_t experts = probs->ne[1], used = ids->ne[0], tokens = ids->ne[1];
+    if (!router_tail_shape(gather, 1, used, tokens, 1) || !router_tail_shape(flattened, used, tokens, 1, 1) ||
+        !router_tail_shape(sum, 1, tokens, 1, 1) || !router_tail_shape(clamp, 1, tokens, 1, 1) ||
+        !router_tail_shape(div, used, tokens, 1, 1) || !router_tail_shape(output, 1, used, tokens, 1)) { return false; }
+    for (auto * tensor : node) {
+        if (!router_tail_span(tensor, GGML_TYPE_F32, true, ignored)) { return false; }
+    }
+    if (!router_tail_span(output, GGML_TYPE_F32, true, output_bytes) || ids->nb[1] / 4 > UINT32_MAX) { return false; }
+    const float low = ggml_get_op_params_f32(clamp, 0), high = ggml_get_op_params_f32(clamp, 1);
+    if (!(low <= high)) { return false; }
+    const int indices[] = { index, index + 1, index + 2, index + 3, index + 4, index + 5 };
+    const ggml_op ops[] = { GGML_OP_GET_ROWS, GGML_OP_RESHAPE, GGML_OP_SUM_ROWS, GGML_OP_CLAMP, GGML_OP_DIV, GGML_OP_RESHAPE };
+    const int outputs[] = { index + 5 };
+    // Includes COMPUTE, OUTPUT, outside users and intermediate parent-view checks.
+    // Full raw adjacency also preserves scheduler callback/subgraph boundaries.
+    if (!ggml_can_fuse_subgraph_ext(graph, indices, 6, ops, outputs, 1)) { return false; }
+    plan = { probs, ids, gather, flattened, sum, clamp, div, output, probs_bytes, ids_bytes, output_bytes,
+             uint32_t(experts), uint32_t(used), uint32_t(tokens), uint32_t(ids->nb[1] / 4) };
+    return true;
+}
+
+inline bool router_tail_disjoint(uint64_t a, uint64_t an, uint64_t b, uint64_t bn) {
+    return an && bn && (a <= b ? an <= b - a : bn <= a - b);
+}
