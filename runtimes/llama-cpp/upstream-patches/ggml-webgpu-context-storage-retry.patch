 /* GGML Backend Buffer Type Interface */
 
+static thread_local ggml_webgpu_context_storage_status * webgpu_context_storage = nullptr;
+
+static ggml_webgpu_context_storage_status * ggml_webgpu_exchange_context_storage(
+        ggml_webgpu_context_storage_status * next) {
+    return std::exchange(webgpu_context_storage, next);
+}
+
+static bool ggml_webgpu_drain_context_storage(ggml_backend_dev_t dev) {
+    auto * ctx = static_cast<ggml_backend_webgpu_device_context *>(dev->context);
+    auto & global = *ctx->webgpu_global_ctx;
+    auto & control = global.optional_device->control;
+    if (!control.healthy()) {
+        return false;
+    }
+    struct completion {
+        std::atomic<bool> done{false};
+        wgpu::QueueWorkDoneStatus status = wgpu::QueueWorkDoneStatus::Error;
+    };
+    using ticket = std::shared_ptr<completion>;
+    try {
+        const auto state = std::make_shared<completion>();
+        // The callback owns its ticket even if the future does not complete
+        // during this wait. Never hand WebGPU a pointer into the caller stack.
+        auto callback = [](wgpu::QueueWorkDoneStatus status, wgpu::StringView, ticket * pending) noexcept {
+            const std::unique_ptr<ticket> owner(pending);
+            (*owner)->status = status;
+            (*owner)->done.store(true, std::memory_order_release);
+        };
+        const auto future = global.queue.OnSubmittedWorkDone(
+            wgpu::CallbackMode::WaitAnyOnly, callback, new ticket(state));
+        if (future.id && global.instance.WaitAny(future, WEBGPU_RUNTIME_WAIT_TIMEOUT_NS) == wgpu::WaitStatus::Success &&
+            state->done.load(std::memory_order_acquire) && state->status == wgpu::QueueWorkDoneStatus::Success &&
+            control.healthy()) {
+            return true;
+        }
+    } catch (...) {
+        // A failed or indeterminate wait cannot certify memory for reload.
+    }
+    control.terminal.store(true, std::memory_order_release);
+    return false;
+}
+
+static const ggml_webgpu_context_storage_v1 * ggml_webgpu_context_storage() {
+    static const ggml_webgpu_context_storage_v1 functions{
+        ggml_webgpu_exchange_context_storage, ggml_webgpu_drain_context_storage,
+    };
+    return &functions;
+}
+
+// The issue interval contains only buffer creation. In particular the error
+// scopes are popped before yielding to JSPI and before a caller can use a
+// non-null Dawn error buffer.
+template<class Allocate>
+static auto ggml_webgpu_checked_create(webgpu_global_context_struct & global, Allocate allocate) {
+    using resource_type = decltype(allocate());
+    struct ops {
+        using Pipeline = resource_type;
+        webgpu_global_context_struct & global;
+        Allocate & run;
+        std::exception_ptr exception;
+
+        uint64_t now_ns() const noexcept {
+            return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count());
+        }
+        void push(wgpu::ErrorFilter filter) { global.device.PushErrorScope(filter); }
+        Pipeline create() {
+            try {
+                return run();
+            } catch (...) {
+                exception = std::current_exception();
+                return {};
+            }
+        }
+        wgpu::Future pop(wgpu::CallbackMode mode,
+                        void (*callback)(wgpu::PopErrorScopeStatus, wgpu::ErrorType, wgpu::StringView,
+                                         ggml_webgpu_optional::Ticket *) noexcept,
+                        ggml_webgpu_optional::Ticket * ticket) {
+            return global.device.PopErrorScope(mode, callback, ticket);
+        }
+        wgpu::WaitStatus wait(wgpu::Future future, uint64_t timeout) { return global.instance.WaitAny(future, timeout); }
+        bool valid(const Pipeline &) { return true; }
+    } api{global, allocate, {}};
+
+    using namespace ggml_webgpu_optional;
+    auto result = create_optional(api, global.optional_device->control, WEBGPU_RUNTIME_WAIT_TIMEOUT_NS,
+                                  false, WaitBudget::after_issue);
+    if (api.exception) {
+        result.host_exception = api.exception;
+    }
+    return result;
+}
+
+template<class Resource>
+static bool ggml_webgpu_is_pure_oom(const ggml_webgpu_optional::Attempt<Resource> & result) {
+    return !result.host_exception && result.outcome == ggml_webgpu_optional::Outcome::rejected &&
+        result.scopes[0]->error == wgpu::ErrorType::NoError &&
+        result.scopes[1]->error == wgpu::ErrorType::NoError &&
+        result.scopes[2]->error == wgpu::ErrorType::OutOfMemory;
+}
+
+template<class Allocate>
+static auto ggml_webgpu_allocate_context_resource(webgpu_global_context_struct & global, ggml_backend_dev_t device,
+                                                   Allocate allocate) {
+    auto * status = webgpu_context_storage;
+    if (!status || status->device != device) {
+        return allocate();
+    }
+    auto result = ggml_webgpu_checked_create(global, allocate);
+    if (!result.host_exception && result.outcome == ggml_webgpu_optional::Outcome::ready && result.pipeline) {
+        return std::move(result.pipeline);
+    }
+    const bool oom = ggml_webgpu_is_pure_oom(result);
+    status->out_of_memory |= oom;
+    status->other_failure |= !oom;
+    return decltype(allocate()){};
+}
