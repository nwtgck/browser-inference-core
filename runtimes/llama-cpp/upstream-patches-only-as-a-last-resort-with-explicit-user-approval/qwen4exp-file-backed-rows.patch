+
+bool lcb_qwen4exp_has_file_backed_source(const llama_model * model) {
+    return model && model->arch == LLM_ARCH_QWEN4EXP &&
+        bool(static_cast<const llama_model_qwen4exp *>(model)->file_backed_ple);
+}
+
+void lcb_qwen4exp_resolve_file_backed_source(llama_model * model, const std::vector<std::string> & paths, int single_source_fd) {
+    if (lcb_qwen4exp_has_file_backed_source(model)) {
+        static_cast<llama_model_qwen4exp *>(model)->file_backed_ple->resolve_shard(paths, single_source_fd);
+    }
+}
+
+// Synchronous metadata query for consumers; never touches row data or the GPU.
+extern "C" int32_t lcb_qwen4exp_file_backed_shard(const llama_model * model) {
+    if (!model || model->arch != LLM_ARCH_QWEN4EXP) return -1;
+    const auto & reader = static_cast<const llama_model_qwen4exp *>(model)->file_backed_ple;
+    return reader ? reader->shard() : -1;
+}
