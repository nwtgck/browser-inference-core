+void sd_set_graph_diagnostics(bool enabled) {
+    if (!enabled) {
+        sd_graph_diagnostics_active = 0;
+        return;
+    }
+    if (++sd_graph_diagnostics_serial == 0) ++sd_graph_diagnostics_serial;
+    sd_graph_diagnostics_active = sd_graph_diagnostics_serial;
+}
+
+uint64_t sd_graph_diagnostics_epoch() {
+    return sd_log_cb != nullptr ? sd_graph_diagnostics_active : 0;
