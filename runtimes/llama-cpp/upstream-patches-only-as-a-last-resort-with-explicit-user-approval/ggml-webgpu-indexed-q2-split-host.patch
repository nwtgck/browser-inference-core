+static bool ggml_webgpu_q2_indexed_float_span(const ggml_tensor * tensor, uint64_t alignment, uint64_t binding) {
+    if (tensor->nb[0] != 4 || tensor->view_offs % 4) {
+        return false;
+    }
+    uint64_t bytes = tensor->view_src ? alignment : 4;
+    for (int dim = 0; dim < GGML_MAX_DIMS; ++dim) {
+        if (tensor->ne[dim] <= 0 || tensor->nb[dim] % 4 || tensor->nb[dim] / 4 > UINT32_MAX || bytes > binding) {
+            return false;
+        }
+        const uint64_t count = tensor->ne[dim] - 1;
+        const uint64_t stride = tensor->nb[dim];
+        if (stride && count > (binding - bytes) / stride) {
+            return false;
+        }
+        bytes += count * stride;
+    }
+    return true;
+}
