+static bool ggml_webgpu_ssm_conv_silu_binding(webgpu_context & ctx, const ggml_tensor * tensor,
+                                              uint64_t bytes, webgpu_ssm_conv_silu_binding & binding) {
+    auto * buffer = tensor->buffer;
+    if (!buffer || !buffer->context || buffer->iface.get_base != ggml_backend_webgpu_buffer_get_base || !tensor->data) { return false; }
+    auto * buffer_ctx = (ggml_backend_webgpu_buffer_context *) buffer->context;
+    if (buffer_ctx->global_ctx != ctx->global_ctx || !buffer_ctx->buffer ||
+        (buffer_ctx->buffer.GetUsage() & wgpu::BufferUsage::Storage) == wgpu::BufferUsage::None) { return false; }
+    const auto * root = tensor->view_src ? tensor->view_src : tensor;
+    if (root->view_src || root->view_offs || root->buffer != buffer || !root->data) { return false; }
+    const uint64_t base = reinterpret_cast<uintptr_t>(ggml_backend_webgpu_buffer_get_base(buffer));
+    const uint64_t root_data = reinterpret_cast<uintptr_t>(root->data);
+    if (root_data < base || tensor->view_offs > UINT64_MAX - root_data ||
+        reinterpret_cast<uintptr_t>(tensor->data) != root_data + tensor->view_offs) { return false; }
+    uint64_t root_bytes;
+    if (!ssm_conv_silu_layout(root, false, root_bytes) ||
+        tensor->view_offs > root_bytes || bytes > root_bytes - tensor->view_offs) { return false; }
+    const uint64_t alignment = ctx->global_ctx->capabilities.limits.minStorageBufferOffsetAlignment;
+    if (alignment < 4 || (alignment & (alignment - 1))) { return false; }
+    const uint64_t offset = ggml_webgpu_tensor_offset(tensor);
+    if (offset % 4 || offset > buffer->size || bytes > buffer->size - offset ||
+        offset > buffer_ctx->buffer.GetSize() || bytes > buffer_ctx->buffer.GetSize() - offset) { return false; }
+    const uint64_t aligned_offset = offset & ~(alignment - 1);
+    const uint64_t size = offset - aligned_offset + bytes;
+    if (!size || size > ctx->global_ctx->capabilities.limits.maxStorageBufferBindingSize ||
+        size / 4 > UINT32_MAX) { return false; }
+    binding = { buffer_ctx->buffer, aligned_offset, size, offset, bytes };
+    return true;
+}
