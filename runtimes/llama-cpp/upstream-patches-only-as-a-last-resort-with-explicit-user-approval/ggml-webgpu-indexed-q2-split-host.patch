+static bool ggml_webgpu_q2_0_indexed_supported(ggml_backend_dev_t dev, const ggml_tensor * op,
+                                             const webgpu_global_context & global) {
+    const auto & limits = global->capabilities.limits;
+    const auto * weight = op->src[0];
+    const auto * input = op->src[1];
+    const auto * ids = op->src[2];
+    if (!input || !ids || input->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32 ||
+        op->type != GGML_TYPE_F32 || op->view_src || !ggml_is_contiguous(op) ||
+        input->ne[0] != weight->ne[0] || input->ne[1] <= 0 || input->ne[2] != op->ne[2] || input->ne[3] != 1 ||
+        ids->ne[0] != op->ne[1] || ids->ne[1] != op->ne[2] || ids->ne[2] != 1 || ids->ne[3] != 1 ||
+        op->ne[0] != weight->ne[1] || op->ne[1] <= 0 || op->ne[2] <= 0 || op->ne[3] != 1 ||
+        op->ne[1] % input->ne[1] != 0) {
+        return false;
+    }
+    const auto windows = ggml_webgpu_q2_weight_windows(weight, limits);
+    if (!windows) {
+        return false;
+    }
+
+    const auto source_precision = ggml_prec_get_src(op, 1);
+    const auto accumulate_precision = ggml_prec_get_acc(op);
+    const bool vector = op->ne[2] == 1;
+    if ((source_precision != GGML_PREC_UNDEFINED && source_precision != GGML_PREC_F16 &&
+         source_precision != GGML_PREC_Q8 && source_precision != GGML_PREC_Q4) ||
+        (accumulate_precision != GGML_PREC_UNDEFINED && accumulate_precision != GGML_PREC_F16 &&
+         !(vector && (accumulate_precision == GGML_PREC_F32 || accumulate_precision == GGML_PREC_BF16)))) {
+        return false;
+    }
+
+    constexpr uint64_t tile_m = WEBGPU_MUL_MAT_TILE_M * WEBGPU_MUL_MAT_WG_SIZE_M;
+    constexpr uint64_t tile_n = WEBGPU_MUL_MAT_TILE_N * WEBGPU_MUL_MAT_WG_SIZE_N;
+    constexpr uint64_t matrix_shared = WEBGPU_MUL_MAT_REG_TILE_K_QUANT * (tile_m + tile_n) * sizeof(ggml_fp16_t) +
+                                       2 * tile_n * sizeof(uint32_t);
+    constexpr uint64_t vector_shared = WEBGPU_MUL_MAT_VEC_WG_SIZE * WEBGPU_MUL_MAT_VEC_K_Q_OUTPUTS_PER_WG * sizeof(float);
+    const uint64_t experts = weight->ne[2];
+    const uint64_t shared = limits.maxComputeWorkgroupStorageSize;
+    const uint32_t matrix_storage_bindings = windows->second ? 6 : 5;
+    // Check resources for both matrix prefill and vector decode on the selected device.
+    if (limits.maxComputeInvocationsPerWorkgroup < WEBGPU_MUL_MAT_VEC_WG_SIZE ||
+        limits.maxComputeWorkgroupSizeX < WEBGPU_MUL_MAT_VEC_WG_SIZE ||
+        shared < std::max(matrix_shared, vector_shared) || experts > shared / 16 * 4 ||
+        limits.maxStorageBuffersPerShaderStage < matrix_storage_bindings ||
+        limits.maxBindingsPerBindGroup < matrix_storage_bindings + 1 ||
+        limits.maxUniformBuffersPerShaderStage == 0 || limits.maxUniformBufferBindingSize < WEBGPU_PARAMS_BUF_SIZE_BYTES) {
+        return false;
+    }
+
+    const uint64_t alignment = limits.minStorageBufferOffsetAlignment;
+    const uint64_t binding = std::min<uint64_t>({limits.maxStorageBufferBindingSize, limits.maxBufferSize,
+                                                uint64_t{UINT32_MAX}}) & ~UINT64_C(3);
+    for (const auto * tensor : {input, ids, op}) {
+        if (!ggml_webgpu_q2_indexed_float_span(tensor, alignment, binding)) {
+            return false;
+        }
+    }
+
+    const uint64_t used = op->ne[1];
+    const uint64_t tokens = op->ne[2];
+    if (used > UINT32_MAX / tokens) {
+        return false;
+    }
+    const uint64_t slots = used * tokens;
+    const uint64_t active = std::min(experts, slots);
+    const uint64_t tiles = active + (slots - active) / tile_n;
+    const uint64_t rows = op->ne[0];
+    const uint64_t output_tiles = vector ? CEIL_DIV(rows, WEBGPU_MUL_MAT_VEC_K_Q_OUTPUTS_PER_WG) : CEIL_DIV(rows, tile_m);
+    const uint64_t d = limits.maxComputeWorkgroupsPerDimension;
+    if (d == 0 || output_tiles > std::min(d * d, UINT32_MAX - (d - 1)) / (vector ? slots : tiles)) {
+        return false;
+    }
+    const uint64_t tiles_bytes = sizeof(uint32_t) * (1 + 3 * tiles);
+    const uint64_t slots_bytes = sizeof(uint32_t) * slots;
+    const uint64_t destination_size = ggml_nbytes(op) + slots_bytes + tiles_bytes + 2 * alignment;
+    if (ROUNDUP_POW2(destination_size, alignment) > ggml_webgpu_q2_buffer_limit(limits) ||
+        tiles_bytes > binding || slots_bytes > binding) {
+        return false;
+    }
+
+    struct binding_range {
+        wgpu::Buffer buffer;
+        uint64_t offset = 0;
+        uint64_t size = 0;
+    };
+    const ggml_tensor * tensors[] = { weight, input, ids, op };
+    binding_range ranges[4];
+    // Use the root allocation even for views whose data the scheduler has not initialized.
+    for (size_t i = 0; i < 4; ++i) {
+        const auto * tensor = tensors[i];
+        const auto * root = tensor->view_src ? tensor->view_src : tensor;
+        auto * const allocation = root->buffer ? root->buffer : tensor->buffer;
+        if (!allocation) {
+            continue;
+        }
+        if (tensor->buffer && tensor->buffer != allocation) {
+            return false;
+        }
+        if (allocation->iface.get_base != ggml_backend_webgpu_buffer_get_base) {
+            if (allocation->buft && ggml_backend_webgpu_device_supports_buft(dev, allocation->buft)) {
+                return false;
+            }
+            continue; // the scheduler can transfer non-WebGPU inputs
+        }
+        const auto * buffer = static_cast<const ggml_backend_webgpu_buffer_context *>(allocation->context);
+        if (!buffer || !buffer->buffer || buffer->global_ctx != global) {
+            return false;
+        }
+        if (!root->data) {
+            continue;
+        }
+        auto & range = ranges[i];
+        const auto base = reinterpret_cast<uintptr_t>(ggml_backend_webgpu_buffer_get_base(allocation));
+        const auto root_addr = reinterpret_cast<uintptr_t>(root->data);
+        if (root->view_src || root->view_offs || root->buffer != allocation || root_addr < base ||
+            tensor->view_offs > UINTPTR_MAX - root_addr ||
+            (tensor->data && root_addr + tensor->view_offs != reinterpret_cast<uintptr_t>(tensor->data))) {
+            return false;
+        }
+        const uint64_t address = ggml_webgpu_tensor_offset(tensor);
+        if (address % 4 || (tensor == weight && address % alignment)) {
+            return false;
+        }
+        range.buffer = buffer->buffer;
+        range.offset = tensor == weight ? address : ggml_webgpu_tensor_align_offset(tensor, alignment);
+        range.size = tensor == weight ? windows->first + windows->second : address - range.offset + uint64_t(ggml_nbytes(tensor));
+        const uint64_t physical = range.buffer.GetSize();
+        if (range.offset > physical || range.size > physical - range.offset ||
+            (tensor != weight && range.size > binding)) {
+            return false;
+        }
+        if (tensor == op && !vector) {
+            const uint64_t slot_offset = ROUNDUP_POW2(address + ggml_nbytes(op), alignment);
+            const uint64_t tile_offset = ROUNDUP_POW2(slot_offset + slots_bytes, alignment);
+            if (tile_offset > physical || tiles_bytes > physical - tile_offset) {
+                return false;
+            }
+            range.size = tile_offset + tiles_bytes - range.offset;
+        }
+        for (size_t j = 0; j < i; ++j) {
+            const auto & previous = ranges[j];
+            if (range.buffer.Get() != previous.buffer.Get() ||
+                (!vector && tensor == ids && tensors[j] != op)) {
+                continue;
+            }
+            if (range.offset < previous.offset ? range.size > previous.offset - range.offset :
+                                              previous.size > range.offset - previous.offset) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
