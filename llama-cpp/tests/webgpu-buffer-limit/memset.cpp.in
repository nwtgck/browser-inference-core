#include <algorithm>
#include <array>
#include <cassert>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <memory>
#include <mutex>
#include <string>
#include <utility>
#include <vector>

@MACROS@

struct submission {
    std::array<uint32_t, 3> params{};
    uint64_t offset = 0;
    uint64_t size = 0;
    uint32_t x = 0;
    uint32_t y = 0;
};
struct recorder {
    int stage = 0;
    submission pending;
    std::vector<submission> submitted;
};
static recorder trace;
namespace wgpu {
struct Buffer {
    uint64_t bytes = 0;
    unsigned id = 0;
    uint64_t GetSize() const { return bytes; }
};
struct BindGroupEntry {
    uint32_t binding = 0;
    Buffer buffer;
    uint64_t offset = 0;
    uint64_t size = 0;
};
struct BindGroupDescriptor {
    int layout;
    size_t entryCount;
    const BindGroupEntry * entries;
    const char * label;
};
struct BindGroup {};
struct Pipeline {
    int GetBindGroupLayout(unsigned group) const { assert(group == 0); return 1; }
};
struct ComputePassEncoder {
    void SetPipeline(Pipeline) const {}
    void SetBindGroup(unsigned group, BindGroup) const { assert(group == 0); }
    void DispatchWorkgroups(uint32_t x, uint32_t y, uint32_t z) const {
        assert(trace.stage == 2 && z == 1);
        trace.pending.x = x;
        trace.pending.y = y;
        trace.stage = 3;
    }
    void End() const { assert(trace.stage == 3); trace.stage = 4; }
};
struct CommandBuffer {};
struct CommandEncoder {
    ComputePassEncoder BeginComputePass() const { return {}; }
    CommandBuffer Finish() const { assert(trace.stage == 4); return {}; }
};
struct Device {
    BindGroup CreateBindGroup(const BindGroupDescriptor * descriptor) const {
        assert(trace.stage == 1 && descriptor->layout == 1 && descriptor->entryCount == 2);
        const auto & data = descriptor->entries[0];
        const auto & params = descriptor->entries[1];
        assert(data.binding == 0 && data.buffer.id == 1);
        assert(data.offset <= data.buffer.GetSize() && data.size <= data.buffer.GetSize() - data.offset);
        assert(params.binding == 1 && params.buffer.id == 2 && params.offset == 0);
        assert(params.size == WEBGPU_PARAMS_BUF_SIZE_BYTES);
        trace.pending.offset = data.offset;
        trace.pending.size = data.size;
        trace.stage = 2;
        return {};
    }
    CommandEncoder CreateCommandEncoder() const { return {}; }
};
struct Queue {
    void WriteBuffer(Buffer buffer, uint64_t offset, const void * params, size_t bytes) const {
        assert(trace.stage == 0 && buffer.id == 2 && offset == 0 && bytes == 12);
        trace.pending = {};
        std::memcpy(trace.pending.params.data(), params, bytes);
        trace.stage = 1;
    }
    void Submit(size_t count, const CommandBuffer *) const {
        assert(trace.stage == 4 && count == 1);
        trace.submitted.push_back(trace.pending);
        trace.stage = 0;
    }
};
}  // namespace wgpu

struct controlled_context {
    std::recursive_mutex mutex;
    struct {
        struct {
            size_t maxStorageBufferBindingSize = 64;
            size_t maxComputeInvocationsPerWorkgroup = 4;
            size_t minStorageBufferOffsetAlignment = 16;
            uint32_t maxComputeWorkgroupsPerDimension = 2;
        } limits;
    } capabilities;
    wgpu::Queue queue;
    wgpu::Device device;
    wgpu::Buffer memset_params_buf{WEBGPU_PARAMS_BUF_SIZE_BYTES, 2};
    struct {
        wgpu::Pipeline pipeline;
        std::string name = "memset";
    } memset_pipeline;
};
using webgpu_global_context = std::shared_ptr<controlled_context>;

@WORKGROUPS@
@BINDING@
@MEMSET@

int main() {
    auto context = std::make_shared<controlled_context>();
    wgpu::Buffer buffer{256, 1};
    size_t cases = 0;
    bool saw_multiple = false;
    bool saw_2d = false;
    const size_t offsets[] = {0, 1, 2, 3, 15, 16, 63, 64, 65};
    const size_t sizes[] = {0, 1, 2, 3, 4, 17, 64, 129};
    auto check = [&](size_t offset, size_t size) {
        trace = {};
        ggml_backend_webgpu_buffer_memset(context, buffer, UINT32_C(0x13579bdf), offset, size);
        assert(trace.stage == 0);
        if (!size) assert(trace.submitted.empty());
        size_t next = offset;
        size_t remaining = size;
        saw_multiple |= trace.submitted.size() > 1;
        for (const auto & item : trace.submitted) {
            assert(item.offset % 16 == 0 && item.size % 4 == 0 && item.size <= 64);
            assert(item.offset + item.params[0] == next);
            assert(item.params[0] == next % 16);
            assert(item.params[1] > 0 && item.params[1] <= remaining);
            assert(item.params[2] == UINT32_C(0x13579bdf));
            assert(item.params[0] + item.params[1] <= item.size);
            assert(item.size - item.params[0] - item.params[1] < 4);
            assert(item.x > 0 && item.x <= 2 && item.y > 0 && item.y <= 2);
            const size_t words = (size_t(item.params[0]) + item.params[1] + 3) / 4;
            assert(size_t(item.x) * item.y * 4 >= words);
            saw_2d |= item.y > 1;
            next += item.params[1];
            remaining -= item.params[1];
        }
        assert(next == offset + size && remaining == 0);
        ++cases;
    };
    for (size_t offset : offsets) for (size_t size : sizes) check(offset, size);
    check(253, 3);
    assert(cases == 73 && saw_multiple && saw_2d);
    std::printf("{\"cases\":%zu,\"queueOrder\":true,\"multipleChunks\":true,\"dispatch2d\":true,\"passed\":true}\n", cases);
}
