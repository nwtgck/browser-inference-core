+void llama_kv_cache::set_input_relative_positions(ggml_tensor * dst, const llama_ubatch * ubatch, uint32_t n_kv) const {
+    GGML_ASSERT(dst->type == GGML_TYPE_I32 && ggml_is_vector(dst) && ubatch->n_tokens >= 2);
+    const auto stream = seq_to_stream.at(ubatch->seq_id[0][0]);
+    const auto & cells = v_cells.at(stream);
+    GGML_ASSERT(n_kv > 0 && n_kv <= cells.size());
+    const int64_t elements = int64_t(n_kv) + ubatch->n_tokens;
+    GGML_ASSERT(elements <= dst->ne[0]);
+    std::vector<int32_t> data(elements);
+    for (int64_t j = 0; j < n_kv; ++j) {
+        data[j] = cells.is_empty(j) ? -1 : cells.pos_get(j);
+    }
+    for (uint32_t i = 0; i < ubatch->n_tokens; ++i) {
+        GGML_ASSERT(seq_to_stream.at(ubatch->seq_id[i][0]) == stream);
+        data[int64_t(n_kv) + i] = ubatch->pos[i];
+    }
+    ggml_backend_tensor_set(dst, data.data(), 0, data.size() * sizeof(int32_t));
+}
