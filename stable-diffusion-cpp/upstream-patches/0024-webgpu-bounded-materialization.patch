+#ifdef SD_BROWSER_WEBGPU
+// Keep im2col + GEMM on WebGPU when a full spatial expansion exceeds binding
+// limits. This is not VAE image tiling: every output uses its original halo and
+// the same F16 expansion/matmul ordering as ggml_conv_2d. Small/CPU/direct paths
+// are unchanged. Every introduced materialized node must be accepted.
+static ggml_tensor* browser_bounded_conv_2d(ggml_context* ctx, ggml_backend_t backend,
+                                            ggml_tensor* x, ggml_tensor* w,
+                                            int s0, int s1, int p0, int p1, int d0, int d1) {
+    if (!sd_backend_is(backend, "WebGPU") || x->type != GGML_TYPE_F32 ||
+        (w->type != GGML_TYPE_F16 && w->type != GGML_TYPE_F32) ||
+        !ggml_is_contiguous(x) || !ggml_is_contiguous(w) ||
+        s0 <= 0 || s1 <= 0 || d0 <= 0 || d1 <= 0 || p0 < 0 || p1 < 0) {
+        return nullptr;
+    }
+    auto full = ggml_im2col(ctx, w, x, s0, s1, p0, p1, d0, d1, true, GGML_TYPE_F16);
+    if (ggml_backend_supports_op(backend, full) || full->ne[2] <= 1) {
+        return nullptr;
+    }
+    const int64_t ow = full->ne[1], oh = full->ne[2];
+    auto padded = p1 == 0 ? x : ggml_pad_ext(ctx, x, 0, 0, p1, p1, 0, 0, 0, 0);
+    if (padded != x && !ggml_backend_supports_op(backend, padded)) {
+        return nullptr;
+    }
+    const int64_t kernel_rows = (w->ne[1] - 1) * d1 + 1;
+    auto weight = ggml_reshape_2d(ctx, w, w->ne[0] * w->ne[1] * w->ne[2], w->ne[3]);
+    // Bound graph metadata and dispatch count, even on a very small adapter.
+    constexpr int64_t max_stripes = 64;
+    for (int64_t rows = oh / 2; rows > 0 && 1 + (oh - 1) / rows <= max_stripes; rows /= 2) {
+        auto output = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, ow, oh, w->ne[3], x->ne[3]);
+        bool supported = true;
+        for (int64_t begin = 0; begin < oh; begin += rows) {
+            const int64_t count = std::min(rows, oh - begin);
+            const int64_t input_rows = (count - 1) * s1 + kernel_rows;
+            auto input = ggml_view_4d(ctx, padded, padded->ne[0], input_rows, padded->ne[2], padded->ne[3],
+                                       padded->nb[1], padded->nb[2], padded->nb[3], begin * s1 * padded->nb[1]);
+            auto col = ggml_im2col(ctx, w, input, s0, s1, p0, 0, d0, d1, true, GGML_TYPE_F16);
+            auto product = ggml_mul_mat(ctx, ggml_reshape_2d(ctx, col, col->ne[0], ow * count * x->ne[3]), weight);
+            auto shaped = ggml_reshape_4d(ctx, product, ow, count, x->ne[3], w->ne[3]);
+            auto chunk = ggml_cont(ctx, ggml_permute(ctx, shaped, 0, 1, 3, 2));
+            // Chained SET nodes serialize ownership of one final output; no
+            // full-output copy/concatenation is repeated for each stripe.
+            auto merged = ggml_set_inplace(ctx, output, chunk, output->nb[1], output->nb[2], output->nb[3],
+                                            begin * output->nb[1]);
+            if (!ggml_backend_supports_op(backend, col) || !ggml_backend_supports_op(backend, product) ||
+                !ggml_backend_supports_op(backend, chunk) || !ggml_backend_supports_op(backend, merged)) {
+                supported = false;
+                break;
+            }
+            output = merged;
+        }
+        if (supported) {
+            ggml_set_name(output, "browser.bounded_conv_2d");
+            return output;
+        }
+    }
+    return nullptr;
+}
