+#pragma once
+
+#include "ggml-webgpu-fusion-view-sources.hpp"
+
+#include <algorithm>
+#include <array>
+#include <optional>
+
+namespace webgpu_loop_controller {
+
+inline constexpr int gate_count = 64;
+inline constexpr int output_count = 2304;
+inline constexpr int operations = 8;
+inline constexpr uint32_t workgroup = 256;
+inline constexpr uint32_t workgroups = output_count / 4;
+
+struct plan {
+    ggml_tensor * forget;
+    ggml_tensor * gain;
+    const ggml_tensor * cur;
+    const ggml_tensor * message;
+    const ggml_tensor * output;
+};
+
+inline bool dense(const ggml_tensor * node, int64_t columns, int64_t rows = 1) {
+    return node && node->type == GGML_TYPE_F32 && node->ne[0] == columns && node->ne[1] == rows &&
+           node->ne[2] == 1 && node->ne[3] == 1 && node->nb[0] == sizeof(float) &&
+           (rows == 1 || node->nb[1] == columns * sizeof(float)) && ggml_is_contiguous(node);
+}
+
+inline std::optional<plan> match(const ggml_cgraph & graph, int first, webgpu_fusion_view_sources & views) {
+    if (first < 0 || first > graph.n_nodes - operations) { return std::nullopt; }
+    const auto nodes = graph.nodes + first;
+    constexpr std::array<ggml_op, operations> ops = { GGML_OP_MUL_MAT, GGML_OP_UNARY, GGML_OP_MUL, GGML_OP_SUB,
+        GGML_OP_MUL_MAT, GGML_OP_UNARY, GGML_OP_MUL, GGML_OP_ADD };
+    if (!nodes[0]->src[0] || nodes[0]->src[0]->ne[0] != gate_count || nodes[0]->ne[0] != output_count) {
+        return std::nullopt;
+    }
+    for (int i = 0; i < operations; ++i) {
+        const auto * node = nodes[i];
+        if (node->view_src || node->view_offs || node->op != ops[i] || !dense(node, output_count)) { return std::nullopt; }
+        const int arity = ops[i] == GGML_OP_UNARY ? 1 : 2;
+        for (int slot = 0; slot < GGML_MAX_SRC; ++slot) {
+            if ((node->src[slot] != nullptr) != (slot < arity)) { return std::nullopt; }
+        }
+    }
+    if (ggml_get_unary_op(nodes[1]) != GGML_UNARY_OP_TANH || ggml_get_unary_op(nodes[5]) != GGML_UNARY_OP_TANH) {
+        return std::nullopt;
+    }
+    const auto * gate = nodes[0]->src[1];
+    const auto * cur = nodes[3]->src[0];
+    const auto * message = nodes[6]->src[1];
+    if (nodes[4]->src[1] != gate || nodes[1]->src[0] != nodes[0] || nodes[2]->src[0] != nodes[1] ||
+        nodes[2]->src[1] != cur || nodes[3]->src[1] != nodes[2] || nodes[5]->src[0] != nodes[4] ||
+        nodes[6]->src[0] != nodes[5] || nodes[7]->src[0] != nodes[3] || nodes[7]->src[1] != nodes[6]) {
+        return std::nullopt;
+    }
+    if (!dense(nodes[0]->src[0], gate_count, output_count) || !dense(nodes[4]->src[0], gate_count, output_count) ||
+        !dense(gate, gate_count) || !dense(cur, output_count) || !dense(message, output_count)) {
+        return std::nullopt;
+    }
+    const auto end = nodes + operations;
+    const ggml_tensor * inputs[] = {nodes[0]->src[0], nodes[4]->src[0], gate, cur, message};
+    for (const auto * tensor : inputs) {
+        if (std::find(nodes, end, tensor) != end || (tensor->view_src &&
+            std::find(nodes, end, tensor->view_src) != end)) { return std::nullopt; }
+    }
+    std::array<int, operations> indices;
+    for (int i = 0; i < operations; ++i) { indices[i] = first + i; }
+    if (!ggml_can_fuse_subgraph_ext(&graph, indices.data(), operations, ops.data(), &indices.back(), 1)) {
+        return std::nullopt;
+    }
+    for (int i = 0; i < operations - 1; ++i) {
+        if (views.contains(nodes[i])) { return std::nullopt; }
+    }
+    return plan{ nodes[0], nodes[4], cur, message, nodes[7] };
+}
+
+} // namespace webgpu_loop_controller
