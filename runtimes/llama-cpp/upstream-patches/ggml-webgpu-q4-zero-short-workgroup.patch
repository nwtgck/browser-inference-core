+// Each 32-value Q4_0 block uses four lanes. Size the cooperative workgroup
+// for all its useful lanes so every lane keeps its original block assignment.
+inline uint32_t ggml_webgpu_q4_0_short_workgroup(const ggml_webgpu_shader_lib_context & context,
+                                                bool use_mmvq, bool src_overlap) {
+    constexpr uint32_t fallback = WEBGPU_MUL_MAT_VEC_WG_SIZE;
+    const auto * a = context.src0;
+    const auto * x = context.src1;
+    const auto * dst = context.dst;
+    const uint32_t sg_min = context.min_subgroup_size;
+    const uint32_t sg_max = context.max_subgroup_size;
+    if (!a || !x || !dst || context.src2 || !context.supports_subgroups || use_mmvq || src_overlap ||
+        context.matvec_epilogue != ggml_webgpu_shader_lib_context::matvec_post_op::none ||
+        a->type != GGML_TYPE_Q4_0 || x->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        a->ne[0] <= 0 || a->ne[0] > 1024 || a->ne[0] % 32 != 0 ||
+        a->ne[1] < 1024 || a->ne[1] > UINT32_MAX - 3u ||
+        x->ne[0] != a->ne[0] || dst->ne[0] != a->ne[1] || x->ne[1] != 1 || dst->ne[1] != 1 ||
+        sg_min < 4 || sg_max > 128 || sg_min > sg_max ||
+        (sg_min & (sg_min - 1)) != 0 || (sg_max & (sg_max - 1)) != 0) {
+        return fallback;
+    }
+    uint64_t output_elements = static_cast<uint64_t>(dst->ne[0]);
+    for (int axis = 2; axis < 4; ++axis) {
+        if (a->ne[axis] <= 0 || a->ne[axis] > UINT32_MAX ||
+            x->ne[axis] <= 0 || x->ne[axis] > UINT32_MAX ||
+            dst->ne[axis] != x->ne[axis] || x->ne[axis] % a->ne[axis] != 0 ||
+            static_cast<uint64_t>(x->ne[axis]) > UINT32_MAX / output_elements) {
+            return fallback;
+        }
+        output_elements *= static_cast<uint64_t>(x->ne[axis]);
+    }
+    uint32_t workgroup = std::max(32u, sg_max);
+    const uint32_t useful_lanes = static_cast<uint32_t>(a->ne[0] / 8);
+    while (workgroup < useful_lanes) {
+        workgroup *= 2;
+    }
+    return workgroup <= context.max_wg_size ? workgroup : fallback;
 }
 
