// API doubles below expose byte transfers/queue ordering; they are not WebGPU.
#include "ggml.h"
#include "ggml-backend-impl.h"
#include "core/runner_cache.h"
#include "core/ggml_graph_cut.h"
#include <algorithm>
#include <array>
#include <cassert>
#include <cstring>
#include <functional>
#include <iostream>
#include <memory>
#include <mutex>
#include <stdexcept>
#include <vector>
int allocation_budget=-1, submission_budget=-1;
struct Counters { int reads=0, writes=0, submissions=0, waits=0, copies=0; } counters;
namespace wgpu {
struct Buffer {
    std::shared_ptr<std::vector<unsigned char>> data;
    size_t GetSize() const { return data->size(); }
    void* Get() const { return data.get(); }
    bool operator==(const Buffer& other) const { return data == other.data; }
};
using CommandBuffer = std::function<void()>;
struct CommandEncoder {
    CommandBuffer command;
    void CopyBufferToBuffer(Buffer src, size_t from, Buffer dst, size_t to, size_t size) {
        if (src == dst || from%4 || to%4 || size%4 || from+size > src.GetSize() || to+size > dst.GetSize())
            throw std::runtime_error("invalid WebGPU copy encoded");
        command = [=] { std::copy_n(src.data->begin()+from, size, dst.data->begin()+to); ++counters.copies; };
    }
    CommandBuffer Finish() { return command; }
};
struct Device { CommandEncoder CreateCommandEncoder() { return {}; } };
struct Queue {
    std::vector<CommandBuffer> pending;
    void Submit(int count, CommandBuffer* commands) { if(submission_budget==0) throw std::runtime_error("injected queue submission failure"); if(submission_budget>0)--submission_budget; counters.submissions += count; for(int i=0;i<count;++i) pending.push_back(commands[i]); }
    void finish() { auto work=std::move(pending); pending.clear(); for(auto& command:work) command(); }
};
}
struct Global { wgpu::Device device; wgpu::Queue queue; std::recursive_mutex mutex; };
using webgpu_global_context=std::shared_ptr<Global>;
struct ggml_backend_webgpu_buffer_context { webgpu_global_context global_ctx; wgpu::Buffer buffer; };
static void* const webgpu_ptr_base=(void*)(uintptr_t)0x1000;
static const char* ggml_backend_webgpu_name(ggml_backend_t) { return "WebGPU-test-double"; }
static void ggml_backend_webgpu_wait_queue(webgpu_global_context ctx) { ++counters.waits; ctx->queue.finish(); }
@COPY_FUNCTIONS@
static const char* buffer_name(ggml_backend_buffer_type_t) { return "WebGPU-test-double"; }
static const char* device_name(ggml_backend_dev_t) { return "WebGPU-test-double"; }
static const char* registry_name(ggml_backend_reg_t) { return "WebGPU"; }
static void free_buffer(ggml_backend_buffer_t b) { delete static_cast<ggml_backend_webgpu_buffer_context*>(b->context); }
static void set_tensor(ggml_backend_buffer_t b, ggml_tensor* t, const void* data, size_t offset, size_t size) {
    ++counters.writes; auto& c=*static_cast<ggml_backend_webgpu_buffer_context*>(b->context);
    // Host uploads also share queue ordering, like WriteBuffer. Do not implicitly wait.
    std::vector<unsigned char> owned((const unsigned char*)data, (const unsigned char*)data+size);
    const auto begin=ggml_webgpu_tensor_offset(t)+offset;
    c.global_ctx->queue.pending.push_back([buffer=c.buffer,begin,owned] { std::copy(owned.begin(),owned.end(),buffer.data->begin()+begin); });
}
static void get_tensor(ggml_backend_buffer_t b, const ggml_tensor* t, void* data, size_t offset, size_t size) {
    ++counters.reads; auto& c=*static_cast<ggml_backend_webgpu_buffer_context*>(b->context);
    c.global_ctx->queue.finish();
    std::memcpy(data,c.buffer.data->data()+ggml_webgpu_tensor_offset(t)+offset,size);
}
static ggml_backend_buffer_t allocate(ggml_backend_buffer_type_t type, size_t size) {
    if(allocation_budget==0)return nullptr; if(allocation_budget>0)--allocation_budget;
    auto global=*static_cast<webgpu_global_context*>(type->context);
    auto c=new ggml_backend_webgpu_buffer_context{global, {std::make_shared<std::vector<unsigned char>>(size)}};
    ggml_backend_buffer_i iface{}; iface.free_buffer=free_buffer; iface.get_base=ggml_backend_webgpu_buffer_get_base;
    iface.set_tensor=set_tensor; iface.get_tensor=get_tensor; iface.cpy_tensor=ggml_backend_webgpu_buffer_cpy_tensor;
    return ggml_backend_buffer_init(type,iface,c,size);
}
struct Fixture {
    webgpu_global_context global=std::make_shared<Global>();
    ggml_backend_reg registry{};
    ggml_backend_device device{};
    ggml_backend_buffer_type type{};
    ggml_backend backend{};
    Fixture() {
        registry.iface.get_name=registry_name;
        device.reg=&registry; device.context=this; device.iface.get_name=device_name;
        device.iface.get_buffer_type=[](ggml_backend_dev_t d) { return &static_cast<Fixture*>(d->context)->type; };
        type.device=&device; type.context=&global; type.iface.get_name=buffer_name; type.iface.alloc_buffer=allocate;
        type.iface.get_alignment=[](ggml_backend_buffer_type_t) {return size_t(256);};
        backend.device=&device; backend.context=&global; backend.iface.get_name=ggml_backend_webgpu_name;
        backend.iface.cpy_tensor_async=ggml_backend_webgpu_cpy_tensor_async;
        backend.iface.synchronize=[](ggml_backend_t b) { ggml_backend_webgpu_wait_queue(*static_cast<webgpu_global_context*>(b->context)); };
    }
};
void check(bool condition) { if(!condition) throw std::runtime_error("transfer regression failed"); }
struct Ctx { ggml_context* p=ggml_init({2*1024*1024,nullptr,true}); ~Ctx(){ggml_free(p);} };
struct Buf { ggml_backend_buffer_t p; ~Buf(){ggml_backend_buffer_free(p);} };
static int checked=0;
int main() {
    Fixture f, other;
    for(auto type : {GGML_TYPE_F32,GGML_TYPE_F16}) for(bool viewed : {false,true}) for(bool async : {false,true}) {
        Ctx ctx; auto backing=ggml_new_tensor_1d(ctx.p,type,128);
        auto src=viewed ? ggml_view_1d(ctx.p,backing,24,16) : backing;
        Buf input{ggml_backend_alloc_ctx_tensors(ctx.p,&f.backend)};
        Ctx target; auto dst=ggml_dup_tensor(target.p,src); Buf output{ggml_backend_alloc_ctx_tensors(target.p,&f.backend)};
        std::vector<unsigned char> data(ggml_nbytes(backing)); for(size_t i=0;i<data.size();++i)data[i]=i%251;
        ggml_backend_tensor_set(backing,data.data(),0,data.size()); f.global->queue.finish();
        counters={};
        bool ok=async ? ggml_backend_webgpu_cpy_tensor_async(&f.backend,&f.backend,src,dst) : ggml_backend_webgpu_buffer_cpy_tensor(output.p,src,dst);
        check(ok && counters.reads==0 && counters.writes==0 && counters.submissions==1 && counters.waits==int(!async));
        if(async) {check(counters.copies==0);ggml_backend_synchronize(&f.backend);}
        check(counters.copies==1);
        auto& actual=*static_cast<ggml_backend_webgpu_buffer_context*>(output.p->context)->buffer.data;
        check(std::equal(actual.begin(),actual.begin()+ggml_nbytes(dst),data.begin()+(viewed?16:0)));
        ++checked;
    }
    // Refused copies must not enqueue anything; the generic slow path stays available.
    for(int kind=0;kind<8;++kind) {
        Ctx ctx,target; auto raw=ggml_new_tensor_1d(ctx.p,GGML_TYPE_F16,128);
        auto src=ggml_view_1d(ctx.p,raw,kind==0?3:24,kind==1?2:16);
        Buf a{ggml_backend_alloc_ctx_tensors(ctx.p,&f.backend)};
        auto dst=ggml_dup_tensor(target.p,src);
        Buf b{ggml_backend_alloc_ctx_tensors(target.p,kind==2?&other.backend:&f.backend)};
        auto original=*dst;
        if(kind==3) {dst->buffer=a.p;dst->data=src->data;}
        if(kind==4) dst->data=(void*)(uintptr_t(0x1000)+2);
        if(kind==5) dst->data=(void*)(uintptr_t(0x1000)+ggml_backend_buffer_get_size(b.p));
        if(kind==6) dst->buffer=nullptr;
        if(kind==7) {dst->nb[1] += 4;}
        counters={};check(!ggml_backend_webgpu_copy_tensor(src,dst,false));check(counters.submissions==0 && counters.waits==0);
        *dst=original;++checked;
    }
    // Actual CachedTensor copy: materialized outputs and CPY/view outputs alike
    // remain on the queue. Preserve source metadata and the view's nonzero offset.
    for(auto type : {GGML_TYPE_F32,GGML_TYPE_F16}) for(bool view : {false,true}) {
        Ctx ctx;auto raw=ggml_new_tensor_1d(ctx.p,type,128);auto src=view?ggml_view_1d(ctx.p,raw,32,16):raw;
        Buf b{ggml_backend_alloc_ctx_tensors(ctx.p,&f.backend)};
        std::vector<unsigned char> data(ggml_nbytes(raw));for(size_t i=0;i<data.size();++i)data[i]=(i*7)%251;
        ggml_backend_tensor_set(raw,data.data(),0,data.size());f.global->queue.finish();
        if(view) src->buffer=nullptr; // GGML resolves this through view_src.
        auto original=*src;counters={};ggml_status status;
        auto entry=sd::CachedTensor::copy(&f.backend,"test",src,status);
        check(entry && status==GGML_STATUS_SUCCESS && counters.reads==0 && counters.writes==0 && counters.waits==1 && counters.submissions==1);
        check(std::memcmp(&original,src,sizeof(original))==0);
        ggml_backend_synchronize(&f.backend);
        auto& actual=*static_cast<ggml_backend_webgpu_buffer_context*>(entry->buffer->context)->buffer.data;
        check(std::equal(actual.begin(),actual.begin()+ggml_nbytes(src),data.begin()+(view?16:0)));
        ++checked;
    }
    // Batch caching commits only after its queue completion boundary. Eight CPY
    // outputs should have eight device copies but one wait and no host transfers.
    {
        Ctx ctx;sd::RunnerCache cache(&f.backend);auto graph=ggml_new_graph_custom(ctx.p,64,false);
        std::array<ggml_tensor*,8> outputs;
        for(int i=0;i<8;++i){auto raw=ggml_new_tensor_1d(ctx.p,GGML_TYPE_F32,32);outputs[i]=ggml_view_1d(ctx.p,raw,16,16);ggml_build_forward_expand(graph,outputs[i]);cache.stage(std::to_string(i),outputs[i]);}
        Buf b{ggml_backend_alloc_ctx_tensors(ctx.p,&f.backend)};
        for(int i=0;i<8;++i){std::vector<float> v(32,float(i+1));ggml_backend_tensor_set(outputs[i]->view_src,v.data(),0,v.size()*4);}
        f.global->queue.finish();counters={};check(cache.capture(graph)==GGML_STATUS_SUCCESS);
        check(counters.reads==0&&counters.writes==0&&counters.submissions==8&&counters.copies==8&&counters.waits==1);
        cache.graph_end(true);for(int i=0;i<8;++i)check(cache.get(std::to_string(i))!=nullptr);++checked;
    }
    // A staged output in another segment and a previously captured output must
    // not create completion callbacks or drain unrelated queued work.
    for (bool already_pending : {false, true}) {
        Ctx ctx;
        sd::RunnerCache cache(&f.backend);
        auto present = ggml_new_tensor_1d(ctx.p, GGML_TYPE_F32, 16);
        auto absent = ggml_new_tensor_1d(ctx.p, GGML_TYPE_F32, 16);
        auto graph = ggml_new_graph_custom(ctx.p, 32, false);
        ggml_build_forward_expand(graph, present);
        Buf buffer{ggml_backend_alloc_ctx_tensors(ctx.p, &f.backend)};
        cache.stage("output", already_pending ? present : absent);
        if (already_pending) check(cache.capture(graph) == GGML_STATUS_SUCCESS);
        bool unrelated_work_completed = false;
        f.global->queue.pending.push_back([&] { unrelated_work_completed = true; });
        counters = {};
        check(cache.capture(graph) == GGML_STATUS_SUCCESS);
        check(counters.waits == 0 && counters.submissions == 0 && counters.copies == 0);
        check(!unrelated_work_completed);
        cache.graph_end(true);
        check((cache.get("output") != nullptr) == already_pending);
        f.global->queue.finish();
        ++checked;
    }
    // A cut with no future consumer (including an empty output list) does not
    // own any pending copy. It must not synchronize unrelated computation.
    for (bool has_output : {false, true}) {
        Ctx ctx;
        sd::GraphCutTensorCache cache(&f.backend);
        auto input = ggml_new_tensor_1d(ctx.p, GGML_TYPE_F32, 16);
        auto output = ggml_cont(ctx.p, input);
        sd::ggml_graph_cut::mark_graph_cut(output, "queue-probe", "unused-output");
        check(sd::ggml_graph_cut::is_graph_cut_tensor(output));
        auto graph = ggml_new_graph_custom(ctx.p, 32, false);
        ggml_build_forward_expand(graph, output);
        sd::ggml_graph_cut::Segment segment;
        if (has_output) segment.output_node_indices.push_back(0);
        bool unrelated_work_completed = false;
        f.global->queue.pending.push_back([&] { unrelated_work_completed = true; });
        counters = {};
        check(cache.capture(graph, segment, "empty-cut") == GGML_STATUS_SUCCESS);
        check(counters.waits == 0 && counters.submissions == 0 && counters.copies == 0);
        check(!unrelated_work_completed);
        f.global->queue.finish();
        ++checked;
    }
    // Allocation must finish before ANY async submission, including failures
    // after several destinations were successfully allocated. A queued-copy
    // failure must complete previous submissions before the cache drops owners.
    for(bool allocation_failure:{true,false}) {
        Ctx ctx;sd::RunnerCache cache(&f.backend);auto graph=ggml_new_graph_custom(ctx.p,64,false);
        std::array<ggml_tensor*,4> outputs;
        for(int i=0;i<4;++i){outputs[i]=ggml_new_tensor_1d(ctx.p,GGML_TYPE_F32,16);ggml_build_forward_expand(graph,outputs[i]);cache.stage(std::to_string(i),outputs[i]);}
        Buf b{ggml_backend_alloc_ctx_tensors(ctx.p,&f.backend)};
        for(int i=0;i<4;++i){std::vector<float> values(16,float(i));ggml_backend_tensor_set(outputs[i],values.data(),0,64);}
        f.global->queue.finish();counters={};
        if(allocation_failure){allocation_budget=2;check(cache.capture(graph)==GGML_STATUS_ALLOC_FAILED);allocation_budget=-1;check(counters.submissions==0);}
        else {submission_budget=2;bool threw=false;try{cache.capture(graph);}catch(const std::runtime_error&){threw=true;}submission_budget=-1;check(threw&&counters.submissions==2&&counters.copies==2&&counters.waits==1);}
        check(f.global->queue.pending.empty());cache.graph_end(false);check(cache.empty());++checked;
    }
    // Non-contiguous graph-cut spans retain the old host path and their strides.
    {
        Ctx ctx;auto raw=ggml_new_tensor_2d(ctx.p,GGML_TYPE_F32,8,8);auto src=ggml_view_2d(ctx.p,raw,4,4,raw->nb[1],16);
        Buf b{ggml_backend_alloc_ctx_tensors(ctx.p,&f.backend)}; std::vector<float> values(64);for(int i=0;i<64;++i)values[i]=float(i);
        ggml_backend_tensor_set(raw,values.data(),0,values.size()*4); f.global->queue.finish();counters={};ggml_status status;
        auto entry=sd::CachedTensor::copy(&f.backend,"strided",src,status);check(entry&&counters.reads==1&&counters.writes==1&&counters.submissions==0);
        f.global->queue.finish();check(entry->tensor->nb[1]==src->nb[1]);++checked;
    }
    std::cout << checked << " transfer/cache API contract cases passed; no GPU executed\n";
}
