+static bool relative_attention_bias_matches(
+        const ggml_tensor * q, const ggml_tensor * k, const ggml_tensor * raw,
+        const llm_graph_context::relative_attention & relative) {
+    const auto * table = relative.table;
+    const auto * buckets = relative.buckets;
+    if (!raw || raw->type != GGML_TYPE_F16 || !ggml_is_contiguous(raw) ||
+        q->ne[1] < 1 || q->ne[3] < 1 || q->ne[1] > INT64_MAX / q->ne[3]) {
+        return false;
+    }
+    const auto flat_queries = q->ne[1] * q->ne[3];
