+@group(0) @binding(0)
+var<storage, read_write> probs: array<f32>;
+@group(0) @binding(1)
+var<storage, read_write> ids: array<i32>;
+@group(0) @binding(2)
+var<storage, read_write> dst: array<f32>;
+
+struct Params {
+    offset_probs: u32,
+    offset_ids: u32,
+    offset_dst: u32,
+    stride_probs: u32,
+    stride_ids: u32,
+    stride_dst: u32,
+    used: u32,
+    tokens: u32,
+    clamp_min: f32,
+    clamp_max: f32,
+};
+@group(0) @binding(3)
+var<uniform> params: Params;
+var<workgroup> shared_sum: array<f32, WG_SIZE>;
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(workgroup_id) wid: vec3<u32>,
+        @builtin(local_invocation_id) lid: vec3<u32>) {
+    // The admitted dispatch is exactly (tokens,1,1), matching the baseline sum.
+    let token = wid.x;
+    if (token >= params.tokens) { return; }
+    var selected: f32 = 0.0;
+    if (lid.x < params.used) {
+        let expert = u32(ids[params.offset_ids + token * params.stride_ids + lid.x]);
+        selected = probs[params.offset_probs + token * params.stride_probs + expert];
+    }
+    var local_sum: f32 = 0.0;
+    for (var col = lid.x; col < params.used; col += WG_SIZE) {
+        local_sum += selected;
+    }
+    shared_sum[lid.x] = local_sum;
+    workgroupBarrier();
+    // reduce within workgroup
+    var offset: u32 = WG_SIZE >> 1;
+    while (offset > 0) {
+        if (lid.x < offset) {
+            shared_sum[lid.x] = shared_sum[lid.x] + shared_sum[lid.x + offset];
+        }
+        workgroupBarrier();
+        offset >>= 1;
+    }
+
+    if (lid.x < params.used) {
+        let denominator = clamp(shared_sum[0], f32(params.clamp_min), f32(params.clamp_max));
+        dst[params.offset_dst + token * params.stride_dst + lid.x] = selected / denominator;
+    }
+}
