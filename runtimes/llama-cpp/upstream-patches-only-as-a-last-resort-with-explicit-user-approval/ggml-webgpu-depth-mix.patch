--- /dev/null
+++ b/ggml/src/ggml-webgpu/ggml-webgpu-depth-mix.hpp
@@ -0,0 +1,130 @@
+#pragma once
+
+#include "ggml-impl.h"
+
+#include <array>
+#include <cmath>
+#include <optional>
+
+namespace depth_mix {
+
+inline constexpr int width = 2304;
+inline constexpr int max_depth = 5;
+inline constexpr int max_queries = 4;
+inline constexpr float epsilon = 1e-6f;
+inline constexpr int last_non_concat_nodes = 7;
+inline constexpr int max_consumed_nodes = max_depth - 1 + last_non_concat_nodes;
+
+struct plan {
+    std::array<const ggml_tensor *, max_depth> states{};
+    const ggml_tensor * queries;
+    const ggml_tensor * output;
+    int depth;
+    int query_count;
+    int consumed;
+    float score_scale;
+};
+
+inline bool f32_rect(const ggml_tensor * node, int64_t columns, int64_t rows) {
+    return node && node->type == GGML_TYPE_F32 && node->ne[0] == columns && node->ne[1] == rows &&
+           node->ne[2] == 1 && node->ne[3] == 1 && ggml_is_contiguous(node);
+}
+
+inline bool op_arity(const ggml_tensor * node, ggml_op op, int sources, bool view = false) {
+    if (!node || node->op != op || (node->view_src != nullptr) != view) {
+        return false;
+    }
+    for (int i = 0; i < GGML_MAX_SRC; ++i) {
+        if ((node->src[i] != nullptr) != (i < sources)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+inline std::optional<plan> match(const ggml_cgraph & graph, int first) {
+    if (first < 0 || first > graph.n_nodes - last_non_concat_nodes - 1) {
+        return {};
+    }
+    const auto * entry = graph.nodes[first];
+    if (entry->op != GGML_OP_CONCAT || entry->type != GGML_TYPE_F32 || entry->ne[0] != width ||
+        entry->ne[1] != 2 || entry->ne[2] != 1 || entry->ne[3] != 1 || ggml_get_op_params_i32(entry, 0) != 1) {
+        return {};
+    }
+
+    // The current left-to-right graph visits the output's transpose branch first.
+    // All original state views are ready before the CONCAT sequence starts.
+    int depth = 2;
+    while (depth < max_depth && first + depth - 1 < graph.n_nodes &&
+           graph.nodes[first + depth - 1]->op == GGML_OP_CONCAT) {
+        ++depth;
+    }
+    const int consumed = depth - 1 + last_non_concat_nodes;
+    if (consumed > graph.n_nodes - first) {
+        return {};
+    }
+
+    const auto * stack = graph.nodes[first + depth - 2];
+    const auto * norm = graph.nodes[first + depth - 1];
+    const auto * transpose = graph.nodes[first + depth];
+    const auto * projection = graph.nodes[first + depth + 1];
+    const auto * repeat = graph.nodes[first + depth + 2];
+    const auto * scores = graph.nodes[first + depth + 3];
+    const auto * softmax = graph.nodes[first + depth + 4];
+    const auto * output = graph.nodes[first + depth + 5];
+    const int64_t q = output->ne[1];
+    if ((q != 1 && q != 3 && q != 4) ||
+        !op_arity(norm, GGML_OP_RMS_NORM, 1) || !op_arity(transpose, GGML_OP_TRANSPOSE, 1, true) ||
+        !op_arity(projection, GGML_OP_CONT, 1) || !op_arity(repeat, GGML_OP_REPEAT, 1) ||
+        !op_arity(scores, GGML_OP_MUL_MAT, 2) || !op_arity(softmax, GGML_OP_SOFT_MAX, 1) ||
+        !op_arity(output, GGML_OP_MUL_MAT, 2)) {
+        return {};
+    }
+    if (norm->src[0] != stack || transpose->src[0] != norm || projection->src[0] != transpose ||
+        scores->src[0] != norm || scores->src[1] != repeat || softmax->src[0] != scores ||
+        output->src[0] != projection || output->src[1] != softmax ||
+        transpose->view_src != norm || transpose->view_offs != 0 || transpose->type != GGML_TYPE_F32 ||
+        transpose->ne[0] != depth || transpose->ne[1] != width || transpose->ne[2] != 1 || transpose->ne[3] != 1 ||
+        transpose->nb[0] != norm->nb[1] || transpose->nb[1] != norm->nb[0]) {
+        return {};
+    }
+    const auto * queries = repeat->src[0];
+    if (!f32_rect(norm, width, depth) || !f32_rect(projection, depth, width) ||
+        !f32_rect(repeat, width, q) || !f32_rect(queries, width, q) ||
+        !f32_rect(scores, depth, q) || !f32_rect(softmax, depth, q) || !f32_rect(output, width, q) ||
+        ggml_get_op_params_f32(norm, 0) != epsilon ||
+        ggml_get_op_params_f32(softmax, 0) != 1.0f / std::sqrt(static_cast<float>(width)) ||
+        ggml_get_op_params_i32(softmax, 1) != 0) {
+        return {};
+    }
+
+    plan result{{}, queries, output, depth, static_cast<int>(q), consumed, ggml_get_op_params_f32(softmax, 0)};
+    const auto * part = stack;
+    for (int count = depth; count >= 2; --count) {
+        if (graph.nodes[first + count - 2] != part || !op_arity(part, GGML_OP_CONCAT, 2) ||
+            ggml_get_op_params_i32(part, 0) != 1 || !f32_rect(part, width, count) ||
+            !f32_rect(part->src[0], width, 1)) {
+            return {};
+        }
+        result.states[depth - count] = part->src[0];
+        part = part->src[1];
+    }
+    if (!f32_rect(part, width, 1)) {
+        return {};
+    }
+    result.states[depth - 1] = part;
+
+    std::array<int, max_consumed_nodes> indices;
+    std::array<ggml_op, max_consumed_nodes> ops;
+    for (int i = 0; i < consumed; ++i) {
+        indices[i] = first + i;
+        ops[i] = graph.nodes[first + i]->op;
+    }
+    const int output_index = first + consumed - 1;
+    if (!ggml_can_fuse_subgraph_ext(&graph, indices.data(), consumed, ops.data(), &output_index, 1)) {
+        return {};
+    }
+    return result;
+}
+
+} // namespace depth_mix
