                 x_block[col][i] = f32(SRC1[x_base + col * params.stride_11 + i]);
             }
         }
-        for (var row = 0u; row < OUTPUTS_PER_WG; row++) {
+        for (var row = 0u; row < 2; row++) {
             let output_row = row_base + row;
