+static bool ggml_webgpu_flash_indexed_vec_resident(const webgpu_global_context & global, const ggml_tensor * node,
+                                                   const ggml_webgpu_indexed_vec_layout & layout) {
+    if (!node->buffer) {
+        return true;
+    }
+    const auto * buffer = node->buffer;
+    if (buffer->iface.get_base != ggml_backend_webgpu_buffer_get_base || !buffer->context) {
+        return false;
+    }
+    const auto * backing = static_cast<const ggml_backend_webgpu_buffer_context *>(buffer->context);
+    if (backing->global_ctx != global || !backing->buffer ||
+        (backing->buffer.GetUsage() & wgpu::BufferUsage::Storage) == wgpu::BufferUsage::None) {
+        return false;
+    }
+    const uint64_t alignment = global->capabilities.limits.minStorageBufferOffsetAlignment;
+    const uint64_t offset = ggml_webgpu_tensor_offset(node);
+    const uint64_t maximum = std::min<uint64_t>(buffer->size, backing->buffer.GetSize());
+    if (offset % alignment || offset > maximum || layout.bytes > maximum - offset) {
+        return false;
+    }
+    // Scratch and the result are one allocation. Each dispatch binds only its
+    // individual ranges. Keep all of those ranges disjoint from live inputs.
+    for (const auto * src : node->src) {
+        if (!src || !src->buffer || src->buffer->iface.get_base != ggml_backend_webgpu_buffer_get_base) {
+            continue;
+        }
+        const auto * input = static_cast<const ggml_backend_webgpu_buffer_context *>(src->buffer->context);
+        if (!input || input->global_ctx != global || !input->buffer) {
+            return false;
+        }
+        if (input->buffer.Get() != backing->buffer.Get()) {
+            continue;
+        }
+        const auto begin = ggml_webgpu_tensor_align_offset(src, alignment);
+        const auto size = ggml_webgpu_tensor_binding_size(src, alignment);
+        if (begin < offset + layout.bytes && offset < begin + size) {
+            return false;
+        }
+    }
+    return true;
+}
