+++ b/ggml/src/ggml-webgpu/wgsl-shaders/depth_normalize.wgsl
@@ -0,0 +1,65 @@
+// The replay expands DEPTH and SCRATCH_BINDING before compiling WGSL.
+struct Params {
+    source_offsets: vec4<u32>,
+    source_offset4: u32,
+};
+
+@group(0) @binding(0) var<storage, read> source0: array<f32>;
+@group(0) @binding(1) var<storage, read> source1: array<f32>;
+#if DEPTH >= 3
+@group(0) @binding(2) var<storage, read> source2: array<f32>;
+#endif
+#if DEPTH >= 4
+@group(0) @binding(3) var<storage, read> source3: array<f32>;
+#endif
+#if DEPTH >= 5
+@group(0) @binding(4) var<storage, read> source4: array<f32>;
+#endif
+@group(0) @binding(SCRATCH_BINDING) var<storage, read_write> values: array<f32>;
+@group(0) @binding(PARAM_BINDING) var<uniform> params: Params;
+
+const WIDTH = 2304u;
+const WG_SIZE = 128u;
+var<workgroup> partial: array<f32, WG_SIZE>;
+
+fn load(row: u32, col: u32) -> f32 {
+    switch row {
+        case 0u: { return source0[params.source_offsets.x + col]; }
+        case 1u: { return source1[params.source_offsets.y + col]; }
+#if DEPTH >= 3
+        case 2u: { return source2[params.source_offsets.z + col]; }
+#endif
+#if DEPTH >= 4
+        case 3u: { return source3[params.source_offsets.w + col]; }
+#endif
+#if DEPTH >= 5
+        case 4u: { return source4[params.source_offset4 + col]; }
+#endif
+        default: { return 0.0; }
+    }
+}
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(local_invocation_id) local: vec3<u32>) {
+    let row = group.x;
+    let lane = local.x;
+    var squares = 0.0;
+    for (var col = lane; col < WIDTH; col += WG_SIZE) {
+        let value = load(row, col);
+        squares += value * value;
+    }
+    partial[lane] = squares;
+    workgroupBarrier();
+    for (var step = WG_SIZE / 2u; step > 0u; step /= 2u) {
+        if (lane < step) {
+            partial[lane] += partial[lane + step];
+        }
+        workgroupBarrier();
+    }
+
+    // Preserve WGSL row_norm's F32 square/reduce/scale sequence.
+    let scale = 1.0 / sqrt(partial[0] / f32(WIDTH) + 1e-6);
+    for (var col = lane; col < WIDTH; col += WG_SIZE) {
+        values[row * WIDTH + col] = scale * (load(row, col) - 0.0);
+    }
+}
