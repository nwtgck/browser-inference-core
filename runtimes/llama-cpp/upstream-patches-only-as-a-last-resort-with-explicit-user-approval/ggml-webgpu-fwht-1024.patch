+++ b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_fwht_1024.wgsl
@@ -0,0 +1,41 @@
+const WIDTH = 1024u;
+const WG_SIZE = 128u;
+
+struct Parameters {
+    src_offset: u32,
+    dst_offset: u32,
+}
+
+// The two disjoint ranges may share one storage buffer.
+@group(0) @binding(0) var<storage, read_write> activation: array<f32>;
+@group(0) @binding(1) var<storage, read_write> result: array<f32>;
+@group(0) @binding(2) var<uniform> params: Parameters;
+
+var<workgroup> values: array<f32, WIDTH>;
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(workgroup_id) group_id: vec3<u32>, @builtin(local_invocation_index) lane: u32) {
+    let column = group_id.x * WIDTH;
+    for (var i = lane; i < WIDTH; i += WG_SIZE) {
+        // Retain the register-tile matmul's half-precision input rounding.
+        values[i] = quantizeToF16(activation[params.src_offset + column + i]) * 0.03125;
+    }
+    workgroupBarrier();
+
+    for (var span = 1u; span < WIDTH; span <<= 1u) {
+        for (var pair = lane; pair < WIDTH / 2u; pair += WG_SIZE) {
+            // Insert a zero bit at span; its paired index has that bit set.
+            let low = (pair & (span - 1u)) | ((pair & ~(span - 1u)) << 1u);
+            let high = low | span;
+            let x = values[low];
+            let y = values[high];
+            values[low] = x + y;
+            values[high] = x - y;
+        }
+        workgroupBarrier();
+    }
+
+    for (var i = lane; i < WIDTH; i += WG_SIZE) {
+        result[params.dst_offset + column + i] = values[i];
+    }
+}
