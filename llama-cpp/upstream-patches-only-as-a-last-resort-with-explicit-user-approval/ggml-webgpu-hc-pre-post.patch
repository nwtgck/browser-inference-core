diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/hc_post.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/hc_post.wgsl
new file mode 100644
index 0000000000000000000000000000000000000000..6aaef21d2568eb03cc39a42531cd0990c8226d84
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/hc_post.wgsl
@@ -0,0 +1,19 @@
+struct Params {
+    offset_x: u32, offset_residual: u32, offset_post: u32, offset_dst: u32,
+    d: u32, t: u32,
+};
+@group(0) @binding(0) var<storage, read_write> x: array<f32>;
+@group(0) @binding(1) var<storage, read_write> residual: array<f32>;
+@group(0) @binding(2) var<storage, read_write> post: array<f32>;
+@group(0) @binding(3) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(4) var<uniform> params: Params;
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let i = gid.x + (num_wg.x * 64u) * gid.y;
+    if (i >= params.d * 4u * params.t) { return; }
+    let h = (i / params.d) % 4u;
+    let t = i / (params.d * 4u);
+    let product = x[params.offset_x + t * params.d + i % params.d] * post[params.offset_post + t * 4u + h];
+    dst[params.offset_dst + i] = residual[params.offset_residual + i] + product;
+}
diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/hc_pre.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/hc_pre.wgsl
new file mode 100644
index 0000000000000000000000000000000000000000..e92a43c78babfe79b529b841362a0a77bf9a66ac
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/hc_pre.wgsl
@@ -0,0 +1,27 @@
+struct Params {
+    offset_x: u32, offset_gate: u32, offset_dst: u32,
+    d: u32, t: u32, scale: f32, bias: f32,
+};
+@group(0) @binding(0) var<storage, read_write> x: array<f32>;
+@group(0) @binding(1) var<storage, read_write> gate: array<f32>;
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(3) var<uniform> params: Params;
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let i = gid.x + (num_wg.x * 64u) * gid.y;
+    if (i >= params.d * params.t) { return; }
+    let base = (i / params.d) * (4u * params.d) + i % params.d;
+    let s0 = 1.0 / (1.0 + exp(-gate[params.offset_gate + base]));
+    let s1 = 1.0 / (1.0 + exp(-gate[params.offset_gate + base + params.d]));
+    let s2 = 1.0 / (1.0 + exp(-gate[params.offset_gate + base + 2u * params.d]));
+    let s3 = 1.0 / (1.0 + exp(-gate[params.offset_gate + base + 3u * params.d]));
+    let p0 = x[params.offset_x + base] * s0;
+    let p1 = x[params.offset_x + base + params.d] * s1;
+    let p2 = x[params.offset_x + base + 2u * params.d] * s2;
+    let p3 = x[params.offset_x + base + 3u * params.d] * s3;
+    let a1 = p0 + p1;
+    let a2 = a1 + p2;
+    let a3 = a2 + p3;
+    dst[params.offset_dst + i] = a3 * params.scale + params.bias;
+}
