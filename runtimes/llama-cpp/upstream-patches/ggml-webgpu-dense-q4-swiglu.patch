--- /dev/null
+++ b/ggml/src/ggml-webgpu/ggml-webgpu-dense-q4-swiglu.hpp
@@ -0,0 +1,289 @@
+#pragma once
+
+#include <array>
+#include <iterator>
+
+// The encoder shares the ordinary matvec layout and WebGPU binding helpers.
+namespace webgpu_dense_q4_swiglu {
+
+constexpr int64_t input_width = 6656;
+constexpr int64_t output_width = 19968;
+constexpr uint32_t workgroup = 128;
+constexpr uint32_t rows_per_subgroup = 4;
+constexpr int operations = 3;
+
+static bool packed_bytes(const ggml_tensor * tensor, uint64_t & bytes) {
+    const uint64_t block = ggml_blck_size(tensor->type);
+    const uint64_t unit = ggml_type_size(tensor->type);
+    if (tensor->ne[0] <= 0 || uint64_t(tensor->ne[0]) % block != 0 ||
+        uint64_t(tensor->ne[0]) / block > UINT32_MAX / unit || tensor->nb[0] != unit) {
+        return false;
+    }
+    bytes = uint64_t(tensor->ne[0]) / block * unit;
+    for (int axis = 1; axis < GGML_MAX_DIMS; ++axis) {
+        if (tensor->ne[axis] <= 0 || uint64_t(tensor->ne[axis]) > UINT32_MAX / bytes ||
+            tensor->nb[axis] != bytes) {
+            return false;
+        }
+        bytes *= uint64_t(tensor->ne[axis]);
+    }
+    return true;
+}
+
+static bool shape(const ggml_tensor * tensor, ggml_type type, int64_t width, int64_t rows) {
+    uint64_t bytes;
+    return tensor && tensor->type == type && tensor->ne[0] == width && tensor->ne[1] == rows &&
+        tensor->ne[2] == 1 && tensor->ne[3] == 1 && packed_bytes(tensor, bytes);
+}
+
+static bool matches_projection_weight(const ggml_tensor * weight) {
+    return weight && weight->type == GGML_TYPE_Q4_K &&
+        weight->ne[0] == input_width && weight->ne[1] == output_width;
+}
+
+static bool default_params(const ggml_tensor * tensor, size_t skip) {
+    return std::all_of(std::begin(tensor->op_params) + skip, std::end(tensor->op_params),
+        [](int32_t word) { return word == 0; });
+}
+
+struct pattern {
+    ggml_tensor * gate;
+    ggml_tensor * up;
+    ggml_tensor * output;
+};
+
+static std::optional<pattern> match(const ggml_cgraph & graph, int index) {
+    if (index < 0 || index >= graph.n_nodes || graph.n_nodes - index < operations) {
+        return std::nullopt;
+    }
+    const auto * first = graph.nodes[index];
+    const auto * second = graph.nodes[index + 1];
+    auto * output = graph.nodes[index + 2];
+    if (first->op != GGML_OP_MUL_MAT || !matches_projection_weight(first->src[0]) ||
+        second->op != GGML_OP_MUL_MAT || output->op != GGML_OP_GLU ||
+        ggml_get_glu_op(output) != GGML_GLU_OP_SWIGLU || !default_params(output, 1)) {
+        return std::nullopt;
+    }
+    auto * gate = output->src[0];
+    auto * up = output->src[1];
+    if (first == second || !((gate == first && up == second) || (gate == second && up == first))) {
+        return std::nullopt;
+    }
+    if (gate->src[1] != up->src[1] || !shape(gate->src[1], GGML_TYPE_F32, input_width, 1) ||
+        !shape(gate->src[0], GGML_TYPE_Q4_K, input_width, output_width) ||
+        !shape(up->src[0], GGML_TYPE_Q4_K, input_width, output_width) ||
+        !default_params(gate, 0) || !default_params(up, 0)) {
+        return std::nullopt;
+    }
+    for (const auto * node : {gate, up, output}) {
+        if (node->view_src || node->view_offs || !shape(node, GGML_TYPE_F32, output_width, 1) ||
+            std::any_of(std::begin(node->src) + 2, std::end(node->src),
+                [](const ggml_tensor * source) { return source != nullptr; })) {
+            return std::nullopt;
+        }
+    }
+    const int indices[] = {index, index + 1, index + 2};
+    const int outputs[] = {index + 2};
+    const ggml_op ops[] = {GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU};
+    if (!ggml_can_fuse_subgraph_ext(&graph, indices, operations, ops, outputs, 1)) {
+        return std::nullopt;
+    }
+    return pattern{gate, up, output};
+}
+
+struct binding {
+    wgpu::Buffer buffer;
+    uint64_t offset = 0;
+    uint64_t size = 0;
+    uint32_t element_offset = 0;
+};
+
+struct buffer_facts {
+    WGPUBuffer handle = nullptr;
+    uint64_t size = 0;
+    bool storage = false;
+};
+
+static bool get_binding(webgpu_context & ctx, const ggml_tensor * tensor,
+                        std::array<buffer_facts, 4> & facts, binding & result) {
+    const auto * buffer = tensor->buffer;
+    if (!buffer || !buffer->context || buffer->iface.get_base != ggml_backend_webgpu_buffer_get_base ||
+        !tensor->data) {
+        return false;
+    }
+    const auto * buffer_ctx = static_cast<const ggml_backend_webgpu_buffer_context *>(buffer->context);
+    if (buffer_ctx->global_ctx != ctx->global_ctx || !buffer_ctx->buffer) {
+        return false;
+    }
+
+    const auto * root = tensor->view_src ? tensor->view_src : tensor;
+    uint64_t bytes, root_bytes;
+    const auto base = reinterpret_cast<uintptr_t>(webgpu_ptr_base);
+    const auto root_data = reinterpret_cast<uintptr_t>(root->data);
+    if (root->view_src || root->view_offs || root->type != tensor->type || root->buffer != buffer ||
+        root_data < base || tensor->view_offs > UINTPTR_MAX - root_data ||
+        reinterpret_cast<uintptr_t>(tensor->data) != root_data + tensor->view_offs ||
+        !packed_bytes(tensor, bytes)) {
+        return false;
+    }
+    if (root != tensor && (!packed_bytes(root, root_bytes) || tensor->view_offs > root_bytes ||
+        bytes > root_bytes - tensor->view_offs)) {
+        return false;
+    }
+
+    const uint64_t payload = root_data - base + tensor->view_offs;
+    const uint64_t unit = ggml_type_size(tensor->type);
+    const auto & limits = ctx->global_ctx->capabilities.limits;
+    const uint64_t alignment = limits.minStorageBufferOffsetAlignment;
+    if (alignment < 4 || (alignment & (alignment - 1)) || payload % 4 != 0) {
+        return false;
+    }
+    // Match ordinary quantized matvec's block-aligned rebase, with a checked
+    // underflow path for a tensor offset which cannot be expressed in blocks.
+    uint64_t offset = payload & ~(alignment - 1);
+    while ((payload - offset) % unit != 0) {
+        if (offset < alignment) {
+            return false;
+        }
+        offset -= alignment;
+    }
+    const uint64_t prefix = payload - offset;
+    if (prefix > UINT32_MAX - bytes) {
+        return false;
+    }
+    // F32 and Q4_K units are multiples of four bytes.
+    const uint64_t size = prefix + bytes;
+    if (size > limits.maxStorageBufferBindingSize || offset > buffer->size || size > buffer->size - offset) {
+        return false;
+    }
+
+    const auto handle = buffer_ctx->buffer.Get();
+    auto found = std::find_if(facts.begin(), facts.end(), [handle](const buffer_facts & fact) {
+        return !fact.handle || fact.handle == handle;
+    });
+    if (found == facts.end()) {
+        return false;
+    }
+    if (!found->handle) {
+        *found = {handle, buffer_ctx->buffer.GetSize(),
+            (buffer_ctx->buffer.GetUsage() & wgpu::BufferUsage::Storage) != wgpu::BufferUsage::None};
+    }
+    if (!found->storage || offset > found->size || size > found->size - offset) {
+        return false;
+    }
+    result = {buffer_ctx->buffer, offset, size, uint32_t(prefix / unit)};
+    return true;
+}
+
+static bool bindings_overlap(const binding & first, const binding & second) {
+    // The binding ranges include the payload. Reject overlap by physical
+    // handle even when the ggml buffer wrappers are distinct.
+    return first.buffer.Get() == second.buffer.Get() &&
+        first.offset < second.offset + second.size && second.offset < first.offset + first.size;
+}
+
+struct dispatch_plan {
+    std::array<binding, 4> bindings;
+    uint32_t subgroup;
+    uint32_t workgroups;
+};
+
+static std::optional<dispatch_plan> plan(webgpu_context & ctx, const ggml_cgraph & graph,
+                                        int index, webgpu_fusion_view_sources & views) {
+    const auto matched = match(graph, index);
+    if (!matched) {
+        return std::nullopt;
+    }
+    const auto & limits = ctx->global_ctx->capabilities.limits;
+    if (limits.maxStorageBuffersPerShaderStage < 4 || limits.maxBindingsPerBindGroup < 5 ||
+        limits.maxUniformBuffersPerShaderStage < 1 || limits.maxUniformBufferBindingSize < ctx->param_arena.slot_size ||
+        limits.maxComputeWorkgroupSizeX < workgroup || ctx->param_arena.slot_size < 20 * sizeof(uint32_t)) {
+        return std::nullopt;
+    }
+
+    dispatch_plan result{};
+    for (auto * projection : {matched->gate, matched->up}) {
+        const auto ordinary = ggml_webgpu_mat_context(ctx, projection->src[0], projection->src[1], projection);
+        // Check the disjoint-binding key first. The physical check below
+        // establishes this assumption before entering the optional factory.
+        const auto key = ggml_webgpu_shader_lib::make_mul_mat_vec_key(ordinary, false, false);
+        if (key.use_mmvq || key.num_cols != 1 || key.requested_subgroup_size || key.workgroup_size != workgroup ||
+            (key.subgroup_size != 16 && key.subgroup_size != 32) ||
+            (result.subgroup && result.subgroup != key.subgroup_size)) {
+            return std::nullopt;
+        }
+        result.subgroup = key.subgroup_size;
+    }
+    static_assert(WEBGPU_MUL_MAT_VEC_K_Q_OUTPUTS_PER_WG == rows_per_subgroup);
+    const uint32_t output_tile = workgroup / result.subgroup * rows_per_subgroup;
+    result.workgroups = (output_width + output_tile - 1) / output_tile;
+    if (result.workgroups > limits.maxComputeWorkgroupsPerDimension ||
+        views.contains(matched->gate) || views.contains(matched->up)) {
+        return std::nullopt;
+    }
+
+    ctx->shader_lib->require_healthy_device();
+    const ggml_tensor * tensors[] = {matched->gate->src[0], matched->gate->src[1],
+        matched->up->src[0], matched->output};
+    std::array<buffer_facts, 4> facts{};
+    for (size_t i = 0; i < result.bindings.size(); ++i) {
+        const auto * root = tensors[i]->view_src;
+        if (root && (root == matched->gate || root == matched->up || root == matched->output)) {
+            return std::nullopt;
+        }
+        if (!get_binding(ctx, tensors[i], facts, result.bindings[i])) {
+            return std::nullopt;
+        }
+        for (size_t j = 0; j < i; ++j) {
+            if (bindings_overlap(result.bindings[i], result.bindings[j])) {
+                return std::nullopt;
+            }
+        }
+    }
+    return result;
+}
+
+static std::optional<webgpu_encoded_op> encode(webgpu_context & ctx, ggml_cgraph & graph, int index,
+                                               webgpu_fusion_view_sources & views, int & consumed) {
+    auto dispatch = plan(ctx, graph, index, views);
+    if (!dispatch) {
+        return std::nullopt;
+    }
+    bool created = false;
+    const uint32_t subgroup = dispatch->subgroup;
+    auto pipeline = ctx->shader_lib->get_dense_q4_swiglu_pipeline(subgroup, created);
+    if (created) {
+        // A cold optional attempt can yield even when it returns no pipeline.
+        // Refresh the shared view index before this or a later fusion uses it.
+        views.invalidate();
+    }
+    if (!pipeline.pipeline) {
+        return std::nullopt;
+    }
+    if (created) {
+        dispatch = plan(ctx, graph, index, views);
+        if (!dispatch || dispatch->subgroup != subgroup) {
+            return std::nullopt;
+        }
+    }
+
+    const auto & bindings = dispatch->bindings;
+    constexpr uint32_t weight_stride = input_width / 256;
+    const std::vector<uint32_t> params = {
+        bindings[0].element_offset, bindings[1].element_offset, bindings[3].element_offset, output_width, 1, input_width,
+        weight_stride, input_width, weight_stride * output_width, input_width, weight_stride * output_width, input_width,
+        1, 1, 1, 1, bindings[2].element_offset, 0, 0, 0,
+    };
+    const std::vector<wgpu::BindGroupEntry> entries = {
+        ggml_webgpu_make_bind_group_entry(0, bindings[0].buffer, bindings[0].offset, bindings[0].size),
+        ggml_webgpu_make_bind_group_entry(1, bindings[1].buffer, bindings[1].offset, bindings[1].size),
+        ggml_webgpu_make_bind_group_entry(2, bindings[2].buffer, bindings[2].offset, bindings[2].size),
+        ggml_webgpu_make_bind_group_entry(3, bindings[3].buffer, bindings[3].offset, bindings[3].size),
+    };
+    auto encoded = ggml_backend_webgpu_build(ctx, pipeline, params, entries, dispatch->workgroups);
+    GGML_ASSERT(encoded.num_kernels == 1);
+    consumed = operations;
+    return encoded;
+}
+
+}  // namespace webgpu_dense_q4_swiglu
