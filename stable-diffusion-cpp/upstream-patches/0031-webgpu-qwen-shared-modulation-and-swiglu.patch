+#ifdef SD_BROWSER_WEBGPU
+            if (sd_backend_is(ctx->backend, "WebGPU") && gate->type == GGML_TYPE_F32 &&
+                ggml_is_contiguous_1(gate) &&
+                (up != nullptr ? (up->type == gate->type && ggml_are_same_shape(gate, up) &&
+                                  ggml_is_contiguous_1(up)) : (gate->ne[0] % 2 == 0))) {
+                auto result = up != nullptr ? ggml_swiglu_split(ctx->ggml_ctx, gate, up) :
+                                             ggml_swiglu(ctx->ggml_ctx, gate);
+                if (ggml_backend_supports_op(ctx->backend, result)) {
+                    return result;
+                }
+            }
+#endif
+            return nullptr;
+        }
