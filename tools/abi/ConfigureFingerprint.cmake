file(READ "${BICORE_FINGERPRINT_JSON}" BICORE_FINGERPRINT_DATA)
string(JSON BICORE_ABI_FINGERPRINT GET "${BICORE_FINGERPRINT_DATA}" schemaSha256)
string(LENGTH "${BICORE_ABI_FINGERPRINT}" BICORE_FINGERPRINT_LENGTH)
if(NOT BICORE_FINGERPRINT_LENGTH EQUAL 64 OR NOT BICORE_ABI_FINGERPRINT MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "ABI fingerprint must be exactly 64 lower-case hexadecimal digits")
endif()
configure_file("${BICORE_FINGERPRINT_TEMPLATE}" "${BICORE_FINGERPRINT_HEADER}" @ONLY)
