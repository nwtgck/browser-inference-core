+    if (!plan_l2_clip(graph, index, views, plan)) {
+        return std::nullopt;
+    }
+    constexpr uint32_t workgroup = ggml_webgpu_l2_clip_workgroup_size;
+    const auto & limits = ctx->global_ctx->capabilities.limits;
+    // Matching the stock power-of-two SUM_ROWS tree only requires discarding its leading zero-only levels.
+    const auto sum_workgroup = limits.maxComputeInvocationsPerWorkgroup;
+    if (sum_workgroup < workgroup || (sum_workgroup & (sum_workgroup - 1)) ||
+        limits.maxComputeWorkgroupSizeX < workgroup || limits.maxComputeWorkgroupStorageSize < workgroup * sizeof(float) ||
+        limits.maxComputeWorkgroupsPerDimension < plan.rows || limits.maxUniformBuffersPerShaderStage < 1 ||
+        limits.maxUniformBufferBindingSize < WEBGPU_PARAMS_BUF_SIZE_BYTES) {
+        return std::nullopt;
+    }
