 #ifdef SD_BROWSER_WEBGPU
+// Keep the multiplication AFTER the F32 score accumulation. Moving it to Q
+// would change rounding (and mixed-precision matmul input conversion). The
+// existing WebGPU softmax scale consumes the score directly instead of writing
+// a separately scaled score buffer. Masked paths retain their exact broadcast
+// addition; the fused candidate is admitted only for the unmasked case.
+static ggml_tensor* browser_attention_soft_max(ggml_context* ctx, ggml_backend_t backend,
+                                                ggml_tensor* scores, ggml_tensor* mask,
+                                                ggml_tensor* sinks, float scale) {
+    if (!sd_backend_is(backend, "WebGPU") || scores->type != GGML_TYPE_F32 || mask != nullptr) {
+        return nullptr;
+    }
+    auto result = sinks != nullptr ? ggml_soft_max_ext(ctx, scores, nullptr, scale, 0.f) :
+                                    ggml_soft_max_ext_inplace(ctx, scores, nullptr, scale, 0.f);
+    if (sinks != nullptr) {
+        ggml_soft_max_add_sinks(result, sinks);
+    }
+    return ggml_backend_supports_op(backend, result) ? result : nullptr;
+}
