+++ b/ggml/src/ggml-webgpu/ggml-webgpu-scale-unary.hpp
@@ -0,0 +1,62 @@
+#pragma once
+#include "ggml-impl.h"
+#include <cstdint>
+
+struct scale_unary_plan {
+    ggml_tensor * source = nullptr;
+    ggml_tensor * output = nullptr;
+    ggml_tensor * first_scale = nullptr;
+    ggml_tensor * unary = nullptr;
+    ggml_tensor * final_scale = nullptr;
+    uint32_t elements = 0;
+    int operations = 0;
+};
+
+inline bool scale_unary_dense(const ggml_tensor * tensor) {
+    if (!tensor || tensor->type != GGML_TYPE_F32 || tensor->view_src) { return false; }
+    uint64_t bytes = 4;
+    for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+        if (tensor->ne[i] <= 0 || uint64_t(tensor->ne[i]) > UINT32_MAX || tensor->nb[i] != bytes ||
+            bytes > uint64_t(UINT32_MAX) * 4 / uint64_t(tensor->ne[i])) { return false; }
+        bytes *= uint64_t(tensor->ne[i]);
+    }
+    return true;
+}
+
+inline bool plan_scale_unary(const ggml_cgraph * graph, int index, int operations, scale_unary_plan & plan) {
+    plan = {};
+    if (!graph || index < 0 || index >= graph->n_nodes || (operations != 2 && operations != 3) ||
+        operations > graph->n_nodes - index) { return false; }
+    const ggml_op ops[] = { GGML_OP_SCALE, GGML_OP_UNARY, GGML_OP_SCALE };
+    if (!ggml_can_fuse(graph, index, ops, operations)) { return false; }
+    ggml_tensor * first = graph->nodes[index];
+    ggml_tensor * unary = graph->nodes[index + 1];
+    ggml_tensor * source = first->src[0];
+    if (!scale_unary_dense(source) || !ggml_are_same_shape(source, first) ||
+        (ggml_get_unary_op(unary) != GGML_UNARY_OP_SILU && ggml_get_unary_op(unary) != GGML_UNARY_OP_SIGMOID)) {
+        return false;
+    }
+    for (int i = 0; i < operations; ++i) {
+        ggml_tensor * node = graph->nodes[index + i];
+        if (!scale_unary_dense(node) || node->src[0] != (i ? graph->nodes[index + i - 1] : source)) { return false; }
+        for (int s = 1; s < GGML_MAX_SRC; ++s) { if (node->src[s]) { return false; } }
+    }
+    plan = { source, graph->nodes[index + operations - 1], first, unary,
+             operations == 3 ? graph->nodes[index + 2] : nullptr,
+             uint32_t(ggml_nelements(source)), operations };
+    return true;
+}
+
+inline bool scale_unary_disjoint(uint64_t offset_a, uint64_t size_a, uint64_t offset_b, uint64_t size_b) {
+    return size_a && size_b && (offset_a <= offset_b ? size_a <= offset_b - offset_a : size_b <= offset_a - offset_b);
+}
+
+inline bool scale_unary_grid(uint64_t elements, uint32_t limit, uint32_t & x, uint32_t & y) {
+    x = y = 0;
+    if (!elements || !limit || elements > UINT32_MAX) { return false; }
+    const uint64_t groups = (elements + 127) / 128;
+    const uint64_t gy = (groups + limit - 1) / limit;
+    const uint64_t gx = (groups + gy - 1) / gy;
+    if (gx > limit || gy > limit || gx * gy > UINT32_MAX / 128u) { return false; }
+    x = uint32_t(gx); y = uint32_t(gy); return true;
+}
diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/scale_unary.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/scale_unary.wgsl
new file mode 100644
