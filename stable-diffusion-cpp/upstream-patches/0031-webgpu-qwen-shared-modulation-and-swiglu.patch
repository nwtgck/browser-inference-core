+        // These are graph-local producers, not a persistent/value-based cache.
+        // All layers consume the same timestep modulation; a new graph evaluates
+        // it again, including when the input storage is reused with new values.
+        struct PreparedModulation {
+            std::array<ggml_tensor*, 4> target{};
+            std::array<ggml_tensor*, 4> prefix{};
+        };
+
+        static std::optional<PreparedModulation> prepare_modulation(
+            GGMLRunnerContext* ctx, const std::vector<ggml_tensor*>& params, bool target_only) {
+#ifdef SD_BROWSER_WEBGPU
+            if (sd_backend_is(ctx->backend, "WebGPU") && params.size() == 4) {
+                PreparedModulation result;
+                for (size_t i = 0; i < params.size(); ++i) {
+                    if (params[i]->type != GGML_TYPE_F32 || params[i]->ne[1] != 2) {
+                        return std::nullopt;
+                    }
+                    auto rows = ggml_ext_chunk(ctx->ggml_ctx, params[i], 2, 1);
+                    for (int row = 0; row < (target_only ? 1 : 2); ++row) {
+                        auto value = (i == 1 || i == 3) ? ggml_tanh(ctx->ggml_ctx, rows[row]) :
+                            ggml_scale_bias(ctx->ggml_ctx, rows[row], 1.f, 1.f);
+                        if (!ggml_backend_supports_op(ctx->backend, rows[row]) ||
+                            !ggml_backend_supports_op(ctx->backend, value)) {
+                            return std::nullopt;
+                        }
+                        (row == 0 ? result.target : result.prefix)[i] = value;
+                    }
+                }
+                return result;
+            }
+#endif
+            return std::nullopt;
+        }
+
+        static ggml_tensor* modulate_prepared(ggml_context* ctx, ggml_tensor* x,
+                                             ggml_tensor* target_row, ggml_tensor* prefix_row,
+                                             int64_t prefix_length) {
+            // Multiplication owns a new output; these slices are read-only, not
+            // an in-place alias barrier. Borrow contiguous spans (including the
+            // full target on prefix reuse); keep compaction for strided spans.
+            auto apply = [&](int64_t begin, int64_t end, ggml_tensor* row) {
+                auto part = begin == 0 && end == x->ne[1] ? x :
+                    ggml_ext_slice(ctx, x, 1, begin, end, false);
+                if (!ggml_is_contiguous(part)) {
+                    part = ggml_cont(ctx, part);
+                }
+                return ggml_mul(ctx, part, row);
+            };
+            auto target = apply(prefix_length, x->ne[1], target_row);
+            if (prefix_length == 0) {
+                return target;
+            }
+            GGML_ASSERT(prefix_row != nullptr);
+            auto prefix = apply(0, prefix_length, prefix_row);
+            return ggml_concat(ctx, prefix, target, 1);
+        }
+
+        // Select the existing fused kernel only when its layout/type contract
