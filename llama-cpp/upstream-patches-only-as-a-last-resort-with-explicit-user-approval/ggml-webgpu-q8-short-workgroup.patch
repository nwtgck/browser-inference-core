+// Keep the upstream Q8_0 arithmetic, output tiling and lane-to-block mapping.
+// For K <= 1024, each useful lane visits exactly one block in both sizes;
+// the smaller power-of-two workgroup removes only lanes with no input work.
+inline uint32_t ggml_webgpu_q8_short_workgroup(const ggml_webgpu_shader_lib_context & context,
+                                             bool use_mmvq, bool src_overlap) {
+    constexpr uint32_t fallback = WEBGPU_MUL_MAT_VEC_WG_SIZE;
+    const int64_t k = context.src0->ne[0];
+    const uint32_t sg_min = context.min_subgroup_size;
+    const uint32_t sg_max = context.max_subgroup_size;
+    if (!context.supports_subgroups || use_mmvq || src_overlap ||
+        context.src0->type != GGML_TYPE_Q8_0 || context.src1->type != GGML_TYPE_F32 ||
+        context.dst->ne[1] != 1 || context.dst->ne[0] < 1024 ||
+        k <= 0 || k > 1024 || k % 32 != 0 ||
+        sg_min < 4 || sg_max > 128 || sg_min > sg_max ||
+        (sg_min & (sg_min - 1)) != 0 || (sg_max & (sg_max - 1)) != 0) {
+        return fallback;
+    }
+    // Never launch a partial subgroup, even when an adapter exposes a range.
+    uint32_t workgroup = std::max(32u, sg_max);
+    const uint32_t useful_lanes = static_cast<uint32_t>(k / 8);
+    while (workgroup < useful_lanes) {
+        workgroup *= 2;
+    }
+    return workgroup <= context.max_wg_size ? workgroup : fallback;
+}
