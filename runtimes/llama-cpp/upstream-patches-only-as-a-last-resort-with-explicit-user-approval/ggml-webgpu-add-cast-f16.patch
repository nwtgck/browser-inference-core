+enable f16;
+
+// One invocation owns a complete 32-bit output word: no two invocations
+// write adjacent f16 values through separate read/modify/write operations.
+struct Params {
+    ne: u32,
+    offset_src0: u32,
+    offset_src1: u32,
+    offset_dst: u32,
+    stride_src0_0: u32,
+    stride_src0_1: u32,
+    stride_src0_2: u32,
+    stride_src0_3: u32,
+    stride_src1_0: u32,
+    stride_src1_1: u32,
+    stride_src1_2: u32,
+    stride_src1_3: u32,
+    a_ne0: u32,
+    a_ne1: u32,
+    a_ne2: u32,
+    b_ne0: u32,
+    b_ne1: u32,
+    b_ne2: u32,
+    b_ne3: u32,
+};
+
+// Keep pooled-buffer usage compatible; admission requires disjoint bindings.
+@group(0) @binding(0) var<storage, read_write> src0: array<f32>;
+#ifdef MASK_F16
+@group(0) @binding(1) var<storage, read_write> src1: array<f16>;
+#else
+@group(0) @binding(1) var<storage, read_write> src1: array<f32>;
+#endif
+@group(0) @binding(2) var<storage, read_write> dst: array<vec2<f16>>;
+@group(0) @binding(3) var<uniform> params: Params;
+
+fn mask_value(index: u32) -> f32 {
+#ifdef MASK_F16
+    return f32(src1[index]);
+#else
+    return src1[index];
+#endif
+}
+
+fn added_value(index: u32) -> f32 {
+    var i = index;
+    let i3 = i / (params.a_ne2 * params.a_ne1 * params.a_ne0);
+    i %= params.a_ne2 * params.a_ne1 * params.a_ne0;
+    let i2 = i / (params.a_ne1 * params.a_ne0);
+    i %= params.a_ne1 * params.a_ne0;
+    let i1 = i / params.a_ne0;
+    let i0 = i % params.a_ne0;
+    let a = params.offset_src0 + i0 * params.stride_src0_0 + i1 * params.stride_src0_1 +
+            i2 * params.stride_src0_2 + i3 * params.stride_src0_3;
+    let b = params.offset_src1 + (i0 % params.b_ne0) * params.stride_src1_0 +
+            (i1 % params.b_ne1) * params.stride_src1_1 +
+            (i2 % params.b_ne2) * params.stride_src1_2 +
+            (i3 % params.b_ne3) * params.stride_src1_3;
+    return src0[a] + mask_value(b);
+}
+
+@compute @workgroup_size(256)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let pair = gid.x + num_wg.x * 256u * gid.y;
+    if (pair >= params.ne / 2u) {
+        return;
+    }
+    let first = pair * 2u;
+    dst[params.offset_dst + pair] = vec2<f16>(f16(added_value(first)), f16(added_value(first + 1u)));
+}
