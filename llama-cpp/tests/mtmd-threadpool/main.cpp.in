// The helper body is extracted verbatim from the final prepared mtmd source.
// Registry, metadata, constructor and free are controlled counters, not workers.
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <memory>
#include <stdexcept>

#if defined(LCB_SIMULATE_EMSCRIPTEN_PTHREADS)
#define __EMSCRIPTEN__ 1
#define __EMSCRIPTEN_PTHREADS__ 1
#endif

static_assert(sizeof(void *) == LCB_EXPECT_POINTER_BYTES);

struct ggml_threadpool { int serial; };
using ggml_threadpool_t = ggml_threadpool *;
using ggml_backend_dev_t = void *;
using ggml_backend_reg_t = void *;
enum { GGML_BACKEND_DEVICE_TYPE_CPU = 0 };
struct ggml_threadpool_params { int n_threads; int poll; };

static struct {
    bool device = true, registry = true, new_proc = true, free_proc = true, fail_constructor = false;
    int device_queries = 0, registry_queries = 0, proc_queries = 0, constructors = 0, frees = 0;
    int live = 0, last_threads = -1, last_poll = -1;
} control;

static void require(bool ok, const char * message) {
    if (!ok) { std::fprintf(stderr, "fixture assertion: %s\n", message); std::exit(2); }
}
static ggml_backend_dev_t ggml_backend_dev_by_type(int kind) {
    require(kind == GGML_BACKEND_DEVICE_TYPE_CPU, "CPU registry kind");
    ++control.device_queries;
    return control.device ? reinterpret_cast<void *>(1) : nullptr;
}
static ggml_backend_reg_t ggml_backend_dev_backend_reg(ggml_backend_dev_t device) {
    require(device != nullptr, "non-null device");
    ++control.registry_queries;
    return control.registry ? reinterpret_cast<void *>(2) : nullptr;
}
static ggml_threadpool_params ggml_threadpool_params_default(int n_threads) {
    return {n_threads, 50};
}
static ggml_threadpool_t ggml_threadpool_new(const ggml_threadpool_params * params) {
    ++control.constructors;
    control.last_threads = params->n_threads;
    control.last_poll = params->poll;
    if (control.fail_constructor) return nullptr;
    ++control.live;
    return new ggml_threadpool{control.constructors};
}
static void ggml_threadpool_free(ggml_threadpool_t pool) {
    require(pool != nullptr && control.live > 0, "live controlled pool");
    ++control.frees;
    --control.live;
    delete pool;
}
static void * ggml_backend_reg_get_proc_address(ggml_backend_reg_t registry, const char * name) {
    require(registry != nullptr, "non-null registry");
    ++control.proc_queries;
    if (std::strcmp(name, "ggml_threadpool_new") == 0)
        return control.new_proc ? reinterpret_cast<void *>(&ggml_threadpool_new) : nullptr;
    require(std::strcmp(name, "ggml_threadpool_free") == 0, "known pool proc");
    return control.free_proc ? reinterpret_cast<void *>(&ggml_threadpool_free) : nullptr;
}

@ACTUAL_HELPER@

static constexpr bool single_thread =
#if defined(__EMSCRIPTEN__) && !defined(__EMSCRIPTEN_PTHREADS__)
    true;
#else
    false;
#endif
static constexpr bool actual_wasm =
#if defined(__wasm__)
    true;
#else
    false;
#endif

static void row(const char * name, int n_threads, int missing, bool constructor_failure, bool comma) {
    require(control.live == 0, "prior case released");
    control = {};
    if (missing == 1) control.device = false;
    if (missing == 2) control.registry = false;
    if (missing == 3) control.new_proc = false;
    if (missing == 4) control.free_proc = false;
    control.fail_constructor = constructor_failure;
    const bool reaches_constructor = !single_thread && n_threads >= 2 && missing == 0;
    bool caught = false, returned = false;
    try {
        auto pool = mtmd_threadpool_init(n_threads);
        returned = bool(pool);
        require(returned == (reaches_constructor && !constructor_failure), "pool result");
        if (pool) {
            auto copy = pool;
            require(copy.use_count() == 2, "two shared owners");
            pool.reset();
            require(control.frees == 0 && control.live == 1, "copy retains pool");
            copy.reset();
            require(control.frees == 1 && control.live == 0, "last owner frees once");
        }
    } catch (const std::runtime_error & error) {
        caught = true;
        require(std::strcmp(error.what(), "failed to create threadpool") == 0, "constructor failure message");
    }
    require(caught == (reaches_constructor && constructor_failure), "exception boundary");
    require(control.constructors == int(reaches_constructor), "constructor count");
    require(control.live == 0, "no live controlled pool");
    require(control.frees == int(reaches_constructor && !constructor_failure), "free count");
    if (reaches_constructor) {
        require(control.last_threads == n_threads, "native or pthread count preserved");
        require(control.last_poll == 0, "idle poll preserved");
    }
    if (single_thread) require(control.proc_queries == 0, "non-pthread does not resolve pool procedures");
    std::printf("%s{\"name\":\"%s\",\"requestedThreads\":%d,\"returnedPool\":%s,\"caughtConstructorFailure\":%s,"
                "\"deviceQueries\":%d,\"registryQueries\":%d,\"procQueries\":%d,\"constructors\":%d,\"frees\":%d,"
                "\"lastThreads\":%d,\"lastPoll\":%d,\"live\":%d}",
                comma ? "," : "", name, n_threads, returned ? "true" : "false", caught ? "true" : "false",
                control.device_queries, control.registry_queries, control.proc_queries, control.constructors,
                control.frees, control.last_threads, control.last_poll, control.live);
}

int main() {
    std::printf("{\"scope\":\"actual prepared helper body with controlled registry and constructors\","
                "\"actualWasm\":%s,\"pointerBytes\":%zu,\"nonPthreadGuard\":%s,\"cases\":[",
                actual_wasm ? "true" : "false", sizeof(void *), single_thread ? "true" : "false");
    row("one", 1, 0, false, false);
    row("public-default-four", 4, 0, false, true);
    row("explicit-seven-shared-lifetime", 7, 0, false, true);
    row("no-device", 4, 1, false, true);
    row("no-registry", 4, 2, false, true);
    row("no-constructor-proc", 4, 3, false, true);
    row("no-free-proc", 4, 4, false, true);
    row("constructor-failure", 4, 0, true, true);
    std::printf("]}\n");
    return 0;
}
