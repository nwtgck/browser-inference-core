@@ -0,0 +1,51 @@
+struct Params {
+    history_offset: u32,
+    taps_offset: u32,
+    convolution_offset: u32,
+    residual_offset: u32,
+    output_offset: u32,
+    channels: u32,
+    channels_per_head: u32,
+    scale: f32,
+    bias: f32,
+};
+
+// All bindings use the same storage usage even when disjoint ranges share an allocation.
+@group(0) @binding(0) var<storage, read_write> history: array<f32>;
+@group(0) @binding(1) var<storage, read_write> taps: array<f32>;
+@group(0) @binding(2) var<storage, read_write> convolution: array<f32>;
+@group(0) @binding(3) var<storage, read_write> residual: array<f32>;
+#if INPLACE == 0
+@group(0) @binding(4) var<storage, read_write> output: array<f32>;
+@group(0) @binding(5) var<uniform> params: Params;
+#else
+@group(0) @binding(4) var<uniform> params: Params;
+#endif
+
+@compute @workgroup_size(128)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
+    let channel = gid.x;
+    if (channel >= params.channels) { return; }
+    let h = params.history_offset + 4u * channel;
+    let t = params.taps_offset + 4u * (channel / params.channels_per_head);
+    // Preserve reverse history order, four separate products, and the original
+    // sequential accumulation into the already computed SSM result.
+    var value = convolution[params.convolution_offset + channel];
+    let term0 = history[h + 3u] * taps[t];
+    value = value + term0;
+    let term1 = history[h + 2u] * taps[t + 1u];
+    value = value + term1;
+    let term2 = history[h + 1u] * taps[t + 2u];
+    value = value + term2;
+    let term3 = history[h] * taps[t + 3u];
+    value = value + term3;
+    let combined = residual[params.residual_offset + channel] + value;
+    let result = combined * params.scale + params.bias;
+#if INPLACE == 1
+    convolution[params.output_offset + channel] = result;
+#elif INPLACE == 2
+    residual[params.output_offset + channel] = result;
+#else
+    output[params.output_offset + channel] = result;
+#endif
+}
