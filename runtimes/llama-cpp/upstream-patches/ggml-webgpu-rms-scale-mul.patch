+#pragma once
+
+// Extend the existing RMS/SCALE dispatch with a single broadcast weight row.
+// Keep its scalar/vec4 reduction selection and affine operation order.
+namespace webgpu_rms_scale_mul {
+
+struct dispatch_plan {
+    row_norm_scale_plan prefix;
+    ggml_tensor * output;
+    // The SCALE allocation is checked to preserve the existing prefix choice;
+    // only source, weight and final output are bound by the new shader.
+    std::array<webgpu_checked_tensor_binding::binding, 4> bindings;
+    bool inplace;
+    bool vec4;
+    uint32_t x, y;
+};
+
+static std::optional<dispatch_plan> plan(webgpu_context & ctx, const ggml_cgraph & graph, int index,
+                                        webgpu_fusion_view_sources & views) {
+    if (index < 0 || index >= graph.n_nodes || graph.n_nodes - index < 3 ||
+        !ggml_can_fuse(&graph, index, {GGML_OP_RMS_NORM, GGML_OP_SCALE, GGML_OP_MUL})) {
+        return std::nullopt;
+    }
+    dispatch_plan result{};
+    if (!plan_row_norm_scale(&graph, index, views, result.prefix)) { return std::nullopt; }
+    const auto & prefix = result.prefix;
+    auto * output = graph.nodes[index + 2];
+    auto * weight = output->src[1];
+    if (output->src[0] != prefix.output || !weight || output->view_src || output->view_offs ||
+        !ggml_are_same_shape(output, prefix.output) || views.contains(prefix.output) ||
+        weight->ne[0] != output->ne[0] || weight->ne[1] != 1 || weight->ne[2] != 1 || weight->ne[3] != 1 ||
+        std::any_of(std::begin(output->src) + 2, std::end(output->src),
+            [](const ggml_tensor * source) { return source != nullptr; })) {
+        return std::nullopt;
+    }
+    const auto & limits = ctx->global_ctx->capabilities.limits;
+    if (limits.maxComputeInvocationsPerWorkgroup < 128 || limits.maxComputeWorkgroupSizeX < 128 ||
+        limits.maxComputeWorkgroupStorageSize < 128 * 2 * sizeof(float) || !limits.maxUniformBuffersPerShaderStage ||
+        ctx->param_arena.slot_size < 16 * sizeof(uint32_t) ||
+        limits.maxUniformBufferBindingSize < ctx->param_arena.slot_size ||
+        !rms_scale_grid(prefix.rows, limits.maxComputeWorkgroupsPerDimension, result.x, result.y)) {
+        return std::nullopt;
+    }
+
+    ctx->shader_lib->require_healthy_device();
+    const ggml_tensor * tensors[] = {prefix.source, weight, output, prefix.output};
+    std::array<webgpu_checked_tensor_binding::buffer_facts, 4> facts{};
+    for (unsigned i = 0; i < result.bindings.size(); ++i) {
+        const auto * root = tensors[i]->view_src;
+        if (tensors[i]->type != GGML_TYPE_F32 ||
+            (root && (root == prefix.norm || root == prefix.output || root == output)) ||
+            !webgpu_checked_tensor_binding::get_binding(ctx, tensors[i], facts, result.bindings[i])) {
+            return std::nullopt;
+        }
+    }
+    const auto same_range = [&](unsigned a, unsigned b) {
+        const auto & first = result.bindings[a];
+        const auto & second = result.bindings[b];
+        return first.buffer.Get() == second.buffer.Get() && first.offset == second.offset &&
+               first.element_offset == second.element_offset && first.size == second.size &&
+               rms_scale_same_mapping(tensors[a], tensors[b]);
+    };
+    const auto overlap = [&](unsigned a, unsigned b) {
+        return webgpu_checked_tensor_binding::bindings_overlap(result.bindings[a], result.bindings[b]);
+    };
+    result.inplace = same_range(0, 2);
+    // Keep the existing RMS/SCALE allocation valid, including aligned binding
+    // prefixes. The old prefix must not overwrite a later weight read.
+    if ((!same_range(0, 3) && overlap(0, 3)) || (!result.inplace && overlap(0, 2)) ||
+        overlap(1, 0) || overlap(1, 2) || overlap(1, 3)) {
+        return std::nullopt;
+    }
+    const uint32_t storage_count = result.inplace ? 2 : 3;
+    if (limits.maxStorageBuffersPerShaderStage < storage_count || limits.maxBindingsPerBindGroup < storage_count + 1) {
+        return std::nullopt;
+    }
+
+    result.vec4 = ggml_webgpu_can_use_rms_vec4(limits, prefix.source, prefix.output,
+        result.bindings[0].element_offset, result.bindings[3].element_offset);
+    if (result.vec4 && (result.bindings[1].element_offset % 4 != 0 ||
+        !ggml_webgpu_can_use_rms_vec4(limits, prefix.source, output,
+            result.bindings[0].element_offset, result.bindings[2].element_offset))) {
+        return std::nullopt;
+    }
+    result.output = output;
+    return result;
+}
+
+static std::optional<webgpu_encoded_op> encode(webgpu_context & ctx, ggml_cgraph & graph, int index,
+                                               webgpu_fusion_view_sources & views, int & consumed) {
+    auto dispatch = plan(ctx, graph, index, views);
+    if (!dispatch) { return std::nullopt; }
+    const bool inplace = dispatch->inplace, vec4 = dispatch->vec4;
+    bool created = false;
+    const auto pipeline = ctx->shader_lib->get_rms_scale_mul_pipeline(inplace, vec4, created);
+    if (created) {
+        // A cold scoped attempt can yield even when compilation is rejected.
+        views.invalidate();
+    }
+    if (!pipeline.pipeline) { return std::nullopt; }
+    if (created) {
+        dispatch = plan(ctx, graph, index, views);
+        if (!dispatch || dispatch->inplace != inplace || dispatch->vec4 != vec4) { return std::nullopt; }
+    }
+
+    const auto & prefix = dispatch->prefix;
+    const auto * source = prefix.source;
+    const auto * output = dispatch->output;
+    const auto & bindings = dispatch->bindings;
+    const std::vector<uint32_t> params = {
+        bindings[0].element_offset, bindings[2].element_offset,
+        uint32_t(source->nb[1] / 4), uint32_t(source->nb[2] / 4), uint32_t(source->nb[3] / 4),
+        uint32_t(output->nb[1] / 4), uint32_t(output->nb[2] / 4), uint32_t(output->nb[3] / 4),
+        uint32_t(source->ne[0]), uint32_t(source->ne[1]), uint32_t(source->ne[2]), uint32_t(source->ne[3]),
+        ggml_webgpu_u32_from_f32(ggml_get_op_params_f32(prefix.norm, 0)),
+        ggml_webgpu_u32_from_f32(ggml_get_op_params_f32(prefix.output, 0)),
+        ggml_webgpu_u32_from_f32(ggml_get_op_params_f32(prefix.output, 1)), bindings[1].element_offset,
+    };
+    const std::array<unsigned, 3> order = {0, inplace ? 1u : 2u, 1};
+    const unsigned storage_count = inplace ? 2 : 3;
+    std::vector<wgpu::BindGroupEntry> entries;
+    entries.reserve(storage_count);
+    for (unsigned i = 0; i < storage_count; ++i) {
+        const auto & binding = bindings[order[i]];
+        entries.push_back(ggml_webgpu_make_bind_group_entry(i, binding.buffer, binding.offset, binding.size));
+    }
+    auto encoded = ggml_backend_webgpu_build(ctx, pipeline, params, entries, dispatch->x, dispatch->y);
+    consumed = 3;
+    return encoded;
+}
+
+}  // namespace webgpu_rms_scale_mul
