+#pragma once
+#include "ggml-impl.h"
+#include <cstdint>
+
+// Source-bound admission for ordered expert-output ADD chains.
+// Require the complete slot-ordered sum, preserving all intermediate consumers.
+struct moe_sum_plan {
+    ggml_tensor * source = nullptr;
+    ggml_tensor * output = nullptr;
+    uint32_t experts = 0;
+    uint32_t width_vec4 = 0;
+    uint32_t tokens = 0;
+    int operations = 0;
+};
+
+inline bool moe_sum_dense(const ggml_tensor * t) {
+    if (!t || t->type != GGML_TYPE_F32) { return false; }
+    uint64_t bytes = 4;
+    for (int i = 0; i < 4; ++i) {
+        if (t->ne[i] <= 0 || uint64_t(t->ne[i]) > UINT32_MAX || t->nb[i] != bytes ||
+            bytes > uint64_t(UINT32_MAX) * 4 / uint64_t(t->ne[i])) { return false; }
+        bytes *= uint64_t(t->ne[i]);
+    }
+    // Leave room for an aligned binding prefix and tail in 32-bit indexing.
+    return bytes <= uint64_t(UINT32_MAX) * 4 - 4096;
+}
+
+inline bool moe_sum_slice(const ggml_tensor * v, const ggml_tensor * r, uint32_t slot) {
+    return v && v->op == GGML_OP_VIEW && v->type == GGML_TYPE_F32 && v->view_src == r &&
+        v->src[0] == r && v->view_offs == uint64_t(slot) * r->nb[1] &&
+        v->ne[0] == r->ne[0] && v->ne[1] == r->ne[2] && v->ne[2] == 1 && v->ne[3] == 1 &&
+        v->nb[0] == 4 && v->nb[1] == r->nb[2] && v->nb[2] == r->nb[3] && v->nb[3] == r->nb[3];
+}
+
+inline bool plan_moe_sum(const ggml_cgraph * graph, int index, moe_sum_plan & result) {
+    result = {};
+    if (!graph || index < 0 || index >= graph->n_nodes) { return false; }
+    ggml_tensor * first = graph->nodes[index];
+    if (!first || first->op != GGML_OP_ADD || !first->src[0]) { return false; }
+    ggml_tensor * root = first->src[0]->view_src;
+    if (!moe_sum_dense(root) || root->view_src || root->ne[3] != 1 || root->ne[0] % 4 ||
+        root->ne[1] < 3 || root->ne[1] > 32 || !moe_sum_slice(first->src[0], root, 0)) { return false; }
+    const int n = int(root->ne[1]) - 1;
+    if (n > graph->n_nodes - index) { return false; }
+    ggml_op ops[31];
+    for (int i = 0; i < n; ++i) {
+        ggml_tensor * t = graph->nodes[index + i];
+        if (!t || t->op != GGML_OP_ADD || !moe_sum_dense(t) ||
+            t->ne[0] != root->ne[0] || t->ne[1] != root->ne[2] || t->ne[2] != 1 || t->ne[3] != 1 ||
+            (i && t->src[0] != graph->nodes[index + i - 1]) ||
+            !moe_sum_slice(t->src[1], root, uint32_t(i + 1))) { return false; }
+        for (int s = 2; s < GGML_MAX_SRC; ++s) { if (t->src[s]) { return false; } }
+        ops[i] = GGML_OP_ADD;
+    }
+    if (!ggml_can_fuse(graph, index, ops, n)) { return false; }
+    ggml_tensor * last = graph->nodes[index + n - 1];
+    if (last->view_src) { return false; }
+    result = {root, last, uint32_t(root->ne[1]), uint32_t(root->ne[0] / 4), uint32_t(root->ne[2]), n};
+    return true;
+}
+
+// Must be applied to full aligned GPU binding ranges before integration.
+inline bool moe_sum_disjoint(uint64_t a, uint64_t an, uint64_t b, uint64_t bn) {
+    return an && bn && (a <= b ? an <= b - a : bn <= a - b);
+}
+
+// Keep all flattened invocation arithmetic representable even in padding groups.
+inline bool moe_sum_grid(uint64_t elements, uint32_t limit, uint32_t & x, uint32_t & y) {
+    x = y = 0;
+    if (!elements || !limit || elements > UINT32_MAX) { return false; }
+    const uint64_t groups = (elements + 127) / 128;
+    const uint64_t gy = (groups + limit - 1) / limit;
+    const uint64_t gx = (groups + gy - 1) / gy;
+    if (gx > limit || gy > limit || gx * gy > UINT32_MAX / 128u) { return false; }
+    x = uint32_t(gx); y = uint32_t(gy); return true;
+}
