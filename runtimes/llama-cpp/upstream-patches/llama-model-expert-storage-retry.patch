+#pragma once
+
+#include "ggml-backend.h"
+
+// Private registry contract between the file loader and the WebGPU backend.
+// The caller allocates a context selected by supports() before uploading weights.
+struct ggml_webgpu_expert_storage_v1 {
+    struct allocation {
+        ggml_backend_buffer_t buffer;
+        bool out_of_memory;
+    };
+
+    bool (*supports)(ggml_backend_dev_t, const ggml_tensor *);
+    allocation (*allocate)(ggml_backend_buffer_type_t, ggml_context *);
+};
+
+#define GGML_WEBGPU_EXPERT_STORAGE_V1 "ggml_backend_webgpu_expert_storage_v1"
+using ggml_webgpu_get_expert_storage_v1_t = const ggml_webgpu_expert_storage_v1 * (*)();
