+static std::optional<webgpu_encoded_op> ggml_webgpu_ssm_conv_gate(webgpu_context & ctx,
+                                                                 ggml_cgraph * graph, int index,
+                                                                 webgpu_fusion_view_sources & views,
+                                                                 int & num_encoded_ops) {
+    ssm_conv_gate_plan plan;
+    if (!plan_ssm_conv_gate(graph, index, views, plan)) { return std::nullopt; }
+    const auto & limits = ctx->global_ctx->capabilities.limits;
+    const uint64_t tokens_per_wg = plan.output->ne[1] == 1 ? 1 : 8;
+    const uint64_t token_tiles = (uint64_t(plan.output->ne[1]) + tokens_per_wg - 1) / tokens_per_wg;
+    const uint64_t x = (uint64_t(plan.output->ne[0]) + 31) / 32;
+    const uint64_t y = token_tiles * uint64_t(plan.output->ne[2]);
+    if (limits.maxComputeInvocationsPerWorkgroup < 32 * tokens_per_wg ||
+        limits.maxComputeWorkgroupSizeX < 32 || limits.maxComputeWorkgroupSizeY < tokens_per_wg ||
+        limits.maxStorageBuffersPerShaderStage < 4 || limits.maxBindingsPerBindGroup < 5 ||
+        limits.maxUniformBuffersPerShaderStage < 1 || limits.maxUniformBufferBindingSize < WEBGPU_PARAMS_BUF_SIZE_BYTES ||
+        x > limits.maxComputeWorkgroupsPerDimension || y > limits.maxComputeWorkgroupsPerDimension ||
+        y * tokens_per_wg > UINT32_MAX) { return std::nullopt; }
+    webgpu_ssm_conv_silu_binding bindings[4];
+    if (!ggml_webgpu_ssm_conv_silu_binding(ctx, plan.history, plan.history_bytes, bindings[0]) ||
+        !ggml_webgpu_ssm_conv_silu_binding(ctx, plan.weights, plan.weights_bytes, bindings[1]) ||
+        !ggml_webgpu_ssm_conv_silu_binding(ctx, plan.output, plan.output_bytes, bindings[2]) ||
+        !ggml_webgpu_ssm_conv_silu_binding(ctx, plan.gate, plan.gate_bytes, bindings[3])) { return std::nullopt; }
+    // Each storage binding is read_write. Reject aligned-range overlap even
+    // between inputs; the discarded convolution allocation may be reused.
+    for (int a = 0; a < 4; ++a) {
+        for (int b = a + 1; b < 4; ++b) {
+            if (bindings[a].buffer.Get() == bindings[b].buffer.Get() &&
+                !ssm_conv_silu_disjoint(bindings[a].offset, bindings[a].size,
+                                        bindings[b].offset, bindings[b].size)) { return std::nullopt; }
+        }
+    }
+    ggml_webgpu_shader_lib_context shader = {};
+    shader.src0 = plan.history;
+    shader.src1 = plan.weights;
+    shader.dst = plan.output;
+    shader.max_wg_size = limits.maxComputeInvocationsPerWorkgroup;
+    auto pipeline = ctx->shader_lib->get_ssm_conv_pipeline(shader, webgpu_ssm_conv_epilogue::gate);
+    const auto element_offset = [&](int binding) {
+        return static_cast<uint32_t>((bindings[binding].tensor_offset - bindings[binding].offset) / sizeof(float));
+    };
+    const uint32_t params[] = {
+        element_offset(0), element_offset(1), element_offset(2),
+        uint32_t(plan.history->nb[1] / 4), uint32_t(plan.history->nb[2] / 4), uint32_t(plan.weights->nb[1] / 4),
+        uint32_t(plan.output->nb[0] / 4), uint32_t(plan.output->nb[1] / 4), uint32_t(plan.output->nb[2] / 4),
+        uint32_t(plan.weights->ne[0]), uint32_t(plan.output->ne[0]), uint32_t(plan.output->ne[1]),
+        uint32_t(plan.output->ne[2]), uint32_t(token_tiles),
+        element_offset(3), uint32_t(plan.gate->nb[1] / 4), uint32_t(plan.gate->nb[2] / 4),
+    };
+    std::array<wgpu::BindGroupEntry, 4> entries;
+    for (uint32_t binding = 0; binding < 4; ++binding) {
+        entries[binding] = ggml_webgpu_make_bind_group_entry(binding, bindings[binding].buffer,
+                                                            bindings[binding].offset, bindings[binding].size);
+    }
+    auto encoded = ggml_backend_webgpu_build(ctx, pipeline, params, entries, uint32_t(x), uint32_t(y));
+    num_encoded_ops = 2;
+    return encoded;
+}
